# Runtime secrets only. Fill locally; never commit real values.
EMDASH_SITE_URL=http://localhost:4321
EMDASH_ENCRYPTION_KEY=
# Bootstrap gate, required on public setup URLs until the first admin exists.
FLEXWEB_SETUP_TOKEN=
# Independent machine credentials for read / write of immutable release snapshots.
EMDASH_READ_TOKEN=
EMDASH_WRITE_TOKEN=

# Optional until the verified Brevo sender and key are configured; required for recovery.
BREVO_API_KEY=
FLEXWEB_MAIL_FROM=contact@flex-web.fr
