---
import { sameSecret } from '../lib/contracts.mjs';
let error = '';
if (Astro.request.method === 'POST') {
  if (Astro.request.headers.get('origin') !== Astro.url.origin) return new Response('Origine refusée', { status: 403 });
  const form = await Astro.request.formData();
  if (sameSecret(String(form.get('token') || ''), process.env.FLEXWEB_SETUP_TOKEN)) {
    Astro.cookies.set('flexweb-bootstrap', String(form.get('token')), { httpOnly: true, secure: Astro.url.protocol === 'https:', sameSite: 'strict', path: '/', maxAge: 1800 });
    return Astro.redirect('/_emdash/admin/');
  }
  error = 'Le code de mise en service est incorrect ou indisponible.';
}
---
<html lang="fr"><head><meta name="robots" content="noindex,nofollow"/><title>Mise en service Flex-Web</title></head><body><main><h1>Mise en service du CMS</h1><p>Accès initial réservé au propriétaire. Ce code ne remplace pas la passkey de votre compte.</p><form method="post"><label>Code de mise en service<input type="password" name="token" required autocomplete="off" minlength="32"/></label><button>Continuer</button></form>{error && <p role="alert">{error}</p>}</main></body></html>
<style>body{font-family:system-ui;background:#f5f7fb;color:#142033}main{max-width:560px;margin:12vh auto;padding:32px;background:white;border-radius:20px}label,input,button{display:block;width:100%;box-sizing:border-box}input,button{margin-top:12px;padding:14px;border:1px solid #cbd5e1;border-radius:10px}button{background:#087cff;color:white;font-weight:600}</style>
