{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flexweb-content-cms-local",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flexweb-content-cms-local"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "flexweb-content-cms-media-local"
    }
  ],
  "env": {
    "preview": {
      "name": "flexweb-content-cms-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "flexweb-content-cms-preview",
          "database_id": "50aeddc5-6817-4bc0-8bac-caf5e3bccd1f"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "flexweb-content-cms-media-preview"
        }
      ],
      "vars": {
        "FLEXWEB_ENVIRONMENT": "preview"
      },
      "kv_namespaces": [
        {
          "binding": "SESSION",
          "id": "c0e47e526a53476ea2ef998e91a2bc64"
        }
      ]
    },
    "production": {
      "name": "flexweb-content-cms",
      "placement": {
        "region": "aws:eu-south-1"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "flexweb-content-cms",
          "database_id": "bd5924f0-010b-4f57-a361-a2d4554a2a45"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "flexweb-content-cms-media"
        }
      ],
      "vars": {
        "FLEXWEB_ENVIRONMENT": "production"
      },
      "kv_namespaces": [
        {
          "binding": "SESSION",
          "id": "c9403cdcacd7428d9a58aba6f645f263"
        }
      ]
    }
  }
}
