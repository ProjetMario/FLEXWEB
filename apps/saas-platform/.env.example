# Plateforme Next.js — renseigner les valeurs dans les réglages sécurisés du déploiement
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
# En local : postgres et DATABASE_URL. Sur Netlify : netlify (NETLIFY_DB_URL gérée par Netlify).
DATABASE_PROVIDER="postgres"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"
# Facultatif, uniquement pour les modules Supabase historiques.
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Parcours vitrine : même secret aléatoire que dans le projet Netlify de la vitrine
MARKETING_URL="https://flex-web.fr"
AUTOMATION_SHARED_SECRET=""
AUTOMATION_PAYMENTS_ENABLED="false"
AUTOMATION_EMAILS_ENABLED="false"

# Paiements Stripe : clés de test avant toute activation réelle
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_BILLING_PORTAL_CONFIGURATION=""

# E-mails transactionnels Brevo : clé API et expéditeur vérifié
BREVO_API_KEY=""
EMAIL_FROM="contact@flex-web.fr"

# Prospection IONOS : ne jamais utiliser Brevo pour des contacts froids.
# Définir le mot de passe uniquement dans les variables sécurisées Netlify.
IONOS_MAIL_PASSWORD=
OUTREACH_JOBS_ENABLED=false
OUTREACH_SEND_ENABLED=false
