generator client {
  provider = "prisma-client-js"
}

// Prospecting is deliberately separate from opted-in Brevo customer messages.
model OutreachCampaign {
  id            String   @id @default(uuid())
  key           String   @unique
  name          String
  enabled       Boolean  @default(false)
  targetLimit   Int      @default(50)
  registryPage  Int      @default(1)
  exhausted     Boolean  @default(false)
  dailyLimit    Int      @default(10)
  lastRunAt     DateTime?
  lastResult    String?
  createdAt     DateTime @default(now())
  leads         OutreachLead[]
}

model OutreachLead {
  id               String   @id @default(uuid())
  campaignId       String
  siren            String
  siret            String
  companyName      String
  city             String
  postalCode       String
  activityCode     String
  registryUrl      String
  sourceFetchedAt  DateTime @default(now())
  contactSourceUrl String?
  website          String?
  email            String?
  phone            String?
  enrichmentState String   @default("PENDING")
  auditState       String   @default("PENDING")
  audit            Json?
  score            Int      @default(0)
  stage            String   @default("NEW")
  approvedAt       DateTime?
  approvedBy       String?
  firstSentAt      DateTime?
  lastSentAt       DateTime?
  stoppedAt        DateTime?
  stopReason       String?
  prospectId       String?
  prospect         Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  appointmentId    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  campaign         OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  messages         OutreachMessage[]
  events           OutreachEvent[]

  @@unique([campaignId, siren])
  @@index([campaignId, enrichmentState, auditState])
  @@index([email])
  @@index([prospectId])
  @@index([phone])
}

model OutreachMessage {
  id           String   @id @default(uuid())
  leadId       String
  step         Int
  subject      String
  text         String   @db.Text
  status       String   @default("DRAFT")
  attemptedAt  DateTime?
  sentAt       DateTime?
  messageId    String   @unique
  lastError    String?
  lead         OutreachLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@unique([leadId, step])
  @@index([status, attemptedAt])
}

model OutreachSuppression {
  emailHash String @id
  reason    String
  createdAt DateTime @default(now())
}

model OutreachMailbox {
  id          String @id @default("ionos")
  uidValidity String?
  lastUid     Int @default(0)
  syncedAt    DateTime?
  verifiedAt  DateTime?
  lastError   String?
  needsReview Boolean @default(false)
  lockedUntil DateTime @default(now())
  lockToken   String?
}

model OutreachEvent {
  id          String @id @default(uuid())
  leadId      String?
  externalId  String? @unique
  type        String
  detail      String
  createdAt   DateTime @default(now())
  lead        OutreachLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  @@index([leadId, createdAt])
}

// SMS is a separate channel: a public phone number is not an SMS approval.
model SmsAutomationSettings {
  id String @id @default("onoff")
  enabled Boolean @default(false)
  sender String
  webhookKeyHash String?
  dispatchKeyHash String?
  webhookVerifiedAt DateTime?
  dispatchVerifiedAt DateTime?
  lastWebhookAt DateTime?
  dailyLimit Int @default(5)
  updatedAt DateTime @updatedAt
}

model CrmMessageTemplate {
  id String @id @default(uuid())
  name String
  channel String
  subject String?
  body String @db.Text
  updatedAt DateTime @updatedAt
}

model SmsOutreachContact {
  id String @id @default(uuid())
  prospectId String? @unique
  prospect Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  leadId String? @unique
  companyName String
  city String
  phone String @unique
  sourceUrl String
  websiteCheckUrl String
  websiteFinding String @default("TO_CHECK")
  checkedAt DateTime?
  contactBasis String @default("TO_CHECK")
  evidence String? @db.Text
  reviewedBy String?
  stoppedAt DateTime?
  stopReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages SmsOutreachMessage[]
  events SmsOutreachEvent[]
}

model SmsOutreachMessage {
  id String @id @default(uuid())
  contactId String @unique
  body String @db.Text
  status String @default("DRAFT")
  approvedAt DateTime?
  approvedBy String?
  attemptedAt DateTime?
  sentAt DateTime?
  dispatchRequestHash String? @unique
  providerEventId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contact SmsOutreachContact @relation(fields: [contactId], references: [id], onDelete: Restrict)
  @@index([status, approvedAt])
}

model SmsOutreachEvent {
  id String @id @default(uuid())
  contactId String
  externalId String? @unique
  kind String
  detail String @db.Text
  occurredAt DateTime @default(now())
  createdAt DateTime @default(now())
  contact SmsOutreachContact @relation(fields: [contactId], references: [id], onDelete: Restrict)
  @@index([contactId, createdAt])
}

model SmsSuppression {
  phoneHash String @id
  reason String
  createdAt DateTime @default(now())
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIAL
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships   Membership[]
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  notifications Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  studioSites StudioSite[]
  id           String             @id @default(uuid())
  slug         String             @unique
  name         String
  businessType String
  status       OrganizationStatus @default(TRIAL)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  memberships          Membership[]
  websites             Website[]
  domains              Domain[]
  media                Media[]
  pages                Page[]
  navigationItems      NavigationItem[]
  services             Service[]
  products             Product[]
  projects             Project[]
  teamMembers          TeamMember[]
  testimonials         Testimonial[]
  articles             Article[]
  categories           Category[]
  faqs                 FAQ[]
  events               Event[]
  forms                Form[]
  formSubmissions      FormSubmission[]
  leads                Lead[]
  appointments         Appointment[]
  businessHours        BusinessHours[]
  socialLinks          SocialLink[]
  subscriptions        Subscription[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  organizationFeatures OrganizationFeature[]
  websiteSettings      WebsiteSettings?
  seoSettings          SEOSettings?

  @@index([slug])
  @@index([businessType])
}

model Membership {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           UserRole @default(EDITOR)
  invitedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Website {
  studioSites StudioSite[]
  id            String   @id @default(uuid())
  organizationId String
  templateId     String?
  name           String
  primaryDomain  String?
  faviconUrl     String?
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template        Template?         @relation(fields: [templateId], references: [id])
  pages           Page[]
  navigationItems NavigationItem[]
  websiteSettings WebsiteSettings?
  seoSettings     SEOSettings?

  @@index([organizationId])
}

model WebsiteSettings {
  id              String   @id @default(uuid())
  organizationId  String   @unique
  websiteId       String?  @unique
  brandColor      String?
  secondaryColor  String?
  fontHeading     String?
  fontBody        String?
  logoUrl         String?
  contactEmail    String?
  contactPhone    String?
  address         String?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website      Website?     @relation(fields: [websiteId], references: [id], onDelete: SetNull)
}

model SEOSettings {
  id               String   @id @default(uuid())
  organizationId   String   @unique
  websiteId        String?  @unique
  defaultTitle     String?
  defaultDescription String?
  ogImageUrl       String?
  twitterHandle    String?
  robotsTxt        String?
  sitemapEnabled   Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website      Website?     @relation(fields: [websiteId], references: [id], onDelete: SetNull)
}

model Domain {
  id             String    @id @default(uuid())
  organizationId String
  domain         String    @unique
  isCustom       Boolean   @default(false)
  isPrimary      Boolean   @default(false)
  verifiedAt     DateTime?
  sslConfigured  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Template {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  category         String
  description      String?
  thumbnailUrl     String?
  defaultPages     Json?
  defaultStyles    Json?
  availableModules Json?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  websites Website[]
}

model Page {
  id              String     @id @default(uuid())
  organizationId  String
  websiteId       String
  slug            String
  title           String
  status          PageStatus @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  isHomepage      Boolean    @default(false)
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website      Website     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  sections     PageSection[]

  @@unique([organizationId, websiteId, slug])
  @@index([organizationId, websiteId])
}

model PageSection {
  id        String   @id @default(uuid())
  pageId    String
  type      String
  config    Json
  order     Int
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model NavigationItem {
  id             String  @id @default(uuid())
  organizationId String
  websiteId      String
  label          String
  href           String
  parentId       String?
  order          Int     @default(0)
  isVisible      Boolean @default(true)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  website      Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  parent       NavigationItem? @relation("NavigationChildren", fields: [parentId], references: [id])
  children     NavigationItem[] @relation("NavigationChildren")

  @@index([organizationId, websiteId])
}

model Media {
  id             String   @id @default(uuid())
  organizationId String
  filename       String
  url            String
  mimeType       String
  sizeInBytes    Int
  width          Int?
  height         Int?
  altText        String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Service {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  description    String?
  imageUrl       String?
  price          String?
  isVisible      Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Product {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  imageUrl       String?
  price          String?
  categoryId     String?
  isVisible      Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id])

  @@index([organizationId])
}

model Project {
  id             String    @id @default(uuid())
  organizationId String
  title          String
  description    String?
  imageUrl       String?
  clientName     String?
  completionDate DateTime?
  isVisible      Boolean   @default(true)
  order          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model TeamMember {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  role           String?
  bio            String?
  imageUrl       String?
  email          String?
  order          Int      @default(0)
  isVisible      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Testimonial {
  id             String   @id @default(uuid())
  organizationId String
  authorName     String
  authorRole     String?
  content        String
  imageUrl       String?
  rating         Int?
  isVisible      Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Article {
  id             String     @id @default(uuid())
  organizationId String
  title          String
  slug           String
  excerpt        String?
  content        Json?
  coverImageUrl  String?
  categoryId     String?
  status         PageStatus @default(DRAFT)
  publishedAt    DateTime?
  authorId       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id])

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Category {
  id             String @id @default(uuid())
  organizationId String
  name           String
  slug           String
  type           String
  order          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]
  articles     Article[]
  events       Event[]

  @@unique([organizationId, slug, type])
  @@index([organizationId])
}

model FAQ {
  id             String   @id @default(uuid())
  organizationId String
  question       String
  answer         String
  order          Int      @default(0)
  isVisible      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Event {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  description    String?
  startDate      DateTime
  endDate        DateTime?
  location       String?
  imageUrl       String?
  categoryId     String?
  isVisible      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id])
}

model Form {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  fields         Json
  notifyEmails   String[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submissions  FormSubmission[]
}

model FormSubmission {
  id             String   @id @default(uuid())
  organizationId String
  formId         String
  data           Json
  status         String   @default("new")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  form         Form         @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([organizationId, formId])
}

model Lead {
  id             String   @id @default(uuid())
  organizationId String
  name           String?
  email          String
  phone          String?
  message        String?
  source         String?
  status         String   @default("new")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Appointment {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  email          String
  phone          String?
  date           DateTime
  notes          String?
  status         String    @default("pending")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  prospectId     String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospect     Prospect?    @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  @@index([prospectId])
}

enum ProspectionStatus {
  NOUVEAU
  A_CONTACTER
  SMS_ENVOYE
  SANS_REPONSE
  REPONDU
  INTERESSE
  A_RELANCER
  RDV_PLANIFIE
  RDV_EFFECTUE
  DEVIS_ENVOYE
  NEGOCIATION
  CLIENT_SIGNE
  PAS_INTERESSE
  A_RECONTACTER_PLUS_TARD
  PERDU
}

enum InteractionType {
  PROSPECT_AJOUTE
  SMS_ENVOYE
  REPONSE_RECUE
  APPEL
  EMAIL
  NOTE
  RELANCE
  RDV
  DEVIS
  CLIENT_SIGNE
  STATUT_MODIFIE
}

enum FollowUpStatus {
  PENDING
  DONE
  SKIPPED
}

model SmsCampaign {
  id          String   @id @default(uuid())
  name        String
  description String?
  city        String?
  department  String?
  country     String   @default("France")
  businessType String?
  startDate   DateTime @default(now())
  endDate     DateTime?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prospects Prospect[]

  @@index([status])
  @@index([startDate])
}

model SmsTemplate {
  id        String   @id @default(uuid())
  name      String
  body      String   @db.Text
  variables String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prospect {
  studioSites StudioSite[]
  id                String            @id @default(uuid())
  siren             String?           @unique
  siret             String?
  importKey         String?           @unique
  importBatch       String?
  sourceUrl         String?
  sourceCheckedAt   DateTime?
  registryState     String?
  websiteFinding    String            @default("TO_CHECK")
  websiteEvidence   String?           @db.Text
  websiteCheckedAt  DateTime?
  preferredChannel  String            @default("NONE")
  doNotContactAt    DateTime?
  stopReason        String?
  companyName       String
  contactName       String?
  phone             String
  email             String?
  website           String?
  googleBusinessUrl String?
  businessType      String?
  category          String?
  city              String?
  department        String?
  country           String            @default("France")
  source            String?
  googleReviewCount Int?
  googleRating      Float?
  internalNotes     String?           @db.Text
  status            ProspectionStatus @default(NOUVEAU)

  setupFee     Int?
  monthlyPrice Int?
  oneTimePrice Int?
  estimatedValue Int?
  signedValue  Int?

  campaignId String?
  campaign   SmsCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  nextFollowUpAt    DateTime?
  firstSmsSentAt    DateTime?
  lastInteractionAt DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  interactions ProspectInteraction[]
  followUps    FollowUp[]
  appointments Appointment[]
  notes        ProspectNote[]
  emailLeads   OutreachLead[]
  smsContact   SmsOutreachContact?

  @@index([status])
  @@index([city])
  @@index([businessType])
  @@index([nextFollowUpAt])
  @@index([campaignId])
  @@index([importBatch])
  @@index([department, websiteFinding])
  @@index([email])
  @@index([phone])
  @@unique([phone, companyName])
}

model ProspectInteraction {
  id          String          @id @default(uuid())
  externalKey String?         @unique
  prospectId  String
  prospect    Prospect        @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  type        InteractionType
  note        String?         @db.Text
  oldStatus   ProspectionStatus?
  newStatus   ProspectionStatus?
  createdById String?
  createdAt   DateTime        @default(now())

  @@index([prospectId])
  @@index([type])
  @@index([createdAt])
}

model FollowUp {
  id          String         @id @default(uuid())
  prospectId  String
  prospect    Prospect       @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  dueAt       DateTime
  doneAt      DateTime?
  status      FollowUpStatus @default(PENDING)
  note        String?        @db.Text
  createdById String?
  createdAt   DateTime       @default(now())

  @@index([prospectId])
  @@index([dueAt])
  @@index([status])
}

model ProspectNote {
  id          String   @id @default(uuid())
  prospectId  String
  prospect    Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  content     String   @db.Text
  createdById String?
  createdAt   DateTime @default(now())

  @@index([prospectId])
}

model BusinessHours {
  id             String  @id @default(uuid())
  organizationId String
  dayOfWeek      Int
  openTime       String?
  closeTime      String?
  isClosed       Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dayOfWeek])
}

model SocialLink {
  id             String @id @default(uuid())
  organizationId String
  platform       String
  url            String
  order          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Feature {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  organizationFeatures OrganizationFeature[]
}

model OrganizationFeature {
  id             String  @id @default(uuid())
  organizationId String
  featureKey     String
  isEnabled      Boolean @default(false)
  settings       Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feature      Feature      @relation(fields: [featureKey], references: [key])

  @@unique([organizationId, featureKey])
}

model Subscription {
  id             String             @id @default(uuid())
  organizationId String
  plan           String
  status         SubscriptionStatus @default(TRIAL)
  seats          Int                @default(1)
  startDate      DateTime           @default(now())
  endDate        DateTime?
  paymentProvider String?
  externalId     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  type           String
  title          String
  message        String
  isRead         Boolean  @default(false)
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
}

// Funnel data is internal to FLEX-WEB; client access uses expiring hashed tokens.
model SalesProject {
  id                   String   @id @default(uuid())
  requestKey           String   @unique
  accessTokenHash      String   @unique
  accessExpiresAt      DateTime
  companyName          String
  contactName          String
  email                String
  phone                String
  city                 String
  businessType         String
  message              String   @db.Text
  timeline             String
  source               String
  planId               String
  monthlyCents         Int
  setupCents           Int
  offerSnapshot        Json
  stage                String   @default("NEW")
  paymentStatus        String   @default("UNPAID")
  prospectId           String?
  organizationId       String?  @unique
  websiteId            String?  @unique
  brief                Json?
  draftVersion         Int      @default(0)
  briefSubmittedAt     DateTime?
  clientApprovedAt     DateTime?
  qaApprovedAt         DateTime?
  publishedAt          DateTime?
  termsAcceptedAt      DateTime?
  termsVersion         String?
  quoteReference       String?
  quoteUrl             String?
  stripeCustomerId     String?
  stripeSubscriptionId String?  @unique
  stripeSessionId      String?  @unique
  checkoutAttempt      Int      @default(0)
  stripeUpdatedAt      Int      @default(0)
  paidAt               DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  @@index([stage, createdAt])
  @@index([email])
}

model AutomationMessage {
  id             String   @id @default(uuid())
  dedupeKey      String   @unique
  projectId      String?
  expectedStage  String?
  to             String
  subject        String
  text           String   @db.Text
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  availableAt    DateTime @default(now())
  firstAttemptAt DateTime?
  lockedAt       DateTime?
  sentAt         DateTime?
  providerId     String?
  lastError      String?
  createdAt      DateTime @default(now())
  @@index([status, availableAt])
}

model AutomationEvent {
  id          String   @id @default(uuid())
  externalId  String?  @unique
  projectId   String?
  type        String
  detail      String
  createdAt   DateTime @default(now())
  @@index([projectId, createdAt])
}

model AutomationRateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

model SupportTicket {
  id        String   @id @default(uuid())
  projectId String
  requestKey String  @unique
  subject   String
  message   String   @db.Text
  status    String   @default("OPEN")
  minutes   Int      @default(0)
  response  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([projectId, status])
}

model StudioSite {
  id String @id @default(uuid())
  identityId String @unique
  email String
  organizationId String @unique
  organization Organization @relation(fields: [organizationId], references: [id])
  websiteId String @unique
  website Website @relation(fields: [websiteId], references: [id])
  prospectId String?
  prospect Prospect? @relation(fields: [prospectId], references: [id])
  slug String @unique
  trialEndsAt DateTime
  brief Json
  draft Json
  draftRevision Int @default(1)
  published Json?
  previousPublished Json?
  approvedRevision Int?
  state String @default("TRIAL")
  stripeCustomerId String?
  stripeSessionId String?
  stripeSubscriptionId String? @unique
  paidThrough DateTime?
  pastDueAt DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  billingStatus String @default("UNPAID")
  publishedAt DateTime?
  lastBillingCheck DateTime?
  domain String? @unique
  domainToken String?
  domainState String @default("NONE")
  domainError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs StudioJob[]
  assets StudioAsset[]
  inquiries StudioInquiry[]
  events StudioEvent[]
}
model StudioJob {
  id String @id @default(uuid())
  siteId String
  site StudioSite @relation(fields: [siteId], references: [id])
  requestKey String @unique
  kind String @default("GENERATE")
  state String @default("PENDING")
  input Json
  baseRevision Int
  quotaPeriod String
  budgetPeriod String
  reservedCents Int @default(10)
  inputTokens Int @default(0)
  outputTokens Int @default(0)
  error String?
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  @@index([state, createdAt])
  @@index([siteId, quotaPeriod])
}
model StudioBudget {
  period String @id
  reservedCents Int @default(0)
}
model StudioAsset {
  id String @id @default(uuid())
  siteId String
  site StudioSite @relation(fields: [siteId], references: [id])
  key String @unique
  bytes Int
  state String @default("PENDING")
  createdAt DateTime @default(now())
}
model StudioInquiry {
  id String @id @default(uuid())
  siteId String
  site StudioSite @relation(fields: [siteId], references: [id])
  name String
  email String
  message String @db.Text
  createdAt DateTime @default(now())
}
model StudioEvent {
  id String @id @default(uuid())
  siteId String
  site StudioSite @relation(fields: [siteId], references: [id])
  key String @unique
  kind String
  detail String
  createdAt DateTime @default(now())
}
