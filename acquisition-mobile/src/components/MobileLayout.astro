---
import Analytics from '../../../src/components/seo/Analytics.astro';
import Acquisition from '../../../src/components/seo/Acquisition.astro';
import ConversionEvents from '../../../src/components/seo/ConversionEvents.astro';
import CookieConsent from '../../../src/components/global/CookieConsent.jsx';
interface Props {
  lang: 'fr' | 'en'; title: string; description: string; path: string;
  alternates: Record<string, string>; schema?: Record<string, unknown>[];
  image?: string; imageAlt?: string;
}
const {lang, title, description, path, alternates, schema = [], image = '/logo.png', imageAlt = 'Flex-Web'} = Astro.props;
const site = 'https://flex-web.fr';
const absolute = (path: string) => new URL(path, site).href;
const english = lang === 'en';
const home = english ? '/en/' : '/';
const hub = english ? '/en/applications/' : '/creation-application-mobile/';
const other = english ? 'fr' : 'en';
const langLink = alternates[other] ?? (english ? '/creation-application-mobile/' : '/en/applications/');
const langLabel = english ? 'Français' : 'English';
const nav = [
  [english ? 'Mobile apps' : 'Applications mobiles', hub],
  ['FootNation', english ? '/en/case-studies/footnation/' : '/realisations/footnation/'],
  [english ? 'Pricing' : 'Tarifs', english ? '/en/applications/cost/' : '/applications/prix/'],
  [langLabel, langLink],
];
const quote = english ? 'Request a quote (FR)' : 'Demander un devis';
const canonical = absolute(path);
const graph = [
  {'@type':'Organization','@id':site+'/#organization',name:'Flex-Web',legalName:'FLEX IMMO',url:site+'/',logo:absolute('/logo.png'),email:'contact@flex-web.fr',telephone:'+33757830262',address:{'@type':'PostalAddress',addressLocality:'Voglans',postalCode:'73420',addressCountry:'FR'}},
  {'@type':'WebSite','@id':site+'/#website',url:site+'/',name:'Flex-Web',publisher:{'@id':site+'/#organization'}},
  {'@type':'WebPage','@id':canonical+'#webpage',url:canonical,name:title,description,inLanguage:lang,isPartOf:{'@id':site+'/#website'},publisher:{'@id':site+'/#organization'}},
  ...schema,
];
const json = JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c');
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title}</title><meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/><link rel="icon" href="/favicon-32x32.png" type="image/png"/>
  {Object.entries(alternates).map(([locale,link]) => <link rel="alternate" hreflang={locale} href={absolute(link)}/>)}
  <link rel="alternate" hreflang="x-default" href={absolute(alternates.fr)}/>
  <meta property="og:type" content={schema.some(item=>item['@type']==='Article') ? 'article' : 'website'}/>
  <meta property="og:site_name" content="Flex-Web"/><meta property="og:locale" content={english ? 'en_GB' : 'fr_FR'}/>
  <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
  <meta property="og:image" content={absolute(image)}/><meta property="og:image:alt" content={imageAlt}/>
  <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content={absolute(image)}/><meta name="twitter:image:alt" content={imageAlt}/>
  <script type="application/ld+json" set:html={json}></script>
  <Analytics/>
</head>
<body>
<a class="skip" href="#content">{english ? 'Skip to content' : 'Aller au contenu'}</a>
<header class="site-header"><div class="site-bar">
  <a href={home} class="brand" aria-label={english ? 'Flex-Web home' : 'Accueil Flex-Web'}><img src="/logo.png" alt="" width="44" height="44"/>Flex-Web</a>
  <nav class="desktop" aria-label={english ? 'Main navigation' : 'Navigation principale'}>{nav.map(([name,url])=><a href={url}>{name}</a>)}</nav>
  <a class="quote" href="/demarrer/application/" data-conversion-event="quote_click" data-conversion-service="application">{quote}</a>
  <details class="menu"><summary>Menu</summary><nav aria-label={english ? 'Mobile navigation' : 'Navigation mobile'}>{nav.map(([name,url])=><a href={url}>{name}</a>)}</nav></details>
</div></header>
<main id="content"><slot/></main>
<footer class="site-footer"><div class="foot-inner">
  <div><a href={home} class="brand"><img src="/logo.png" alt="" width="40" height="40"/>Flex-Web</a><p>{english ? 'Flex-Web is a Fleximmo brand based in Voglans, France. Project support in French and English.' : 'Flex-Web, marque de Fleximmo à Voglans en Savoie. Accompagnement en français et en anglais.'}</p></div>
  <div><a href="mailto:contact@flex-web.fr" data-conversion-event="email_click" data-conversion-service="application">contact@flex-web.fr</a><a href="tel:+33757830262" data-conversion-event="phone_click" data-conversion-service="application">+33 7 57 83 02 62</a></div>
  <div><a href="/mentions-legales/">{english ? 'Legal notice (FR)' : 'Mentions légales'}</a><a href="/privacy/">{english ? 'Privacy (FR)' : 'Confidentialité'}</a><button id="cookie-settings" type="button">{english ? 'Cookie settings' : 'Gérer les cookies'}</button></div>
</div></footer>
<div class="consent"><CookieConsent lang={lang} client:load/></div>
<Acquisition/><ConversionEvents/>
<script>document.getElementById('cookie-settings')?.addEventListener('click',()=>window.dispatchEvent(new CustomEvent('flexweb-cookie-settings')));</script>
</body></html>
<style is:global>
*{box-sizing:border-box}html{color-scheme:light;scroll-padding:1rem}body{margin:0;color:#1d1d1f;background:#fff;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;line-height:1.55}a{color:#0068c9}a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid #0071e3;outline-offset:4px}button,summary{font:inherit;cursor:pointer}.skip{position:absolute;left:1rem;top:-10rem;background:#fff;padding:.6rem;z-index:100}.skip:focus{top:.4rem}
.site-header{background:#fafafa;border-bottom:1px solid #e2e4e8}.site-bar,.foot-inner{max-width:1170px;padding:10px 28px;margin:auto;display:flex;align-items:center;gap:24px}.brand{font-size:1.15rem;font-weight:750;text-decoration:none;color:#1d1d1f;display:inline-flex;gap:.6rem;align-items:center;white-space:nowrap}.brand img{object-fit:contain;border-radius:6px}.desktop{margin-left:auto;display:flex;gap:1.4rem}.site-bar nav a,.site-footer a,.site-footer button{color:#273548;text-decoration:none;font-size:.94rem}.site-bar nav a:hover,.site-footer a:hover,.site-footer button:hover{text-decoration:underline}.quote{background:#0071e3;color:white;text-decoration:none;font-size:.93rem;font-weight:650;border-radius:99px;padding:.6rem 1.05rem;white-space:nowrap}.menu{display:none;position:relative}.menu nav{position:absolute;right:0;top:2rem;min-width:12rem;background:white;padding:1rem;box-shadow:0 8px 24px #162c4829;z-index:10}.menu nav a,.site-footer div>div>a:not(.brand){display:block;padding:.25rem 0}
.site-footer{background:#f5f5f7;border-top:1px solid #e0e1e5;margin-top:2rem}.foot-inner{align-items:flex-start;justify-content:space-between;padding-block:36px;flex-wrap:wrap}.foot-inner p{max-width:34ch;color:#535963;margin:.6rem 0 0}.site-footer button{padding:.25rem 0;background:none;border:0}
.consent aside{position:fixed;z-index:50;bottom:1rem;left:1rem;right:1rem;margin:auto;max-width:44rem;background:white;color:#1d1d1f;border:1px solid #ced3d9;border-radius:16px;padding:1.2rem;box-shadow:0 10px 40px #182b4129}.consent aside h2{font-size:1rem;margin:0}.consent aside p{font-size:.9rem;margin:.4rem 0}.consent aside div{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap}.consent button{background:#fff;color:#1d1d1f;border:1px solid #b8bfca;border-radius:30px;padding:.4rem .85rem}.consent button:first-child{background:#1d1d1f;color:white}.consent aside a{font-size:.9rem}
@media(max-width:750px){.desktop{display:none}.menu{display:block}.site-bar{gap:.7rem;padding-inline:1rem}.site-bar .quote{margin-left:auto;font-size:.82rem}.brand{font-size:1rem}.brand img{width:36px;height:36px}.foot-inner{padding:24px 1rem;gap:1.5rem}}
@media(max-width:365px){.site-bar{gap:.5rem;padding-inline:.6rem}.brand{gap:.3rem}.site-bar .quote{padding:.5rem .55rem}}
</style>
