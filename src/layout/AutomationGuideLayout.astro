---
import BaseLayout from "./BaseLayout.astro";
import StructuredData from "../components/seo/StructuredData.astro";

interface Props { title: string; description: string; slug: string; answer: string; readingTime: string }
const { title, description, slug, answer, readingTime } = Astro.props;
const canonicalUrl = `https://flex-web.fr/journal/${slug}/`;
const published = "2026-09-11";
const schemas = [
  { "@type": "WebPage", "@id": canonicalUrl, url: canonicalUrl, name: title, description, inLanguage: "fr-FR", isPartOf: { "@id": "https://flex-web.fr/#website" } },
  { "@type": "Article", "@id": `${canonicalUrl}#article`, mainEntityOfPage: { "@id": canonicalUrl }, url: canonicalUrl, headline: title, description, inLanguage: "fr-FR", datePublished: published, dateModified: published, author: { "@id": "https://flex-web.fr/#organization" }, publisher: { "@id": "https://flex-web.fr/#organization" }, about: { "@type": "Service", name: "Automatisation de tâches IA", url: "https://flex-web.fr/automatisation-ia/" } },
  { "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: "https://flex-web.fr/" },
    { "@type": "ListItem", position: 2, name: "Journal", item: "https://flex-web.fr/journal/" },
    { "@type": "ListItem", position: 3, name: title, item: canonicalUrl },
  ] },
];
const related = [
  { slug: "taches-automatiser-pme", title: "Quelles tâches automatiser dans une PME ?" },
  { slug: "connecter-demandes-crm", title: "Comment relier les demandes de votre site à un CRM ?" },
  { slug: "automatisation-ou-application-sur-mesure", title: "Automatisation ou application sur mesure : que choisir ?" },
].filter((item) => item.slug !== slug);
---

<BaseLayout title={`${title} | FLEX-WEB`} description={description}>
  <StructuredData schemas={schemas} slot="head" />
  <article class="automation-guide">
    <nav class="breadcrumbs" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span aria-hidden="true">/</span><a href="/journal/">Journal</a></nav>
    <header>
      <p class="eyebrow">Guide pratique · Automatisation & outils métier</p>
      <h1>{title}</h1>
      <p class="description">{description}</p>
      <p class="byline">Par FLEX-WEB · <time datetime={published}>11 septembre 2026</time> · {readingTime} de lecture</p>
    </header>
    <aside class="quick-answer" aria-labelledby="quick-answer-title"><h2 id="quick-answer-title">La réponse en quelques mots</h2><p>{answer}</p></aside>
    <div class="guide-content"><slot /></div>
    <aside class="guide-cta"><p class="eyebrow">Passer du besoin au projet</p><h2>Décrivez une tâche que vous voulez simplifier.</h2><p>FLEX-WEB propose des projets d’<a href="/automatisation-ia/">automatisation IA en France</a>, avec un accompagnement dédié en <a href="/automatisation-ia-savoie/">Savoie</a> et <a href="/automatisation-ia-haute-savoie/">Haute-Savoie</a>. Le parcours, les connexions et le suivi sont précisés sur devis.</p><a class="quote-button" href="/demarrer/?service=automation">Demander un devis d’automatisation IA <span aria-hidden="true">↗</span></a></aside>
    <nav class="related" aria-label="Guides complémentaires"><h2>Pour continuer</h2>{related.map((item) => <a href={`/journal/${item.slug}/`}>{item.title} <span aria-hidden="true">↗</span></a>)}</nav>
  </article>
</BaseLayout>

<style>
  .automation-guide { width: min(800px, calc(100% - 44px)); margin-inline: auto; padding-block: 36px 75px; color: var(--color-text); }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: 12px; font-size: 13px; color: #53606d; margin-bottom: 44px; }
  a { text-underline-offset: 4px; }
  .breadcrumbs a:hover { text-decoration: underline; }
  .eyebrow { text-transform: uppercase; letter-spacing: .12em; font-size: 11px; color: #005ebd; font-weight: 650; }
  h1 { font-size: clamp(2.15rem, 5vw, 3.2rem); font-weight: 600; line-height: 1.12; letter-spacing: -.045em; margin-top: 18px; text-wrap: balance; }
  .description { font-size: 18px; line-height: 1.75; color: #53606d; margin-top: 24px; }
  .byline { margin-top: 24px; font-size: 12px; color: #53606d; }
  .quick-answer { border-left: 3px solid #0071e3; background: #f0f6fd; padding: 26px; margin-block: 36px 46px; border-radius: 0 14px 14px 0; }
  .quick-answer h2 { font-size: 18px; font-weight: 600; }
  .quick-answer p { margin-top: 12px; line-height: 1.75; color: #425466; }
  .guide-content :global(h2) { font-size: clamp(1.45rem, 3vw, 1.8rem); font-weight: 600; letter-spacing: -.03em; line-height: 1.25; margin-top: 45px; margin-bottom: 20px; text-wrap: balance; }
  .guide-content :global(h3) { font-size: 19px; font-weight: 600; margin-top: 28px; margin-bottom: 12px; }
  .guide-content :global(p), .guide-content :global(li) { font-size: 16px; line-height: 1.85; color: #425466; }
  .guide-content :global(p + p) { margin-top: 18px; }
  .guide-content :global(ul), .guide-content :global(ol) { padding-left: 25px; margin-block: 20px; }
  .guide-content :global(ul) { list-style: disc; }
  .guide-content :global(ol) { list-style: decimal; }
  .guide-content :global(li + li) { margin-top: 10px; }
  .guide-content :global(strong) { color: #1d2d3d; font-weight: 600; }
  .guide-content :global(a), .guide-cta p a { color: #005ebd; text-decoration: underline; }
  .guide-content :global(.example) { background: #f6f8fb; border: 1px solid #e1e7ee; padding: 24px; border-radius: 14px; margin-block: 26px; }
  .guide-content :global(.example h3) { margin-top: 0; }
  .guide-content :global(.example p) { font-size: 15px; }
  .guide-content :global(.table-scroll) { overflow-x: auto; margin-block: 24px; }
  .guide-content :global(table) { width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; }
  .guide-content :global(caption) { text-align: left; font-size: 13px; padding-bottom: 10px; color: #53606d; }
  .guide-content :global(th), .guide-content :global(td) { padding: 16px 13px; border: 1px solid #e1e7ee; vertical-align: top; line-height: 1.65; min-width: 150px; }
  .guide-content :global(th) { background: #f0f6fd; font-weight: 600; }
  .guide-content :global(td) { color: #425466; }
  .guide-cta { background: #f0f6fd; border-radius: 22px; padding: 34px; margin-top: 55px; }
  .guide-cta h2 { font-size: 27px; font-weight: 600; line-height: 1.2; letter-spacing: -.03em; margin-top: 16px; }
  .guide-cta > p:not(.eyebrow) { font-size: 15px; line-height: 1.8; margin-top: 18px; color: #425466; }
  .quote-button { display: inline-flex; align-items: center; gap: 12px; background: #006cda; border-radius: 12px; color: white; font-size: 14px; font-weight: 600; padding: 15px 20px; margin-top: 25px; line-height: 1.5; }
  .quote-button:hover { background: #0053ad; }
  .related { display: grid; gap: 16px; margin-top: 40px; }
  .related h2 { font-size: 20px; font-weight: 600; }
  .related a { font-size: 15px; text-decoration: underline; color: #005ebd; }
  @media (max-width: 600px) { .automation-guide { width: calc(100% - 36px); padding-top: 26px; } .breadcrumbs { margin-bottom: 32px; } .guide-cta { padding: 26px 22px; } .quote-button { text-align: center; justify-content: center; width: 100%; } .quick-answer { padding: 23px; } }
</style>
