---
import BaseHead from '../components/global/BaseHead.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import CookieConsent from '../components/global/CookieConsent.jsx';
import Analytics from '../components/seo/Analytics.astro';
import Acquisition from '../components/seo/Acquisition.astro';
import ConversionEvents from '../components/seo/ConversionEvents.astro';
import {languagePair} from '../lib/seo/english.mjs';
const {title,description,faq=[],service}=Astro.props;
const canonical=`https://flex-web.fr${Astro.url.pathname}`;
const pair=languagePair(Astro.url.pathname);
const schemas=[{'@type':'WebPage','@id':canonical+'#page',url:canonical,name:title,description,inLanguage:'en',isPartOf:{'@id':'https://flex-web.fr/#website'}},
 {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Flex-Web',item:'https://flex-web.fr/en/'},...(Astro.url.pathname==='/en/'?[]:[{'@type':'ListItem',position:2,name:title,item:canonical}])]},
 ...(service?[{'@type':'Service',name:service,url:canonical,provider:{'@id':'https://flex-web.fr/#organization'},description}]:[]),
 ...(faq.length?[{'@type':'FAQPage',mainEntity:faq.map(({q,a})=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}]:[])];
---
<html lang="en">
 <head><BaseHead title={title} description={description} lang="en" imageAlt="Flex-Web — websites, AI automation and business applications"/><StructuredData schemas={schemas}/><Analytics/><Acquisition/><ConversionEvents/></head>
 <body>
  <a class="skip" href="#content">Skip to content</a>
  <header class="english-header"><nav aria-label="Main navigation"><a href="/en/" class="brand">Flex-Web</a><a href="/en/websites/">Websites</a><a href="/en/applications/">Applications</a><a href="/en/ai-automation/">AI automation</a><a href="/en/crm/">CRM</a><a href="/en/pricing/">Pricing</a><a href={pair?.fr??'/'} lang="fr" hreflang="fr">Français</a><a class="action" href="/en/contact/">Request a quote</a></nav></header>
  <main id="content" class="english-resource"><nav aria-label="Breadcrumb"><a href="/en/">Home</a><span aria-hidden="true"> / </span><span>{title}</span></nav><slot/>
   {faq.length>0 && <section><h2>Frequently asked questions</h2>{faq.map(({q,a})=><details><summary>{q}</summary><p>{a}</p></details>)}</section>}
   <aside class="note"><h2>Start with a clear project brief</h2><p>Tell Flex-Web what you do, which process needs improving, the tools you use and your target date. The scope, price, delivery schedule and project responsibilities are confirmed in the quote.</p><a class="action" href="/en/contact/">Discuss your project</a></aside>
  </main>
  <footer><nav aria-label="Footer navigation"><a href="/en/about/">About Flex-Web</a><a href="/en/how-we-work/">How we work</a><a href="/en/international-projects/">International projects</a><a href="/en/locations/">Location guides</a><a href="/en/faq/">FAQ</a><a href="/mentions-legales/" lang="fr">Legal notice (French)</a><a href="/privacy/" lang="fr">Privacy policy (French)</a><a href="/cgv/" lang="fr">Terms (French)</a><button id="english-cookie-settings" type="button">Cookie settings</button></nav><p>Flex-Web · Fleximmo · 93 chemin de la Combe, 73420 Voglans, France · <a href="mailto:contact@flex-web.fr" data-conversion-event="email_click" data-conversion-service="unknown">contact@flex-web.fr</a> · <a href="tel:+33757830262" data-conversion-event="phone_click" data-conversion-service="unknown">+33 7 57 83 02 62</a></p></footer>
  <CookieConsent lang="en" client:load/>
  <script>document.getElementById('english-cookie-settings')?.addEventListener('click',()=>window.dispatchEvent(new Event('flexweb-cookie-settings')));</script>
 </body>
</html>
<style is:global>
.english-header{border-bottom:1px solid #e5e5e7;background:#fff}.english-header nav,body>footer{max-width:1200px;margin:auto;padding:22px 24px}.english-header nav{display:flex;align-items:center;gap:16px;flex-wrap:wrap}.english-header .brand{font-size:1.4rem;font-weight:750;margin-right:auto}.english-header a{font-size:.95rem}.english-resource{max-width:1120px;margin:auto;padding:64px 24px;color:#1d1d1f;overflow-wrap:anywhere}.english-resource h1{font-size:clamp(2rem,5vw,4rem);line-height:1.1;letter-spacing:-.045em;margin:22px 0}.english-resource h2{font-size:clamp(1.4rem,3vw,2rem);line-height:1.25;margin:32px 0 18px}.english-resource h3{font-size:1.2rem;margin:0 0 12px}.english-resource p,.english-resource li{line-height:1.8;font-size:1.06rem}.english-resource p{margin:12px 0 20px}.english-resource .lead{font-size:1.25rem;color:#50505a}.english-resource a,body>footer a{color:#0066cc}.english-resource nav,body>footer nav{display:flex;gap:12px;flex-wrap:wrap}.english-resource .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin:32px 0}.english-resource .card{padding:28px;border:1px solid #dedee5;border-radius:24px}.english-resource .note{padding:24px;background:#f5f5f7;border-radius:20px;margin:30px 0}.english-resource ul{padding-left:22px;list-style:disc}.english-resource table{width:100%;border-collapse:collapse}.english-resource th,.english-resource td{padding:12px;border-bottom:1px solid #dedee5;text-align:left;overflow-wrap:anywhere}.english-resource details{padding:18px 0;border-bottom:1px solid #dedee5}.english-resource summary{cursor:pointer;font-weight:600}.english-resource .meta{font-size:.9rem;color:#666}.english-resource .action,.english-header .action{display:inline-block;background:#0071e3;color:#fff;padding:12px 22px;border-radius:999px}body>footer{border-top:1px solid #dedee5;font-size:.9rem;line-height:1.8}body>footer p{margin-top:24px}.skip{position:absolute;left:-10000px}.skip:focus{left:12px;top:12px;background:white;padding:12px;z-index:100}.english-resource a:focus-visible,.english-header a:focus-visible,body>footer button:focus-visible{outline:3px solid #0071e3;outline-offset:4px}@media(max-width:600px){.english-resource{padding:36px 20px}.english-resource .grid{grid-template-columns:1fr}.english-header nav{gap:12px}.english-header .brand{flex-basis:55%}.english-resource .card{padding:20px}}
</style>
