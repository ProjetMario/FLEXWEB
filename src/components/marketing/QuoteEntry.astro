---
import { commercialQuoteHref, type CommercialService } from '../../data/commercialConversion';
interface Props { service: CommercialService; secondaryHref?: string; secondaryLabel?: string }
const { service, secondaryHref = '#votre-projet', secondaryLabel = 'Voir le périmètre et le budget' } = Astro.props;
---
<div class="quote-entry">
  <a class="quote-entry-primary" href={commercialQuoteHref(service)} data-conversion-event="quote_click" data-conversion-service={service}>Demander mon devis <span aria-hidden="true">→</span></a>
  <a class="quote-entry-secondary" href={secondaryHref}>{secondaryLabel}</a>
  <p>Demande gratuite — périmètre et calendrier validés avant paiement.</p>
</div>
<style>
  .quote-entry{display:flex;flex-wrap:wrap;gap:16px 24px;align-items:center;margin-top:28px;color:#172133}.quote-entry-primary{display:inline-flex;align-items:center;justify-content:center;gap:14px;background:#006cda;color:#fff;border-radius:12px;padding:15px 22px;font-weight:600;min-height:48px}.quote-entry-primary:hover{background:#0053ad}.quote-entry-secondary{color:#075bbb;text-decoration:underline;text-underline-offset:4px;line-height:1.6}.quote-entry p{flex-basis:100%;font-size:13px;line-height:1.6;color:#52617a;margin:0}.quote-entry a:focus-visible{outline:3px solid #1260d6;outline-offset:5px}@media(max-width:600px){.quote-entry-primary{width:100%}.quote-entry{gap:14px}}
</style>
