---
import BaseLayout from "../../layout/BaseLayout.astro";
import StructuredData from "../seo/StructuredData.astro";
import type { AutomationPage } from "../../data/automationPages";

interface Props { page: AutomationPage }
const { page } = Astro.props;
const siteUrl = "https://flex-web.fr";
const canonicalUrl = `${siteUrl}/${page.slug}/`;
const isHub = page.area === "France";
const guides = [
  { href: "/journal/taches-automatiser-pme/", title: "Quelles tâches automatiser dans une PME ?", text: "Choisir un premier parcours utile et mesurable." },
  { href: "/journal/connecter-demandes-crm/", title: "Relier les demandes de votre site à un CRM", text: "Passer du formulaire à une prochaine action claire." },
  { href: "/journal/automatisation-ou-application-sur-mesure/", title: "Automatisation ou application sur mesure ?", text: "Choisir selon votre besoin, vos outils et vos utilisateurs." },
];
const method = [
  { title: "Décrire le travail", text: "Nous identifions une tâche répétitive, son volume, les personnes concernées et les exceptions." },
  { title: "Cadrer le parcours", text: "Le devis précise les étapes, les connexions à vérifier, les validations et les éventuels coûts récurrents." },
  { title: "Tester une démonstration", text: "Nous vérifions des cas normaux, des informations manquantes et des interruptions avant votre validation." },
  { title: "Mettre en service et suivre", text: "La prise en main, la visibilité des erreurs et le périmètre de suivi sont définis avec vous." },
];
const schemas = [
  { "@type": "WebPage", "@id": canonicalUrl, url: canonicalUrl, name: page.title, description: page.description, inLanguage: "fr-FR", isPartOf: { "@id": `${siteUrl}/#website` } },
  { "@type": "Service", "@id": `${canonicalUrl}#service`, url: canonicalUrl, name: `Automatisation de tâches IA ${isHub ? "en France" : `en ${page.area}`}`, description: page.intro, serviceType: "Automatisation de tâches et intégration CRM", provider: { "@id": `${siteUrl}/#organization` }, areaServed: { "@type": isHub ? "Country" : "AdministrativeArea", name: page.area }, offers: { "@type": "Offer", name: "Projet d’automatisation sur mesure sur devis", description: "Périmètre, connexions et coûts récurrents précisés dans le devis.", url: `${siteUrl}/demarrer/?service=automation` } },
  { "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: `${siteUrl}/` },
    ...(!isHub ? [{ "@type": "ListItem", position: 2, name: "Automatisation IA", item: `${siteUrl}/automatisation-ia/` }] : []),
    { "@type": "ListItem", position: isHub ? 2 : 3, name: isHub ? "Automatisation IA" : page.area, item: canonicalUrl },
  ] },
  { "@type": "FAQPage", "@id": `${canonicalUrl}#questions`, mainEntity: page.faq.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) },
];
---

<BaseLayout title={page.title} description={page.description}>
  <StructuredData schemas={schemas} slot="head" />
  <div class="automation-page">
    <section class="hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Fil d’Ariane">
          <a href="/">Accueil</a><span aria-hidden="true">/</span>
          {!isHub && <><a href="/automatisation-ia/">Automatisation IA</a><span aria-hidden="true">/</span></>}
          <span aria-current="page">{isHub ? "Automatisation IA" : page.area}</span>
        </nav>
        <div class="hero-grid">
          <div>
            <p class="eyebrow">{page.label}</p>
            <h1>{page.heading}</h1>
            <p class="intro">{page.intro}</p>
            <div class="actions">
              <a class="button primary" href="/demarrer/?service=automation">Demander un devis d’automatisation IA <span aria-hidden="true">↗</span></a>
              <a class="text-link" href="#exemples">Voir des exemples <span aria-hidden="true">↓</span></a>
            </div>
            <p class="fineprint">Projet sur mesure · Outils existants étudiés · Validation humaine définie ensemble</p>
          </div>
          <aside class="workflow" aria-label="Exemple de parcours d’une demande">
            <p class="eyebrow">Exemple de fonctionnement</p>
            <h2>De la demande<br />à la prochaine action.</h2>
            <ol>
              <li><span class="step-icon" aria-hidden="true">01</span><div><strong>Une demande arrive</strong><p>Le besoin et les coordonnées sont recueillis.</p></div></li>
              <li><span class="step-icon" aria-hidden="true">02</span><div><strong>Le suivi s’organise</strong><p>Une fiche et une tâche sont préparées.</p></div></li>
              <li><span class="step-icon" aria-hidden="true">03</span><div><strong>Vous gardez la main</strong><p>Vous validez la réponse et l’engagement.</p></div></li>
            </ol>
            <p class="workflow-note">Illustration d’un parcours possible, à adapter à vos outils.</p>
          </aside>
        </div>
      </div>
    </section>

    <section class="container content-section" aria-labelledby="context-title">
      <div class="split-heading">
        <div><p class="eyebrow">Le besoin avant l’outil</p><h2 id="context-title">{page.contextTitle}</h2></div>
        <div class="paragraphs">{page.context.map((paragraph) => <p>{paragraph}</p>)}</div>
      </div>
    </section>

    <section class="soft-section" id="exemples" aria-labelledby="examples-title">
      <div class="container content-section">
        <p class="eyebrow">Cas d’usage</p>
        <h2 id="examples-title">Des tâches concrètes à simplifier</h2>
        <p class="section-intro">Démonstrations de parcours possibles : ces exemples ne sont pas des résultats clients.</p>
        <div class="examples-grid">
          {page.examples.map((example) => <article class="example-card">
            <p class="card-label">{example.audience}</p>
            <h3>{example.title}</h3>
            <p>{example.description}</p>
            <ol class="mini-steps">{example.steps.map((step) => <li>{step}</li>)}</ol>
            <p class="review"><strong>Point de contrôle</strong><br />{example.review}</p>
          </article>)}
        </div>
      </div>
    </section>

    <section class="container content-section" aria-labelledby="method-title">
      <p class="eyebrow">Notre méthode</p>
      <h2 id="method-title">Commencer par un parcours maîtrisé</h2>
      <div class="method-grid">{method.map((step, index) => <article>
        <span class="method-number" aria-hidden="true">0{index + 1}</span>
        <h3>{step.title}</h3><p>{step.text}</p>
      </article>)}</div>
      <div class="measurement"><h3>Mesurer ce qui change</h3><p>Avant la mise en service, choisissez un repère : temps de traitement d’une demande, ressaisies nécessaires ou actions en attente. Comparez ensuite des périodes similaires. Les gains dépendent du processus et doivent être observés dans votre activité.</p></div>
    </section>

    <section class="container content-section section-border" aria-labelledby="ecosystem-title">
      <div class="split-heading">
        <div><p class="eyebrow">Un parcours cohérent</p><h2 id="ecosystem-title">Votre site, vos outils, votre suivi.</h2></div>
        <div class="paragraphs"><p>Un <a href="/creation-site-internet/">site internet professionnel</a> présente vos services et recueille les demandes. Le CRM sert à suivre les échanges et les prochaines actions. L’automatisation relie les étapes compatibles.</p><p>Si votre besoin exige un espace utilisateur, des droits particuliers ou un outil métier complet, découvrez le <a href="/creation-application-mobile/">développement d’applications web et mobiles sur mesure</a>. Le projet d’application reste sur devis.</p><p>Retrouvez les offres de sites et leurs options sur la <a href="/pricing/">page des tarifs</a>. Une automatisation IA sur mesure fait l’objet d’un devis adapté au parcours retenu.</p></div>
      </div>
    </section>

    <section class="container content-section section-border" id="questions" aria-labelledby="faq-title">
      <div class="split-heading">
        <div><p class="eyebrow">Questions fréquentes</p><h2 id="faq-title">Avant de vous lancer</h2></div>
        <div class="faq">{page.faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
      </div>
    </section>

    <section class="soft-section" aria-labelledby="guides-title">
      <div class="container content-section"><p class="eyebrow">Pour préparer votre projet</p><h2 id="guides-title">Trois guides pour décider</h2><div class="guides-grid">{guides.map((guide) => <a class="guide-card" href={guide.href}><h3>{guide.title} <span aria-hidden="true">↗</span></h3><p>{guide.text}</p></a>)}</div></div>
    </section>

    <section class="container content-section">
      <aside class="quote-panel"><p class="eyebrow">Parlons de votre première tâche</p><h2>Qu’aimeriez-vous arrêter de recopier chaque semaine ?</h2><p>Décrivez votre activité, vos outils et une tâche qui revient souvent. Nous pourrons cadrer un premier projet et établir une proposition sur devis.</p><a class="button primary" href="/demarrer/?service=automation">Demander mon devis d’automatisation IA <span aria-hidden="true">↗</span></a></aside>
      <nav class="regions" aria-label="Automatisation IA par zone">
        <span>Découvrir l’accompagnement :</span>
        <a href="/automatisation-ia/" aria-current={isHub ? "page" : undefined}>France</a>
        <a href="/automatisation-ia-savoie/" aria-current={page.area === "Savoie" ? "page" : undefined}>Savoie</a>
        <a href="/automatisation-ia-haute-savoie/" aria-current={page.area === "Haute-Savoie" ? "page" : undefined}>Haute-Savoie</a>
      </nav>
    </section>
  </div>
</BaseLayout>

<style>
  .automation-page { color: var(--color-text); }
  .container { width: min(1160px, calc(100% - 48px)); margin-inline: auto; }
  .hero { background: linear-gradient(155deg, #f4f8fc, #fff 80%); border-bottom: 1px solid #e8edf2; padding: 28px 0 80px; }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: 10px; color: #525e6b; font-size: 13px; margin-bottom: 60px; }
  .breadcrumbs a:hover { text-decoration: underline; }
  .hero-grid { display: grid; grid-template-columns: 1.3fr 1fr; align-items: center; gap: 64px; }
  .eyebrow { color: #005ebd; text-transform: uppercase; letter-spacing: .12em; font-size: 11px; font-weight: 650; margin: 0 0 18px; }
  h1 { font-size: clamp(2.35rem, 4.2vw, 3.6rem); line-height: 1.07; letter-spacing: -.055em; font-weight: 600; text-wrap: balance; }
  h2 { font-size: clamp(1.7rem, 2.8vw, 2.45rem); line-height: 1.15; letter-spacing: -.04em; font-weight: 600; text-wrap: balance; }
  h3 { font-size: 1.15rem; font-weight: 600; line-height: 1.35; letter-spacing: -.02em; }
  p { line-height: 1.75; color: #53606d; }
  .intro { font-size: 17px; margin-top: 24px; }
  .actions { margin-top: 32px; display: flex; align-items: center; flex-wrap: wrap; gap: 22px; }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 12px; border-radius: 12px; padding: 16px 21px; font-size: 14px; font-weight: 600; line-height: 1.4; text-align: center; transition: background .15s; }
  .primary { background: #006cda; color: #fff; }
  .primary:hover { background: #0053ad; }
  .text-link { font-size: 14px; text-underline-offset: 5px; }
  .text-link:hover { text-decoration: underline; }
  .fineprint { font-size: 12px; margin-top: 20px; }
  .workflow { border: 1px solid #dce5ef; border-radius: 24px; background: #fff; padding: 30px; box-shadow: 0 22px 65px #143a6520; }
  .workflow h2 { font-size: 27px; }
  .workflow ol { margin-top: 28px; display: grid; gap: 22px; }
  .workflow li { display: flex; gap: 15px; align-items: flex-start; }
  .step-icon { display: grid; place-items: center; width: 34px; height: 34px; flex-shrink: 0; border-radius: 10px; background: #edf5ff; color: #005ebd; font-size: 12px; font-weight: 650; }
  .workflow strong { font-size: 14px; }
  .workflow li p { font-size: 13px; line-height: 1.6; margin-top: 3px; }
  .workflow-note { border-top: 1px solid #e8edf2; margin-top: 25px; padding-top: 18px; font-size: 11px; }
  .content-section { padding-block: 76px; }
  .split-heading { display: grid; grid-template-columns: .9fr 1.3fr; gap: 85px; }
  .paragraphs { display: grid; gap: 20px; }
  .paragraphs a { color: #005ebd; text-decoration: underline; text-underline-offset: 3px; }
  .soft-section { background: #f6f8fb; }
  .section-intro { margin-top: 16px; max-width: 680px; }
  .examples-grid, .guides-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 34px; }
  .example-card { display: flex; flex-direction: column; background: white; border: 1px solid #e1e7ee; border-radius: 18px; padding: 25px; }
  .card-label { color: #005ebd; font-size: 11px; font-weight: 600; margin-bottom: 16px; }
  .example-card > p:not(.card-label) { font-size: 14px; margin-top: 14px; }
  .mini-steps { display: grid; gap: 9px; margin-block: 22px; counter-reset: demo; }
  .mini-steps li { counter-increment: demo; font-size: 12px; background: #f5f8fc; padding: 9px 12px; border-radius: 7px; }
  .mini-steps li::before { content: counter(demo) ". "; color: #005ebd; font-weight: 600; }
  .example-card .review { margin-top: auto !important; padding-top: 16px; border-top: 1px solid #edf0f4; font-size: 12px !important; }
  .review strong { color: #263749; }
  .method-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; margin-top: 40px; }
  .method-number { display: block; font-size: 13px; color: #0066cc; margin-bottom: 20px; }
  .method-grid p { font-size: 14px; margin-top: 12px; }
  .measurement { padding: 25px; border-left: 3px solid #0071e3; background: #f6f8fb; margin-top: 35px; }
  .measurement h3 { font-size: 16px; }
  .measurement p { margin-top: 9px; font-size: 14px; }
  .section-border { border-top: 1px solid #e8edf2; }
  .faq details { border-bottom: 1px solid #e0e6ec; padding: 21px 0; }
  .faq details:first-child { padding-top: 0; }
  .faq summary { font-size: 16px; font-weight: 550; cursor: pointer; line-height: 1.6; }
  .faq p { font-size: 14px; margin-top: 14px; }
  .guide-card { background: #fff; border: 1px solid #e1e7ee; border-radius: 15px; padding: 24px; transition: border-color .15s; }
  .guide-card:hover { border-color: #0071e3; }
  .guide-card h3 { font-size: 17px; }
  .guide-card p { margin-top: 12px; font-size: 14px; }
  .quote-panel { text-align: center; border-radius: 24px; background: #edf5ff; padding: 50px 35px; }
  .quote-panel h2 { max-width: 660px; margin-inline: auto; }
  .quote-panel > p:not(.eyebrow) { max-width: 600px; margin: 20px auto 26px; }
  .regions { display: flex; justify-content: center; flex-wrap: wrap; gap: 18px; margin-top: 30px; font-size: 13px; color: #53606d; }
  .regions a { color: #005ebd; text-decoration: underline; text-underline-offset: 3px; }
  .regions a[aria-current="page"] { font-weight: 650; }
  @media (max-width: 900px) { .hero-grid { gap: 30px; } .split-heading { gap: 40px; } .method-grid { grid-template-columns: repeat(2, 1fr); } .examples-grid { gap: 14px; } .example-card { padding: 20px; } }
  @media (max-width: 700px) { .container { width: calc(100% - 36px); } .hero { padding-bottom: 48px; } .breadcrumbs { margin-bottom: 36px; } .hero-grid, .split-heading, .examples-grid, .guides-grid { grid-template-columns: 1fr; } .hero-grid { gap: 40px; } .content-section { padding-block: 48px; } .split-heading { gap: 26px; } .workflow { padding: 25px; } .button { width: 100%; } .method-grid { gap: 28px 20px; } .method-grid h3 { font-size: 16px; } .quote-panel { padding: 34px 22px; } .regions { gap: 13px; } .regions span { width: 100%; text-align: center; } }
</style>
