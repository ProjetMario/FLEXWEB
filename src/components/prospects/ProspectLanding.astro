---
import { projectOffers, pricingOptions } from "../../data/pricing";

type Theme = "building" | "interiors" | "garden" | "beauty" | "care" | "food" | "automotive" | "creative" | "services";
interface Prospect {
  slug: string;
  name: string;
  activity: string;
  city: string;
  theme: Theme;
  headline: string;
  intro: string;
  services: { title: string; text: string }[];
  sourceUrl?: string;
  verifiedAt?: string;
  logo?: { src: string; alt: string; width: number; height: number; origin: "official" | "proposed"; sourceUrl?: string; verifiedAt?: string; iconSrc?: string; background?: string };
  heroImage?: { src: string; alt: string; credit?: string };
  accent?: string;
}
interface Props { prospect: Prospect }
const { prospect } = Astro.props;
const themes: Theme[] = ["building", "interiors", "garden", "beauty", "care", "food", "automotive", "creative", "services"];
const theme = themes.includes(prospect.theme) ? prospect.theme : "services";
const visualTitles: Record<Theme, string> = {
  building: "Des lignes solides. Un projet qui prend forme.",
  interiors: "Faire de la place aux belles idées.",
  garden: "Une place pour le vivant.",
  beauty: "Une parenthèse, tout simplement.",
  care: "L’attention fait la différence.",
  food: "Le goût des choses bien présentées.",
  automotive: "Prendre la bonne direction.",
  creative: "Donner forme à vos idées.",
  services: "Les bonnes solutions commencent ici.",
};
const monogram = prospect.name.split(/\s+/).filter(Boolean).slice(0, 2).map(word => word[0]).join("").toLocaleUpperCase("fr-FR");
const canonical = `https://flex-web.fr/${encodeURIComponent(prospect.slug)}/`;
const quoteHref = (service: string, offer: string, intent?: string) => `/demarrer/?${new URLSearchParams({ service, offre: offer, maquette: prospect.slug, ...(intent ? { intent } : {}) })}`;
const standardHref = quoteHref("site", "essentielle");
const modifyHref = quoteHref("site", "essentielle", "modification");
const euro = (cents: number) => new Intl.NumberFormat("fr-FR", { style: "currency", currency: "EUR", maximumFractionDigits: 0 }).format(cents / 100);
const isSafeUrl = (value?: string) => Boolean(value && (/^https?:\/\//i.test(value) || /^\/(?!\/)/.test(value)));
const heroImage = isSafeUrl(prospect.heroImage?.src) ? prospect.heroImage : null;
const logo = isSafeUrl(prospect.logo?.src) ? prospect.logo : null;
const compactLogo = Boolean(logo && logo.width / logo.height < 1.6);
const logoBackground = /^#[0-9a-f]{6}$/i.test(logo?.background || "") ? `background:${logo.background}` : undefined;
const sourceUrl = /^https?:\/\//i.test(prospect.sourceUrl || "") ? prospect.sourceUrl : null;
const accent = /^#[0-9a-f]{6}$/i.test(prospect.accent || "") ? prospect.accent : null;
const verifiedDate = prospect.verifiedAt && !Number.isNaN(Date.parse(prospect.verifiedAt))
  ? new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "long", year: "numeric", timeZone: "Europe/Paris" }).format(new Date(prospect.verifiedAt)) : null;
const offerLabels = ["Standard", "Medium", "Premium"];
const offerEyebrows = ["Votre première présence en ligne", "Votre visibilité, plus loin", "Votre quotidien, plus simple"];
const offerHrefs = [standardHref, quoteHref("seo", "visibilite"), quoteHref("automation", "crm-automation")];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="flexweb-content-kind" content="prospect-mockup" />
    <meta name="description" content={`Une proposition de site personnalisée pour ${prospect.name}, ${prospect.activity} à ${prospect.city}. Maquette non officielle réalisée par Flex-Web.`} />
    <meta name="theme-color" content="#f6f4ee" />
    <meta property="og:title" content={`${prospect.name} — votre proposition de site`} />
    <meta property="og:description" content="Une première idée de votre futur site internet, imaginée par Flex-Web. Maquette non officielle." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    {logo?.iconSrc && <link rel="icon" type="image/svg+xml" href={logo.iconSrc} />}
    <title>{prospect.name} — proposition de site par Flex-Web</title>
  </head>
  <body data-theme={theme} style={accent ? `--accent:${accent}` : undefined}>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <aside class="preview-notice" aria-label="À propos de cette maquette">
      <span class="preview-dot" aria-hidden="true"></span>
      <span>Proposition de site réalisée par <a href="https://flex-web.fr/">Flex-Web</a> <span class="notice-dash">—</span> <strong>maquette non officielle</strong></span>
    </aside>

    <div class="prospect-preview">
      <header class="brand-header shell">
        <a class:list={["brand", { "brand--with-logo": Boolean(logo) }]} href="#contenu" aria-label={`${prospect.name}, début de la maquette`}>
          {logo ? <span class:list={["brand-identity", { "brand-identity--compact": compactLogo }]} data-logo-origin={logo.origin}>
            <img class:list={["brand-logo", { "brand-logo--backed": Boolean(logo.background) }]} style={logoBackground} src={logo.src} alt={logo.alt} width={logo.width} height={logo.height} fetchpriority="high" />
            <span class="brand-caption">{compactLogo && <strong>{prospect.name}</strong>}<span class="brand-location">{prospect.city}{logo.origin === "proposed" && <span class="logo-proposal"> · Logo proposé</span>}</span></span>
          </span> : <><span class="brand-mark" aria-hidden="true">{monogram}</span><span class="brand-wordmark">{prospect.name}<small>{prospect.city}</small></span></>}
        </a>
        <nav class="main-nav" aria-label="Navigation de la maquette">
          <a class="nav-services" href="#prestations">Prestations</a>
          <a class="nav-contact" href="#votre-site">Choisir mon pack <span aria-hidden="true">↗</span></a>
        </nav>
      </header>

      <main id="contenu">
        <section class="hero shell" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span>{prospect.activity} <span class="location-separator" aria-hidden="true">/</span> {prospect.city}</p>
            <h1 id="hero-title">{prospect.headline}</h1>
            <p class="hero-intro">{prospect.intro}</p>
            <div class="hero-actions">
              <a class="button primary" href="#prestations">Découvrir les prestations <span aria-hidden="true">↗</span></a>
              <a class="text-link hero-offer-link" href="#votre-site"><strong>Votre site dès 299 € TTC</strong><span>Voir les packs <span aria-hidden="true">↓</span></span></a>
            </div>
            <div class="hero-signature"><span aria-hidden="true">✳</span><p><strong>{prospect.name}</strong><br />Une présence à votre image.</p></div>
          </div>

          <figure class:list={["hero-visual", { "has-image": Boolean(heroImage) }]}>
            {heroImage ? <img class="hero-photo" src={heroImage.src} alt={heroImage.alt} width="720" height="840" fetchpriority="high" /> : <div class="illustration-stage">
              <div class="visual-grid" aria-hidden="true"></div>
              <svg class="trade-illustration" viewBox="0 0 600 660" fill="none" role="img" aria-labelledby="illustration-title">
                <title id="illustration-title">Illustration graphique pour l’activité : {prospect.activity}. Ce visuel ne représente pas une réalisation de l’entreprise.</title>
                {theme === "building" && <g>
                  <circle cx="450" cy="160" r="69" fill="var(--visual-soft)" />
                  <path d="M78 480L292 569L522 475L307 386L78 480Z" fill="var(--visual-shadow)" />
                  <path d="M128 301L302 214L477 301V469L302 554L128 468V301Z" fill="var(--visual-paper)" />
                  <path d="M302 214V554L477 469V301L302 214Z" fill="var(--visual-soft)" />
                  <path d="M104 300L302 113L501 300L302 210L104 300Z" fill="var(--accent)" />
                  <path d="M302 113L501 300L302 210V113Z" fill="var(--visual-dark)" />
                  <path d="M173 353L224 377V436L173 412V353ZM349 345L407 317V376L349 403V345Z" fill="var(--visual-dark)" />
                  <path d="M255 447L285 461V532L255 518V447Z" fill="var(--accent)" />
                  <path d="M78 520H190M78 536H149M448 540H521M479 556H521" stroke="var(--visual-dark)" stroke-width="2" />
                  <path d="M80 206V150H135M494 386H541V442" stroke="var(--visual-dark)" stroke-width="2" />
                  <circle cx="80" cy="206" r="5" fill="var(--accent)" />
                </g>}
                {theme === "interiors" && <g>
                  <path d="M100 472V234C100 129 171 91 235 91C299 91 370 129 370 234V472H100Z" fill="var(--visual-paper)" />
                  <path d="M126 460V237C126 150 184 118 235 118C286 118 344 150 344 237V460" stroke="var(--visual-soft)" stroke-width="2" />
                  <ellipse cx="310" cy="526" rx="204" ry="32" fill="var(--visual-shadow)" />
                  <path d="M155 383C155 347 184 318 220 318H343C379 318 408 347 408 383V453H155V383Z" fill="var(--accent)" />
                  <rect x="135" y="406" width="293" height="77" rx="23" fill="var(--visual-dark)" />
                  <rect x="157" y="483" width="11" height="45" rx="5" fill="var(--visual-dark)" />
                  <rect x="394" y="483" width="11" height="45" rx="5" fill="var(--visual-dark)" />
                  <rect x="281" y="346" width="88" height="65" rx="18" transform="rotate(9 281 346)" fill="var(--visual-paper)" />
                  <path d="M455 285V519M421 519H490" stroke="var(--visual-dark)" stroke-width="6" stroke-linecap="round" />
                  <path d="M397 290L417 202H493L514 290H397Z" fill="var(--visual-soft)" />
                  <circle cx="235" cy="213" r="52" stroke="var(--accent)" stroke-width="2" />
                  <path d="M235 161V265M183 213H287" stroke="var(--accent)" stroke-width="2" />
                </g>}
                {theme === "garden" && <g>
                  <circle cx="305" cy="303" r="196" fill="var(--visual-paper)" />
                  <ellipse cx="298" cy="548" rx="180" ry="25" fill="var(--visual-shadow)" />
                  <path d="M298 450V189" stroke="var(--visual-dark)" stroke-width="7" stroke-linecap="round" />
                  <path d="M298 287C204 300 154 247 158 160C249 149 300 196 298 287Z" fill="var(--accent)" />
                  <path d="M299 359C387 378 444 331 452 245C364 225 307 273 299 359Z" fill="var(--visual-dark)" />
                  <path d="M297 429C220 446 168 408 158 334C235 316 288 353 297 429Z" fill="var(--accent)" />
                  <path d="M296 215C345 207 373 167 360 112C307 121 282 161 296 215Z" fill="var(--visual-dark)" />
                  <path d="M176 179L285 280M432 263L313 351M178 351L285 420" stroke="var(--visual-paper)" stroke-width="2" />
                  <path d="M228 454H372L353 548H246L228 454Z" fill="var(--visual-soft)" />
                  <rect x="218" y="447" width="163" height="20" rx="8" fill="var(--visual-dark)" />
                  <circle cx="128" cy="387" r="5" fill="var(--accent)" /><circle cx="463" cy="192" r="6" fill="var(--accent)" />
                </g>}
                {theme === "beauty" && <g>
                  <path d="M139 519V246C139 151 209 91 301 91C393 91 463 151 463 246V519H139Z" fill="var(--visual-paper)" />
                  <path d="M163 506V246C163 164 224 115 301 115C378 115 439 164 439 246V506" stroke="var(--accent)" stroke-width="1.5" />
                  <ellipse cx="304" cy="540" rx="180" ry="25" fill="var(--visual-shadow)" />
                  <path d="M283 459C247 445 228 420 231 382C233 349 258 321 268 289C276 263 272 242 287 223C304 202 339 207 351 230C365 258 345 281 354 300C359 311 381 320 382 327C384 336 367 340 365 349L366 367C366 381 355 391 337 391H322L317 429L365 456" stroke="var(--visual-dark)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M284 230C227 214 188 253 195 299C200 335 225 338 229 361" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" />
                  <circle cx="319" cy="335" r="10" stroke="var(--accent)" stroke-width="3" />
                  <rect x="171" y="432" width="71" height="102" rx="13" fill="var(--accent)" />
                  <rect x="191" y="411" width="31" height="25" rx="4" fill="var(--visual-dark)" />
                  <path d="M188 464H226M188 478H214" stroke="var(--visual-paper)" stroke-width="2" />
                  <path d="M404 389V522M404 448C367 447 365 414 368 400C399 402 408 423 404 448ZM405 478C441 474 451 449 448 429C413 431 403 456 405 478Z" stroke="var(--accent)" stroke-width="2" />
                </g>}
                {theme === "care" && <g>
                  <circle cx="302" cy="303" r="195" fill="var(--visual-paper)" />
                  <path d="M300 403C275 383 198 333 198 278C198 246 221 224 251 224C275 224 292 238 300 253C309 238 326 224 349 224C379 224 402 246 402 278C402 333 326 383 300 403Z" fill="var(--accent)" />
                  <path d="M126 380L207 454C225 469 244 474 267 474H345C357 474 366 465 366 454C366 442 357 433 345 433H289L257 414C240 404 223 402 207 409L184 389" stroke="var(--visual-dark)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M366 452L445 390C458 380 474 383 481 393C488 403 485 417 475 427L386 511C370 526 349 534 326 534H239C218 534 199 526 183 513L119 458" stroke="var(--visual-dark)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
                  <circle cx="178" cy="180" r="21" fill="var(--visual-soft)" />
                  <path d="M420 151V187M402 169H438M111 287V311M99 299H123" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" />
                </g>}
                {theme === "food" && <g>
                  <rect x="100" y="117" width="401" height="425" rx="190" fill="var(--visual-paper)" />
                  <ellipse cx="301" cy="478" rx="204" ry="54" fill="var(--visual-shadow)" />
                  <ellipse cx="297" cy="446" rx="160" ry="64" fill="var(--visual-paper)" stroke="var(--visual-dark)" stroke-width="3" />
                  <ellipse cx="297" cy="443" rx="128" ry="47" stroke="var(--accent)" stroke-width="2" />
                  <path d="M188 415C188 334 241 278 303 278C365 278 416 334 416 415H188Z" fill="var(--accent)" />
                  <path d="M242 402C242 359 264 322 294 302M298 408C298 365 320 328 350 308M351 407C352 380 365 357 383 343" stroke="var(--visual-paper)" stroke-width="8" stroke-linecap="round" />
                  <path d="M235 242C206 217 247 191 230 166M306 235C275 208 320 182 304 154M377 247C346 220 390 194 374 166" stroke="var(--visual-dark)" stroke-width="2" stroke-linecap="round" />
                  <path d="M127 314V456M113 314V350C113 367 141 367 141 350V314M478 315V456M478 315C445 340 450 381 478 381" stroke="var(--visual-dark)" stroke-width="4" stroke-linecap="round" />
                </g>}
                {theme === "automotive" && <g>
                  <circle cx="326" cy="275" r="174" fill="var(--visual-soft)" />
                  <path d="M77 499H526M101 526H488" stroke="var(--visual-dark)" stroke-width="2" />
                  <path d="M105 383L155 355L213 268H367L440 351L481 364C495 368 505 382 505 397V442H96V403C96 395 99 388 105 383Z" fill="var(--visual-paper)" />
                  <path d="M176 350L227 286H295V350H176ZM312 286H359L414 350H312V286Z" fill="var(--visual-dark)" />
                  <path d="M96 407H505V441H96V407Z" fill="var(--accent)" />
                  <circle cx="180" cy="442" r="47" fill="var(--visual-dark)" /><circle cx="180" cy="442" r="24" fill="var(--visual-paper)" />
                  <circle cx="420" cy="442" r="47" fill="var(--visual-dark)" /><circle cx="420" cy="442" r="24" fill="var(--visual-paper)" />
                  <path d="M314 365H338M105 387H134M470 387H499" stroke="var(--visual-dark)" stroke-width="6" stroke-linecap="round" />
                  <path d="M91 208H221M126 228H199M403 158H502M439 178H515" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" />
                </g>}
                {theme === "creative" && <g>
                  <rect x="115" y="139" width="341" height="376" rx="7" transform="rotate(-7 115 139)" fill="var(--visual-soft)" />
                  <rect x="145" y="143" width="341" height="376" rx="7" transform="rotate(6 145 143)" fill="var(--visual-paper)" />
                  <circle cx="263" cy="302" r="88" fill="var(--accent)" />
                  <path d="M288 215L419 395H197L288 215Z" fill="var(--visual-dark)" />
                  <circle cx="308" cy="333" r="53" fill="var(--visual-paper)" />
                  <path d="M185 444H368M185 463H290" stroke="var(--visual-dark)" stroke-width="4" stroke-linecap="round" />
                  <path d="M448 104L456 133L485 140L456 148L448 177L440 148L411 140L440 133L448 104Z" fill="var(--accent)" />
                  <path d="M94 436L99 455L118 460L99 465L94 484L89 465L70 460L89 455L94 436Z" fill="var(--accent)" />
                </g>}
                {theme === "services" && <g>
                  <circle cx="308" cy="292" r="187" fill="var(--visual-paper)" />
                  <rect x="141" y="185" width="305" height="352" rx="13" fill="var(--visual-dark)" transform="rotate(-5 141 185)" />
                  <rect x="160" y="158" width="305" height="352" rx="13" fill="var(--visual-paper)" stroke="var(--accent)" stroke-width="2" transform="rotate(4 160 158)" />
                  <rect x="191" y="208" width="45" height="45" rx="10" fill="var(--accent)" />
                  <path d="M202 229L212 239L228 220" stroke="var(--visual-paper)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M261 227H398M260 245H344M184 298H394M182 318H353M176 383H291M175 403H263" stroke="var(--visual-dark)" stroke-width="3" stroke-linecap="round" />
                  <circle cx="397" cy="441" r="66" fill="var(--accent)" />
                  <path d="M373 441H421M400 421L421 441L400 462" stroke="var(--visual-paper)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M117 123V153M102 138H132M471 264V288M459 276H483" stroke="var(--accent)" stroke-width="2" />
                </g>}
              </svg>
              <span class="visual-corner visual-corner-top" aria-hidden="true">+</span><span class="visual-corner visual-corner-bottom" aria-hidden="true">+</span>
            </div>}
            <figcaption class="visual-caption"><span>{heroImage ? heroImage.credit || "Visuel de présentation" : "Illustration"}</span><p>{visualTitles[theme]}</p></figcaption>
          </figure>
        </section>

        <div class="identity-strip shell" aria-label="Votre identité en un regard">
          <div><span class="small-label">L’entreprise</span><strong>{prospect.name}</strong></div>
          <div><span class="small-label">Le métier</span><strong>{prospect.activity}</strong></div>
          <div><span class="small-label">Le point de départ</span><strong>{prospect.city}</strong></div>
        </div>

        <section class="services-section shell" id="prestations" aria-labelledby="services-title">
          <div class="section-intro"><p class="eyebrow">PRESTATIONS</p><h2 id="services-title">Votre savoir-faire,<br /><em>au premier plan.</em></h2><p>Une présentation claire de votre activité, pour que chaque visiteur trouve ce qui l’intéresse.</p></div>
          <div class="services-grid">{prospect.services.map((service, index) => <article class="service-card">
            <div class="service-heading"><span class="service-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><span class="service-symbol" aria-hidden="true">↗</span></div>
            <h3>{service.title}</h3><p>{service.text}</p>
          </article>)}</div>
        </section>

        <section class="contact-preview shell" aria-labelledby="contact-preview-title">
          <span class="contact-asterisk" aria-hidden="true">✳</span>
          <div><p class="eyebrow">LE PROCHAIN ÉCHANGE COMMENCE ICI</p><h2 id="contact-preview-title">Un site à votre image.<br />Un contact plus simple.</h2><p>Cet espace pourra accueillir vos coordonnées et un formulaire de demande. Pour l’instant, découvrez comment concrétiser cette proposition avec Flex-Web.</p></div>
          <a class="button primary" href="#votre-site">Choisir mon pack <span aria-hidden="true">↗</span></a>
        </section>
      </main>

      <div class="preview-end shell"><span>{prospect.name}</span><span>Fin de l’aperçu · Proposition non officielle</span></div>
    </div>

    <section class="flex-offer" id="votre-site" aria-labelledby="offer-title">
      <div class="offer-shell">
        <div class="flex-brand"><a href="https://flex-web.fr/" aria-label="Découvrir Flex-Web"><span aria-hidden="true">F<span class="flex-brand-dash">—</span>W</span> FLEX-WEB</a><span>Votre partenaire pour la suite</span></div>
        <div class="offer-intro"><p class="eyebrow">CETTE PAGE A ÉTÉ IMAGINÉE POUR VOUS</p><h2 id="offer-title">Votre maquette est prête.<br /><span>Choisissez la suite.</span></h2><p>{prospect.name}, partez de cette proposition : nous adaptons ensemble les textes, les couleurs et les contenus à votre activité. Choisissez votre pack pour préparer votre projet avec Flex-Web.</p></div>
        <nav class="pack-shortcuts" aria-label="Comparer les trois packs">
          {projectOffers.map((offer, index) => <a href={`#choisir-${offer.id}`}><span>Pack {offerLabels[index]}</span><strong>{euro(offer.setupCents)} <small>TTC</small></strong><span class="shortcut-purpose">{["Présenter votre activité", "Développer votre visibilité", "Simplifier votre gestion"][index]}</span></a>)}
        </nav>
        <p class="pack-choice-note">Trois forfaits en paiement unique. Les options mensuelles restent facultatives.</p>
        <div class="offer-grid">{projectOffers.map((offer, index) => <article id={`choisir-${offer.id}`} class:list={["offer-card", { "offer-featured": index === 0 }]} aria-labelledby={`pack-${offer.id}`}>
          {index === 0 && <p class="offer-badge">POUR DÉMARRER SIMPLEMENT</p>}
          <p class="offer-tier">PACK {offerLabels[index]}</p>
          <h3 id={`pack-${offer.id}`}>{offerEyebrows[index]}</h3>
          <p class="offer-price">{euro(offer.setupCents)}<span>TTC</span></p><p class="offer-frequency">Paiement unique · selon devis</p>
          <p class="offer-description">{offer.description}</p>
          <div class="offer-actions"><a class:list={["offer-button", { "offer-button-primary": index === 0 }]} href={offerHrefs[index]}>Choisir le pack {offerLabels[index]}<span aria-hidden="true">↗</span></a><p>Devis gratuit · Aucun paiement à cette étape</p></div>
          <ul>{offer.features.map(feature => <li><span aria-hidden="true">✓</span>{feature}</li>)}</ul>
        </article>)}</div>
        <p class="pricing-note">Demande de devis gratuite, sans engagement. Le périmètre, l’hébergement, le nom de domaine et les éventuels frais complémentaires sont précisés avant votre accord. Le référencement ne garantit ni classement ni citation par les moteurs.</p>
        <section class="next-steps" aria-labelledby="next-steps-title"><p class="eyebrow">UNE SUITE SIMPLE</p><h3 id="next-steps-title">De la maquette à votre projet.</h3><ol>
          <li><span class="step-number" aria-hidden="true">01</span><div><h4>Choisissez votre pack</h4><p>Un prix TTC clair, avec les options qui vous sont utiles.</p></div></li>
          <li><span class="step-number" aria-hidden="true">02</span><div><h4>Confirmez vos coordonnées</h4><p>Votre entreprise et votre maquette sont déjà renseignées.</p></div></li>
          <li><span class="step-number" aria-hidden="true">03</span><div><h4>Validez votre projet</h4><p>Le périmètre, le calendrier et le paiement sont confirmés avant commande.</p></div></li>
        </ol></section>
        <div class="monthly-options"><div><p class="eyebrow">POUR LA SUITE, SI VOUS EN AVEZ BESOIN</p><h3>Un accompagnement facultatif.</h3></div><div class="monthly-grid">{pricingOptions.map(option => <div class="monthly-option"><p><strong>{euro(option.monthlyCents)}</strong><span> TTC / mois</span></p><h4>{option.name}</h4><p>{option.description}</p></div>)}</div></div>
        <section class="pack-faq" aria-labelledby="pack-faq-title"><h3 id="pack-faq-title">Avant de choisir.</h3>
          <details><summary>Le site sera-t-il adapté à mon entreprise ?</summary><p>Oui. Cette maquette est un point de départ : les textes, les couleurs, le logo et les contenus définitifs sont validés avec vous. Le devis précise les pages et les fonctionnalités retenues.</p></details>
          <details><summary>Dois-je prendre un abonnement mensuel ?</summary><p>Non. Les packs à 299 €, 590 € et 990 € TTC sont des forfaits en paiement unique. Les accompagnements à 49 € et 99 € TTC par mois sont facultatifs et ne sont jamais ajoutés automatiquement. L’hébergement, le nom de domaine et les éventuelles licences sont précisés au devis.</p></details>
          <details><summary>Que se passe-t-il après mon choix ?</summary><p>Vous confirmez vos coordonnées et vos souhaits dans un formulaire prérempli. Flex-Web prépare votre devis et confirme les conditions avec vous. La demande est gratuite et ne vaut pas commande ; aucun paiement n’est demandé à cette étape.</p></details>
