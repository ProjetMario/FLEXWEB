---
import "../../styles/global.css";
import StructuredData from "../seo/StructuredData.astro";
import { business, organizationSchema, canonicalUrlFor } from "../../data/business";
import { languagePairFor } from "../../data/geo/site";
const { title, description = business.description, image = "/logo.png", noindex = false, lang = "fr", imageAlt = "Flex-Web — sites internet, CRM et automatisation IA" } = Astro.props;
const cleanTitle = title?.replace(/\s*[—–|]\s*flex-web\s*$/i, "");
const pageTitle = cleanTitle ? `${cleanTitle} — Flex-Web` : "Flex-Web — Automatisation IA, sites web et applications";
const canonicalUrl = canonicalUrlFor(Astro.url.pathname);
const languagePair = languagePairFor(Astro.url.pathname);
const localeName = ({fr:'fr_FR',en:'en_GB',de:'de_CH',it:'it_CH'})[lang] || 'fr_FR';
const socialAlt = ({en:'Flex-Web — websites, CRM and AI automation',de:'Flex-Web — Websites, CRM und KI-Automatisierung',it:'Flex-Web — siti web, CRM e automazione IA'})[lang] || imageAlt;
const ogImage = new URL(image, business.url).toString();
const robots = noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content="Flex-Web — Fleximmo" />
<meta name="application-name" content="Flex-Web" />
<meta name="msvalidate.01" content="0385A4D4C254F9ABD793D75D3D403229" />
<link rel="canonical" href={canonicalUrl} />
{!noindex && languagePair && <>{Object.entries(languagePair).map(([locale, path]) => <link rel="alternate" hreflang={locale} href={canonicalUrlFor(path)} />)}<link rel="alternate" hreflang="x-default" href={canonicalUrlFor(languagePair.fr)} /></>}
<meta name="robots" content={robots} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={socialAlt} />
<meta property="og:site_name" content="Flex-Web" />
<meta property="og:locale" content={localeName} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={socialAlt} />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="Présentation factuelle de Flex-Web" />
<link rel="alternate" type="text/plain" href="/llms-full.txt" title="Flex-Web — services, prices, sources and contact" />
<meta name="theme-color" content="#ffffff" />
<StructuredData schemas={[organizationSchema, { "@type": "WebSite", "@id": `${business.url}/#website`, url: `${business.url}/`, name: business.name, publisher: { "@id": `${business.url}/#organization` }, inLanguage: ["fr", "en", "de", "it"] }]} />
