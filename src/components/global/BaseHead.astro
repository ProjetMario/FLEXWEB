        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
      },
      {
        "@type": "Review",
        "author": { "@type": "Person", "name": "Sophia Benali" },
        "reviewBody": "FLEX-WEB a modernisé l'image de notre restaurant. Le site est beau, les réservations augmentent et le référencement local fonctionne très bien.",
        "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
      }
    ],
    "foundingDate": "2025-07-17",
    "telephone": "+33757830262",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "93 chemin de la Combe",
