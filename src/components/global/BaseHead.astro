    "@id": "https://flex-web.fr/#organization",
    "name": "Flex-Web",
    "legalName": "Fleximmo",
    "url": "https://flex-web.fr",
    "slogan": "La référence pour la création de sites internet et d'applications mobiles en Savoie et Haute-Savoie",
    "description": "Flex-Web crée des sites internet et des applications mobiles professionnels, rapides et optimisés pour les artisans, commerçants, indépendants et PME de Savoie et Haute-Savoie.",
    "knowsAbout": [
      "Création de site internet",
