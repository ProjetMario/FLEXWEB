---
import ResourceLayout from '../seo/national/ResourceLayout.astro';
import StructuredData from '../seo/StructuredData.astro';
import {business} from '../../data/business';
import {candidatePath,inventory} from '../../lib/seo-expansion/fr-ch.mjs';
const {audience,location,locale}=Astro.props;
const individual=audience==='particuliers', de=locale==='de';
const name=location.name, canton=location.area;
const title=de?`Webseitenerstellung für ${individual?'Privatpersonen':'Unternehmen'} in ${name} (Kanton ${canton}, Schweiz)`:`Creazione siti web per ${individual?'privati':'aziende'} a ${name} (Cantone ${canton}, Svizzera)`;
const description=de?`Websiteprojekt für ${individual?'Privatpersonen':'Unternehmen'} in ${name}, Kanton ${canton}: Inhalte, Kontakt und individuelle Offerte mit Flex-Web.`:`Progetto web per ${individual?'privati':'aziende'} a ${name}, Cantone ${canton}: contenuti, contatto e preventivo personalizzato con Flex-Web.`;
const url=business.url+candidatePath(audience,location);
const email=`mailto:${business.email}?subject=${encodeURIComponent(de?`Websiteprojekt — ${name}, Schweiz`:`Progetto sito web — ${name}, Svizzera`)}`;
const sourceDate=inventory().sourceDate;
const date=new Intl.DateTimeFormat(de?'de-CH':'it-CH',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(sourceDate+'T12:00:00Z'));
const faq=de?[
 {question:`Wie plane ich ein Websiteprojekt in ${name}?`,answer:individual?'Beschreiben Sie das persönliche Vorhaben, die Zielgruppe und die Inhalte, die Sie veröffentlichen dürfen. Schreiben Sie Flex-Web, um Umfang, Sprache und Bedingungen zu klären.':'Beschreiben Sie Ihre Tätigkeit, Ihre Zielgruppe, die Leistungen und die Angaben, die Sie für eine Anfrage benötigen. Der Umfang wird in der Offerte festgelegt.'},
 {question:'Was kostet die Website und wie lange dauert sie?',answer:'Preis, mögliche Kosten für Domain, Hosting oder Dienste Dritter sowie der Zeitplan werden für das konkrete Projekt in einer Offerte bestätigt. Eine Platzierung in Suchmaschinen wird nicht garantiert.'},
 {question:'Hat Flex-Web eine Niederlassung in dieser Gemeinde?',answer:'Flex-Web ist eine Marke von Fleximmo mit Sitz in Voglans, Savoyen, Frankreich. Diese Seite behauptet keine Niederlassung und keine Kunden in dieser Gemeinde.'},
 {question:'Welche Bedingungen gelten für ein Projekt in der Schweiz?',answer:'Arbeitssprache, Währung, Steuern, mögliche grenzüberschreitende Kosten und die Zusammenarbeit aus der Ferne werden vor einer Beauftragung schriftlich geklärt.'},
]:[
 {question:`Come preparo un progetto web a ${name}?`,answer:individual?'Descriva il progetto personale, il pubblico e i contenuti che può pubblicare. Scriva a Flex-Web per verificare ambito, lingua e condizioni.':'Descriva attività, pubblico, servizi e informazioni necessarie per rispondere a una richiesta. Il preventivo definisce l’ambito del progetto.'},
 {question:'Quanto costa il sito e quanto tempo richiede?',answer:'Prezzo, eventuali costi di dominio, hosting o servizi terzi e tempi sono confermati nel preventivo relativo al progetto. Non è garantita una posizione nei motori di ricerca.'},
 {question:'Flex-Web ha una sede in questo comune?',answer:'Flex-Web è un marchio di Fleximmo con sede a Voglans, Savoia, Francia. Questa pagina non dichiara una sede né clienti in questo comune.'},
 {question:'Quali condizioni valgono per un progetto in Svizzera?',answer:'Lingua di lavoro, valuta, imposte, eventuali costi transfrontalieri e collaborazione a distanza vengono chiariti per iscritto prima dell’incarico.'},
];
const schemas=[{'@type':'WebPage','@id':url,url,name:title,description,inLanguage:locale,isPartOf:{'@id':`${business.url}/#website`},about:{'@id':`${business.url}/#organization`}},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:de?'Startseite':'Home',item:business.url+'/'},{'@type':'ListItem',position:2,name:title,item:url}]},{'@type':'FAQPage','@id':url+'#questions',mainEntity:faq.map(x=>({'@type':'Question',name:x.question,acceptedAnswer:{'@type':'Answer',text:x.answer}}))}];
---
<ResourceLayout title={title} description={description} noindex={true} lang={locale} quoteHref={email}>
 <Fragment slot="head"><StructuredData schemas={schemas} /><meta name="flexweb-territory" content={`${audience}:${location.country}:${location.code}`} /></Fragment>
 <nav aria-label={de?'Brotkrumennavigation':'Percorso di navigazione'}><a href="/" hreflang="fr">{de?'Startseite (Französisch)':'Home (francese)'}</a><a href="/projets-sites/" hreflang="fr">{de?'Gemeindeverzeichnis (Französisch)':'Elenco comuni (francese)'}</a></nav>
 <article>
 <header><p class="eyebrow">{de?'Websiteprojekt · Schweiz':'Progetto web · Svizzera'} · {de?(individual?'Privatperson':'Unternehmen'):(individual?'Privato':'Azienda')}</p><h1>{title}</h1>
 <p class="lead">{de?(individual?`Planen Sie eine persönliche Website in ${name}? Klären Sie zuerst Zielgruppe, veröffentlichbare Inhalte und gewünschte Kontaktmöglichkeiten.`:`Soll Ihre Website Leistungen Ihres Unternehmens in ${name} vorstellen und Anfragen erleichtern? Legen Sie Zielgruppe, Inhalte und Kontaktweg fest.`):(individual?`Desidera un sito personale a ${name}? Definisca il pubblico, i contenuti pubblicabili e il modo in cui desidera essere contattato.`:`Il sito della sua azienda a ${name} deve presentare servizi e raccogliere richieste? Definisca pubblico, contenuti e modalità di contatto.`)} {de?'Flex-Web prüft Ihr Anliegen von Voglans in Frankreich aus. Umfang und Bedingungen werden vor einer Vereinbarung geklärt.':'Flex-Web esamina la richiesta da Voglans, in Francia. Ambito e condizioni vengono chiariti prima di un accordo.'}</p>
 <p class="meta">{de?'Amtlicher Gemeindestand':'Stato ufficiale dei comuni'} · <time datetime={sourceDate}>{date}</time></p><a class="action" href={email} data-conversion-event="quote_click" data-conversion-service="site">{de?'Projekt per E-Mail besprechen':'Discutere il progetto via e-mail'} →</a>
 <p>{de?'Arbeitssprache, Währung, Steuern und allfällige grenzüberschreitende Kosten sind zu bestätigen. Eine lokale Niederlassung wird nicht behauptet.':'Lingua di lavoro, valuta, imposte ed eventuali costi transfrontalieri sono da confermare. Non viene dichiarata una sede locale.'}</p></header>
 <section class="note"><h2>{de?'Gemeinde eindeutig zuordnen':'Identificare correttamente il comune'}</h2><ul><li>{de?'Gemeinde':'Comune'} : {name}</li><li>{de?'Kanton':'Cantone'} : {canton}</li>{location.district&&<li>{de?'Bezirk laut Quelle':'Distretto secondo la fonte'} : {location.district}</li>}<li>{de?'BFS-Nummer':'Numero UST'} : {location.code}</li><li>{de?'Sprachregion laut Quelle':'Regione linguistica secondo la fonte'} : {de?'Deutsch':'Italiano'}</li></ul><p>{de?'Diese Verwaltungsdaten belegen weder einen lokalen Standort noch Kunden oder eine automatische Abdeckung von Nachbarorten.':'Questi dati amministrativi non dimostrano una sede locale, clienti o una copertura automatica dei comuni vicini.'}</p><a href={de?"https://www.agvchapp.bfs.admin.ch/de":"https://www.agvchapp.bfs.admin.ch/it"}>{de?'Amtliches Gemeindeverzeichnis BFS':'Elenco ufficiale UST dei comuni'}</a></section>
 <section><h2>{de?'Welche Inhalte und Funktionen sind sinnvoll?':'Quali contenuti e funzioni preparare?'}</h2><p>{de?(individual?'Eine Projektvorstellung, die Informationen, die Sie teilen möchten, und ein Kontaktweg können einen Anfang bilden. Entscheiden Sie bewusst, welche persönlichen Daten öffentlich sein sollen.':'Eine Leistungsübersicht, Kontaktdaten und ein klarer Anfrageweg können den Einstieg bilden. Nennen Sie nur Orte, an denen Ihr Unternehmen tatsächlich tätig ist.'):(individual?'Una presentazione del progetto, le informazioni da condividere e un contatto possono costituire un primo insieme. Scelga con attenzione quali dati personali rendere pubblici.':'Una presentazione dei servizi, i contatti e un percorso di richiesta chiaro possono costituire una base. Indichi solo le località effettivamente servite dalla sua azienda.')}</p><ul>{(de?['Zielgruppe, Seiten und benötigte Funktionen festlegen.','Nur Texte und Bilder verwenden, die veröffentlicht werden dürfen.','Zuständigkeit für Inhalte, Zugriffe und spätere Änderungen klären.']:['Definire pubblico, pagine e funzioni necessarie.','Usare solo testi e immagini che possono essere pubblicati.','Chiarire responsabilità per contenuti, accessi e modifiche.']).map(x=><li>{x}</li>)}</ul></section>
 <section><h2>{de?'Was muss die Offerte festhalten?':'Cosa deve precisare il preventivo?'}</h2><p>{de?'Umfang, Inhalte, Funktionen, Domain, Hosting, zusätzliche Lizenzen, Verantwortlichkeiten und Betreuung werden für das konkrete Projekt vereinbart. Der Zeitplan hängt vom Umfang und den bereitgestellten Unterlagen ab.':'Pagine, contenuti, funzioni, dominio, hosting, eventuali licenze, responsabilità e assistenza sono concordati per il progetto. I tempi dipendono dall’ambito e dai materiali disponibili.'}</p><p>{de?'Währung, Steuern, Sprache und Kosten eines Projekts in der Schweiz sind vor der Bestellung schriftlich zu klären.':'Valuta, imposte, lingua e costi di un progetto in Svizzera devono essere chiariti per iscritto prima dell’ordine.'}</p></section>
 <section><h2>{de?'Was vor der Veröffentlichung prüfen?':'Cosa verificare prima della pubblicazione?'}</h2><ol>{(de?['Inhalte, Kontaktdaten und Veröffentlichungsrechte prüfen.','Links, Mobilansicht und Kontaktweg mit Testdaten prüfen.','Domain, Hostingzugang, Kosten und Verantwortlichkeiten festhalten.','Bei einem Relaunch bisherige Adressen und nötige Weiterleitungen prüfen.']:['Verificare contenuti, contatti e diritti di pubblicazione.','Testare link, visualizzazione mobile e contatto con dati di prova.','Definire dominio, accessi all’hosting, costi e responsabilità.','In caso di rifacimento, controllare URL esistenti e reindirizzamenti.']).map(x=><li>{x}</li>)}</ol><p>{de?'Die Datenschutzinformation muss zu den tatsächlich verwendeten Daten und Diensten passen. Informieren Sie sich beim Eidgenössischen Datenschutzbeauftragten; welche Regeln gelten, hängt vom Projekt ab.':'L’informativa sulla protezione dei dati deve corrispondere ai trattamenti e servizi effettivi. Consultare il Preposto federale; le regole applicabili dipendono dal progetto.'} <a href={de?"https://www.edoeb.admin.ch/de/datenschutzerklaerungen-im-internet":"https://www.edoeb.admin.ch/it/dichiarazioni-relative-alla-protezione-dei-dati-in-internet"}>{de?'Amtliche Information':'Informazioni ufficiali'}</a>.</p></section>
 <section id="questions"><h2>{de?'Häufige Fragen':'Domande frequenti'}</h2>{faq.map(x=><details><summary>{x.question}</summary><p>{x.answer}</p></details>)}</section>
 <section class="note"><h2>{de?'Ihr Projekt besprechen':'Parliamo del progetto'}</h2><p>{de?'Nennen Sie Ziel, Ort und benötigte Funktionen. Verwenden Sie zunächst anonymisierte Beispiele und senden Sie keine Passwörter.':'Indichi obiettivo, località e funzioni richieste. Usi inizialmente esempi anonimizzati e non invii password.'}</p><a class="action" href={email} data-conversion-event="quote_click" data-conversion-service="site">{de?'Flex-Web per E-Mail kontaktieren':'Contattare Flex-Web via e-mail'} →</a><p>{de?'Oder schreiben Sie an':'Oppure scriva a'} <a href={`mailto:${business.email}`}>{business.email}</a>.</p></section>
 <nav aria-label={de?'Weitere Informationen':'Altre informazioni'}><a href="/creation-site-internet/" hreflang="fr">{de?'Websiteangebot (Französisch)':'Servizi web (francese)'}</a><a href="/realisations/" hreflang="fr">{de?'Dokumentierte Referenzen (Französisch)':'Progetti documentati (francese)'}</a><a href={candidatePath(individual?'entreprises':'particuliers',location)}>{de?(individual?'Für Unternehmen in dieser Gemeinde':'Für Privatpersonen in dieser Gemeinde'):(individual?'Per aziende in questo comune':'Per privati in questo comune')}</a></nav>
 </article>
</ResourceLayout>
<style>
.resource section{margin:42px 0}.resource ol{list-style:decimal;padding-left:22px}.resource li{margin:8px 0}.resource details{border-top:1px solid #dedee5;padding:18px 0}.resource summary{font-weight:600;cursor:pointer;line-height:1.5}
</style>
