---
import {pages, hubs, languages} from '../../data/applications/content.mjs';
const {lang='fr'}=Astro.props;
const title={fr:'Applications par plateforme et par besoin',en:'Applications by platform and need',de:'Anwendungen nach Plattform und Bedarf',it:'Applicazioni per piattaforma ed esigenza'}[lang];
const language={fr:'Langues',en:'Languages',de:'Sprachen',it:'Lingue'}[lang];
const names={fr:'Français',en:'English',de:'Deutsch',it:'Italiano'};
---
<section class="application-links" aria-label={title}>
 <h2>{title}</h2>
 <nav aria-label={language}>{languages.map(locale=><a href={hubs[locale]} lang={locale} hreflang={locale} aria-current={locale===lang?'page':undefined}>{names[locale]}</a>)}</nav>
 <ul>{pages.filter(page=>page.lang===lang).map(page=><li><a href={page.path}>{page.title}</a></li>)}</ul>
</section>
<style>.application-links{margin:3rem 0}.application-links h2{font-size:1.5rem;font-weight:600}.application-links nav{display:flex;gap:1rem;flex-wrap:wrap;margin:1rem 0}.application-links ul{list-style:disc;padding-left:1.5rem;line-height:2}.application-links a{color:#0066cc;text-decoration:underline}.application-links a[aria-current=page]{font-weight:700}</style>
