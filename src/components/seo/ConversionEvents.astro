<script>
import { trackConversionEvent } from "../../lib/analytics";
const trackedForms = new WeakSet();
document.addEventListener("click", (event) => {
  const target = event.target instanceof Element ? event.target.closest("[data-conversion-event]") : null;
  if (!target) return;
  const name = target.getAttribute("data-conversion-event");
  if (!["quote_click", "crm_link_open", "appointment_click"].includes(name || "")) return;
  trackConversionEvent(name, target.getAttribute("data-conversion-service") || "unknown");
});
document.addEventListener("input", (event) => {
  const form = event.target instanceof Element ? event.target.closest("form") : null;
  if (!form || trackedForms.has(form)) return;
  if (!location.pathname.startsWith("/demarrer/")) return;
  trackedForms.add(form);
  trackConversionEvent("form_start", "project_quote");
}, { passive: true });
</script>
