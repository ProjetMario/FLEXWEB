---
import BaseLayout from '../../../layout/BaseLayout.astro';
const {title,description,noindex=false}=Astro.props;
---
<BaseLayout title={title} description={description} noindex={noindex}>
 <div class="resource"><slot /></div>
</BaseLayout>
<style is:global>
.resource{max-width:1120px;margin:auto;padding:150px 24px 72px;color:#1d1d1f;overflow-wrap:anywhere}
.resource .eyebrow{font-size:.8rem;font-weight:650;letter-spacing:.1em;text-transform:uppercase;color:#0066cc}
.resource h1{font-size:clamp(2rem,5vw,4rem);line-height:1.1;letter-spacing:-.045em;max-width:940px;margin:22px 0}
.resource h2{font-size:clamp(1.4rem,3vw,2rem);letter-spacing:-.025em;line-height:1.25;margin:0 0 18px}
.resource h3{font-size:1.2rem;line-height:1.3;margin:0 0 12px}
.resource p,.resource li{line-height:1.8;font-size:1.06rem}.resource p{margin:12px 0 20px}
.resource .lead{font-size:1.25rem;line-height:1.65;color:#50505a;max-width:850px}
.resource a{color:#0066cc;text-underline-offset:4px}.resource a:hover{text-decoration:underline}.resource a:focus-visible{outline:3px solid #0066cc;outline-offset:5px;border-radius:4px}
.resource nav{display:flex;gap:10px 20px;flex-wrap:wrap;margin:0 0 24px}.resource nav[aria-label="Fil d’Ariane"]{font-size:.9rem}
.resource .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin:32px 0}
.resource .card{padding:28px;border:1px solid #dedee5;border-radius:24px;background:#fff}
.resource .card p{color:#50505a}.resource .article-body{max-width:780px}.resource .article-body section{margin:40px 0}
.resource .note{padding:24px;background:#f5f5f7;border-radius:20px;margin:30px 0}
.resource .action{display:inline-block;background:#0071e3;color:#fff;padding:14px 24px;border-radius:999px;font-weight:600;margin:8px 12px 8px 0}
.resource .meta{font-size:.88rem;color:#666}.resource ul{padding-left:22px;list-style:disc}.resource .price{font-size:1.5rem;font-weight:650}
.resource .journey{border-left:3px solid #0071e3;padding-left:24px;margin:32px 0}
@media(max-width:600px){.resource{padding:120px 20px 48px}.resource .grid{grid-template-columns:1fr}.resource .card{padding:22px}.resource .action{width:100%;text-align:center;margin-right:0}}
</style>
