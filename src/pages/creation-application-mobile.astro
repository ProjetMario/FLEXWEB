---
import BaseLayout from "../layout/BaseLayout.astro";
import StructuredData from "../components/seo/StructuredData.astro";
import { getEntry, render } from "astro:content";

const serviceFaq = [
  {
    "question": "Quel est le prix d'une application web ou mobile ?",
    "answer": "Chaque application est sur devis. Le prix dépend des parcours, des rôles, des intégrations et des données à reprendre. Le devis distingue le premier développement, l'hébergement, les services tiers, la maintenance et les évolutions."
  },
  {
    "question": "Faut-il publier l'application sur les stores ?",
    "answer": "Cela dépend de l'usage. Une application web accessible par navigateur suffit pour de nombreux outils internes et portails clients. Une application mobile est étudiée lorsqu'elle répond à un besoin précis. Les modalités de publication sont convenues au devis."
  },
  {
    "question": "Pouvez-vous travailler avec une entreprise partout en France ?",
    "answer": "Oui. FLEX-WEB accompagne les projets en Savoie, en Haute-Savoie et dans toute la France. Les ateliers, les démonstrations et les validations peuvent être organisés à distance."
  },
  {
    "question": "Une automatisation peut-elle remplacer une application ?",
    "answer": "Si le besoin consiste à transmettre ou traiter des informations entre vos outils, une automatisation peut suffire. Une application est pertinente lorsqu'il faut créer un nouveau parcours ou un espace dédié aux utilisateurs. Cette distinction est examinée au cadrage."
  }
];

const entry = await getEntry("services", "creation-application-mobile");

if (!entry) {
  throw new Error("Service creation-application-mobile not found");
}

const { Content } = await render(entry);
const { data } = entry;

const siteUrl = "https://flex-web.fr";
const canonicalUrl = `${siteUrl}/creation-application-mobile/`;

const webPageSchema = {
  "@type": "WebPage",
  "@id": canonicalUrl,
  url: canonicalUrl,
  name: data.seoTitle,
  description: data.seoDescription,
  isPartOf: { "@id": `${siteUrl}/#website` },
};

const serviceSchema = {
  "@type": "Service",
  "@id": `${canonicalUrl}#service`,
  name: data.title,
  url: canonicalUrl,
  description: data.description,
  provider: { "@id": `${siteUrl}/#organization` },
  serviceType: "Développement d'application mobile et web",
  areaServed: [
    { "@type": "AdministrativeArea", name: "Savoie" },
    { "@type": "AdministrativeArea", name: "Haute-Savoie" },
    { "@type": "Country", name: "France" },
  ],
  audience: {
    "@type": "Audience",
    audienceType: data.targetAudience.join(", "),
  },
  offers: {
    "@type": "Offer",
    name: "Application mobile ou web sur mesure",
    description: "Développement sur devis selon la complexité du projet.",
    url: `${siteUrl}/pricing/`,
    priceCurrency: "EUR",
    availability: "https://schema.org/InStock",
  },
};

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: data.title, item: canonicalUrl },
  ],
};

const faqSchema = {
  "@type": "FAQPage",
  "@id": `${canonicalUrl}#faq`,
  mainEntity: serviceFaq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};

const schemas = [webPageSchema, serviceSchema, breadcrumbSchema, faqSchema];
---

<BaseLayout title={data.seoTitle} description={data.seoDescription} keywords="création application mobile, application web sur mesure, application iOS, application Android, développement app Savoie, app Haute-Savoie, devis application mobile gratuit">
  <div class="mx-auto max-w-3xl px-6 py-16 lg:py-24">
    <nav aria-label="Fil d'Ariane" class="mb-8 text-sm" style="color: var(--color-text-muted)">
      <a href="/" class="hover:underline">Accueil</a>
      <span class="mx-2">/</span>
      <span>{data.title}</span>
    </nav>

    <h1 class="text-4xl font-semibold tracking-tight lg:text-5xl" style="color: var(--color-text)">
      {data.title}
    </h1>

    <p class="mt-6 text-lg leading-relaxed" style="color: var(--color-text-muted)">
      {data.description}
    </p>

    <section class="mt-8 rounded-2xl p-6" style="background-color: var(--color-surface)">
      <h2 class="text-xl font-semibold tracking-tight" style="color: var(--color-text)">
        En bref
      </h2>
      <p class="mt-3 leading-relaxed" style="color: var(--color-text-muted)">
        FLEX-WEB développe des applications métier, des portails clients et des SaaS pour les entreprises en France, avec un accompagnement en Savoie et Haute-Savoie. Le devis précise le premier périmètre, les intégrations, le déploiement et les modalités de suivi.
      </p>
    </section>

    <div class="mt-12 space-y-6 text-lg leading-relaxed" style="color: var(--color-text)">
      <Content />
    </div>

    <section class="mt-16 rounded-2xl p-6" style="background-color: var(--color-surface)">
      <h2 class="text-xl font-semibold tracking-tight" style="color: var(--color-text)">
        Vous cherchez plutôt un site internet ?
      </h2>
      <p class="mt-3 leading-relaxed" style="color: var(--color-text-muted)">
        FLEX-WEB conçoit aussi des <a href="/creation-site-internet/" class="underline hover:opacity-80" style="color: var(--color-accent)">sites internet professionnels</a> pour les entreprises de <a href="/creation-site-internet-savoie/" class="underline hover:opacity-80" style="color: var(--color-accent)">Savoie</a> et <a href="/creation-site-internet-haute-savoie/" class="underline hover:opacity-80" style="color: var(--color-accent)">Haute-Savoie</a>.
      </p>
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
        Pour qui ?
      </h2>
      <ul class="mt-4 list-disc space-y-2 pl-6" style="color: var(--color-text)">
        {data.targetAudience.map((item: string) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
        Nos engagements
      </h2>
      <ul class="mt-4 list-disc space-y-2 pl-6" style="color: var(--color-text)">
        {data.benefits.map((item: string) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
        Zones desservies
      </h2>
      <div class="mt-4 flex flex-wrap gap-3">
        {data.relatedLocations.map((slug: string) => (
          <a
            href={`/${slug}/`}
            class="rounded-full px-4 py-2 text-sm font-medium transition hover:opacity-90"
            style="background-color: var(--color-surface); color: var(--color-text)"
          >
            {slug.replace("creation-site-internet-", "").replace("creation-application-mobile-", "").replace(/-/g, " ")}
          </a>
        ))}
      </div>
    </section>

    <section class="mt-16 rounded-2xl border p-6" style="border-color: var(--color-border)">
      <h2 class="text-2xl font-semibold tracking-tight">Automatiser les tâches autour de votre projet</h2>
      <p class="mt-4 leading-relaxed">Découvrez le <a href="/automatisation-ia/" class="underline">cadrage d'une automatisation IA</a>, avec des parcours dédiés à la <a href="/automatisation-ia-savoie/" class="underline">Savoie</a> et à la <a href="/automatisation-ia-haute-savoie/" class="underline">Haute-Savoie</a>. Les demandes, les documents et le CRM peuvent être reliés selon vos outils et le périmètre du devis.</p>
    </section>

    <section id="faq" class="mt-16">
      <h2 class="text-2xl font-semibold tracking-tight">Questions fréquentes</h2>
      <div class="mt-6 space-y-4">
        {serviceFaq.map((item) => (
          <details class="rounded-2xl border p-5" style="border-color: var(--color-border)">
            <summary class="cursor-pointer font-medium">{item.question}</summary>
            <p class="mt-4 leading-relaxed" style="color: var(--color-text-muted)">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <aside id="contact" class="mt-16 rounded-3xl p-8 text-center" style="background-color: var(--color-surface)">
      <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
        Un projet d'application mobile ou web ?
      </h2>
      <p class="mt-4" style="color: var(--color-text-muted)">
        Discutons de votre projet et obtenez un devis gratuit.
      </p>
      <a
        href="/demarrer/?service=application"
        class="mt-6 inline-flex items-center justify-center rounded-full px-8 py-3 text-base font-medium text-white transition hover:opacity-90"
        style="background-color: var(--color-accent)"
      >
        Demander un devis
      </a>
    </aside>
  </div>

  <StructuredData schemas={schemas} slot="head" />
</BaseLayout>
