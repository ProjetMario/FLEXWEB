---
import ApplicationLinks from "../components/applications/ApplicationLinks.astro";
import ProjectEvidence from "../components/seo/ProjectEvidence.astro";
import BaseLayout from "../layout/BaseLayout.astro";
import StructuredData from "../components/seo/StructuredData.astro";
import { getEntry, render } from "astro:content";

const serviceFaq = [
  { question: "Comment préparer un devis d’application sur mesure ?", answer: "Décrivez les utilisateurs, le problème à résoudre, les écrans essentiels, les données et les outils à connecter. Le devis définit le premier lot, les droits d’accès, les tests, le calendrier et les coûts de fonctionnement." },
  { question: "Quel délai prévoir pour créer une application ?", answer: "Le délai dépend du périmètre, des intégrations, des données disponibles et des tests à réaliser. Il est défini dans le devis après cadrage, avant commande." },
  { question: "Qui possède les comptes et les données du projet ?", answer: "Les responsabilités, accès aux comptes, modalités de remise, hébergement et conservation des données sont précisés au devis. Les comptes de publication sur les stores et les frais associés sont également définis si une publication est retenue." },
  {
    "question": "Quel est le prix d'une application web ou mobile ?",
    "answer": "Chaque application est sur devis. Le prix dépend des parcours, des rôles, des intégrations et des données à reprendre. Le devis distingue le premier développement, l'hébergement, les services tiers, la maintenance et les évolutions."
  },
  {
    "question": "Faut-il publier l'application sur les stores ?",
    "answer": "Cela dépend de l'usage. Une application web accessible par navigateur suffit pour de nombreux outils internes et portails clients. Une application mobile est étudiée lorsqu'elle répond à un besoin précis. Les modalités de publication sont convenues au devis."
  },
  {
    "question": "Pouvez-vous travailler avec une entreprise partout en France ?",
    "answer": "Oui. FLEX-WEB accompagne les projets en Savoie, en Haute-Savoie et dans toute la France. Les ateliers, les démonstrations et les validations peuvent être organisés à distance."
  },
  {
    "question": "Une automatisation peut-elle remplacer une application ?",
    "answer": "Si le besoin consiste à transmettre ou traiter des informations entre vos outils, une automatisation peut suffire. Une application est pertinente lorsqu'il faut créer un nouveau parcours ou un espace dédié aux utilisateurs. Cette distinction est examinée au cadrage."
  }
];

const useCases = [
  {
    title: "Espace client",
    text: "Suivi de demandes, documents, historique et messages accessibles depuis un navigateur.",
  },
  {
    title: "Outil interne",
    text: "Tableau de bord pour traiter les dossiers, affecter les actions et garder une trace des décisions.",
  },
  {
    title: "SaaS métier",
    text: "Parcours récurrent pour plusieurs utilisateurs, avec rôles, abonnements éventuels et évolutions prévues.",
  },
];

const quoteItems = [
  "Les utilisateurs, leurs rôles et les actions autorisées.",
  "Les écrans du premier lot et les fonctions hors périmètre.",
  "Les données à créer, importer, conserver ou supprimer.",
  "Les connexions utiles : site, CRM, paiement, messagerie ou outils métier.",
  "Le mode de déploiement : application web, mobile ou publication sur store si elle est justifiée.",
];

const comparisonRows = [
  ["Besoin principal", "Un espace dédié avec vos règles métier.", "Quelques actions répétitives entre outils existants."],
  ["Utilisateurs", "Clients, équipe, partenaires ou plusieurs rôles.", "Équipe interne travaillant déjà dans ses logiciels."],
  ["Prix", "Sur devis selon le premier lot.", "990 € TTC pour le CRM et les automatisations prévues au devis, ou sur mesure selon le besoin."],
  ["IA", "Assistant interne, résumé ou aide à la décision si les données le permettent.", "Classement, résumé, brouillon ou relance à valider."],
];

const entry = await getEntry("services", "creation-application-mobile");

if (!entry) {
  throw new Error("Service creation-application-mobile not found");
}

const { Content } = await render(entry);
const { data } = entry;

const siteUrl = "https://flex-web.fr";
const canonicalUrl = `${siteUrl}/creation-application-mobile/`;

const webPageSchema = {
  "@type": "WebPage",
  "@id": canonicalUrl,
  url: canonicalUrl,
  name: data.seoTitle,
  description: data.seoDescription,
  isPartOf: { "@id": `${siteUrl}/#website` },
};

const serviceSchema = {
  "@type": "Service",
  "@id": `${canonicalUrl}#service`,
  name: data.title,
  url: canonicalUrl,
  description: data.description,
  provider: { "@id": `${siteUrl}/#organization` },
  serviceType: "Développement d'application mobile et web",
  areaServed: [
    { "@type": "AdministrativeArea", name: "Savoie" },
    { "@type": "AdministrativeArea", name: "Haute-Savoie" },
    { "@type": "Country", name: "France" },
    { "@type": "Country", name: "Switzerland" },
  ],
  audience: {
    "@type": "Audience",
    audienceType: data.targetAudience.join(", "),
  },
  offers: {
    "@type": "Offer",
    name: "Application mobile ou web sur mesure",
    description: "Développement sur devis selon la complexité du projet.",
    url: `${siteUrl}/pricing/`,
    priceCurrency: "EUR",
    availability: "https://schema.org/InStock",
  },
};

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: data.title, item: canonicalUrl },
  ],
};

const faqSchema = {
  "@type": "FAQPage",
  "@id": `${canonicalUrl}#faq`,
  mainEntity: serviceFaq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};

const schemas = [webPageSchema, serviceSchema, breadcrumbSchema, faqSchema];
---

<BaseLayout title={data.seoTitle} description={data.seoDescription} keywords="création application mobile, application web sur mesure, application iOS, application Android, développement app Savoie, app Haute-Savoie, devis application mobile gratuit">
  <div class="mx-auto max-w-3xl px-6 py-16 lg:py-24">
    <nav aria-label="Fil d'Ariane" class="mb-8 text-sm" style="color: var(--color-text-muted)">
      <a href="/" class="hover:underline">Accueil</a>
      <span class="mx-2">/</span>
      <span>{data.title}</span>
    </nav>

    <h1 class="text-4xl font-semibold tracking-tight lg:text-5xl" style="color: var(--color-text)">
      {data.title}
    </h1>

    <p class="mt-6 text-lg leading-relaxed" style="color: var(--color-text-muted)">
      {data.description}
    </p>

    <section class="mt-8 rounded-2xl p-6" style="background-color: var(--color-surface)">
      <h2 class="text-xl font-semibold tracking-tight" style="color: var(--color-text)">
        En bref
      </h2>
      <p class="mt-3 leading-relaxed" style="color: var(--color-text-muted)">
        FLEX-WEB développe des applications web, iOS, Android, Windows et macOS pour les entreprises et particuliers en France et en Suisse. Depuis Voglans en Savoie, nous accompagnons les projets en français ou en anglais. Le devis précise le périmètre, les intégrations, le déploiement et le suivi.
      </p>
    </section>

    <section class="mt-12" aria-labelledby="app-needs-title">
      <h2 id="app-needs-title" class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
        Trois besoins fréquents
      </h2>
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        {useCases.map((item) => (
          <article class="rounded-2xl border p-5" style="border-color: var(--color-border)">
            <h3 class="font-semibold">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed" style="color: var(--color-text-muted)">{item.text}</p>
          </article>
        ))}
      </div>
      <p class="mt-5 leading-relaxed" style="color: var(--color-text-muted)">
        Une application devient utile lorsque le site internet ou le CRM ne suffisent plus : plusieurs profils doivent agir, les dossiers doivent garder un historique, ou votre équipe a besoin d’un parcours métier stable.
      </p>
    </section>

    <section class="mt-12 rounded-2xl border p-6" style="border-color: var(--color-border)">
      <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
        Application ou automatisation IA ?
      </h2>
      <div class="mt-5 overflow-x-auto">
        <table class="w-full border-collapse text-left text-sm">
          <thead>
            <tr>
              <th class="border p-3" style="border-color: var(--color-border); background-color: var(--color-surface)">Critère</th>
              <th class="border p-3" style="border-color: var(--color-border); background-color: var(--color-surface)">Application</th>
              <th class="border p-3" style="border-color: var(--color-border); background-color: var(--color-surface)">Automatisation</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr>
                <th scope="row" class="border p-3 font-semibold" style="border-color: var(--color-border)">{row[0]}</th>
                <td class="border p-3" style="border-color: var(--color-border); color: var(--color-text-muted)">{row[1]}</td>
                <td class="border p-3" style="border-color: var(--color-border); color: var(--color-text-muted)">{row[2]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-12 rounded-2xl p-6" style="background-color: var(--color-surface)">
      <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
        Ce que le devis d’application doit figer
      </h2>
      <ul class="mt-5 list-disc space-y-2 pl-6" style="color: var(--color-text)">
        {quoteItems.map((item) => <li>{item}</li>)}
      </ul>
      <p class="mt-5 text-sm leading-relaxed" style="color: var(--color-text-muted)">
        Le paiement intervient après validation du devis. Les coûts d’hébergement, de services tiers, d’assistance et d’évolutions sont distingués du premier développement.
      </p>
    </section>

    <div class="mt-12 space-y-6 text-lg leading-relaxed" style="color: var(--color-text)">
      <Content />
    </div>

    <section class="mt-16 rounded-2xl p-6" style="background-color: var(--color-surface)">
      <h2 class="text-xl font-semibold tracking-tight" style="color: var(--color-text)">
        Vous cherchez plutôt un site internet ?
      </h2>
      <p class="mt-3 leading-relaxed" style="color: var(--color-text-muted)">
        FLEX-WEB conçoit aussi des <a href="/creation-site-internet/" class="underline hover:opacity-80" style="color: var(--color-accent)">sites internet professionnels</a> pour les entreprises de <a href="/creation-site-internet-savoie/" class="underline hover:opacity-80" style="color: var(--color-accent)">Savoie</a> et <a href="/creation-site-internet-haute-savoie/" class="underline hover:opacity-80" style="color: var(--color-accent)">Haute-Savoie</a>.
      </p>
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
        Pour qui ?
      </h2>
      <ul class="mt-4 list-disc space-y-2 pl-6" style="color: var(--color-text)">
        {data.targetAudience.map((item: string) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
        Nos engagements
      </h2>
      <ul class="mt-4 list-disc space-y-2 pl-6" style="color: var(--color-text)">
        {data.benefits.map((item: string) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
        Zones desservies
      </h2>
      <div class="mt-4 flex flex-wrap gap-3">
        {data.relatedLocations.map((slug: string) => (
          <a
            href={`/${slug}/`}
            class="rounded-full px-4 py-2 text-sm font-medium transition hover:opacity-90"
            style="background-color: var(--color-surface); color: var(--color-text)"
          >
            {slug.replace("creation-site-internet-", "").replace("creation-application-mobile-", "").replace(/-/g, " ")}
          </a>
        ))}
      </div>
    </section>

    <section class="mt-16 rounded-2xl border p-6" style="border-color: var(--color-border)">
      <h2 class="text-2xl font-semibold tracking-tight">Automatiser les tâches autour de votre projet</h2>
      <p class="mt-4 leading-relaxed">Découvrez le <a href="/automatisation-ia/" class="underline">cadrage d'une automatisation IA</a>, avec des parcours dédiés à la <a href="/automatisation-ia-savoie/" class="underline">Savoie</a> et à la <a href="/automatisation-ia-haute-savoie/" class="underline">Haute-Savoie</a>. Les demandes, les documents et le CRM peuvent être reliés selon vos outils et le périmètre du devis.</p>
      <p class="mt-4 leading-relaxed">Avant de décider, vous pouvez comparer avec la <a href="/outils/demo-crm/" class="underline">démonstration CRM</a> et le guide <a href="/journal/automatisation-ou-application-sur-mesure/" class="underline">automatisation ou application sur mesure</a>.</p>
    </section>

    <section class="mt-16 rounded-2xl border p-6" style="border-color: var(--color-border)">
      <h2 class="text-2xl font-semibold tracking-tight">Comment cadrer une première version utile ?</h2>
      <p class="mt-4 leading-relaxed">Choisissez un parcours précis : par exemple, un client transmet une demande, un membre de votre équipe la traite et chacun voit uniquement les informations autorisées. Définissez les profils, les écrans, les données nécessaires et ce qui restera pour une version ultérieure. Cet exemple illustre un besoin possible, sans présenter de résultat client.</p>
      <p class="mt-4 leading-relaxed">Le devis distingue la conception du premier lot, les connexions, l’hébergement, les licences, les éventuels frais des stores, la maintenance et les évolutions. Les tests couvrent notamment les droits d’accès, les données manquantes et les erreurs de connexion. La publication sur iOS ou Android dépend du projet, des comptes et des règles des stores ; elle n’est pas automatique.</p>
      <p class="mt-4 leading-relaxed">Flex-Web, marque de Fleximmo à Voglans, intervient en Savoie et à distance en France. Votre entreprise désigne les personnes chargées des règles métier et de la validation. Consultez le <a href="/guides/preparer-projet-application-mobile/" class="underline">guide pour préparer votre application</a>, la <a href="/realisations/foot-nation/" class="underline">présentation des fonctionnalités publiques de Foot Nation</a> et le guide <a href="/journal/automatisation-ou-application-sur-mesure/" class="underline">application ou automatisation</a>.</p>
      <p class="mt-4 text-sm">Informations mises à jour le <time datetime="2026-10-28">28 octobre 2026</time>.</p>
    </section>

    <ApplicationLinks lang="fr" />

    <section id="faq" class="mt-16">
      <h2 class="text-2xl font-semibold tracking-tight">Questions fréquentes</h2>
      <div class="mt-6 space-y-4">
        {serviceFaq.map((item) => (
          <details class="rounded-2xl border p-5" style="border-color: var(--color-border)">
            <summary class="cursor-pointer font-medium">{item.question}</summary>
            <p class="mt-4 leading-relaxed" style="color: var(--color-text-muted)">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <p>Particulier ou entreprise : contactez-nous par <a href="mailto:contact@flex-web.fr?subject=Projet%20application" class="underline" data-conversion-event="email_click" data-conversion-service="application">e-mail</a> ou au <a href="tel:+33757830262" class="underline" data-conversion-event="phone_click" data-conversion-service="application">07 57 83 02 62</a>. Le formulaire ci-dessous est réservé aux professionnels.</p>

    <aside id="contact" class="mt-16 rounded-3xl p-8 text-center" style="background-color: var(--color-surface)">
      <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
        Un projet d'application mobile ou web ?
      </h2>
      <p class="mt-4" style="color: var(--color-text-muted)">
        Discutons de votre projet et obtenez un devis gratuit.
      </p>
      <a
        href="/demarrer/?service=application"
        class="mt-6 inline-flex items-center justify-center rounded-full px-8 py-3 text-base font-medium text-white transition hover:opacity-90"
        style="background-color: var(--color-accent)"
        data-conversion-event="quote_click"
        data-conversion-service="application"
      >
        Demander un devis
      </a>
    </aside>
  </div>

  <StructuredData schemas={schemas} slot="head" />
<ProjectEvidence service="application" />
</BaseLayout>
