---
import DraftHub from '../../../../components/seo/national/DraftHub.astro';
import {draftGroups,additionalGroups} from '../../../../lib/seo/territorial-drafts.mjs';
export function getStaticPaths(){return [...draftGroups(),...additionalGroups()].filter(g=>g.page>1).map(group=>({params:{axe:group.axis,page:String(group.page)},props:{group}}));}
const {group}=Astro.props;
---
<DraftHub group={group}/>
