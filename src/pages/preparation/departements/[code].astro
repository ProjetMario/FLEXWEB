---
import ResourceLayout from '../../../components/seo/national/ResourceLayout.astro';
import {territoryDepartments} from '../../../lib/seo/territorial-directory.mjs';
import {draftPreviewEnabled} from '../../../lib/seo/territorial-drafts.mjs';
export function getStaticPaths(){return draftPreviewEnabled()?territoryDepartments().map(group=>({params:{code:group.code.toLowerCase()},props:{group}})):[];}
const {group}=Astro.props;
---
<ResourceLayout title={`Fiches territoriales : ${group.name} (${group.code})`} description={`Catalogue de relecture des fiches sites et automatisation pour ${group.name}. Préparation non indexable.`} noindex={true}>
 <nav aria-label="Fil d’Ariane"><a href="/preparation/">Catalogue de préparation</a></nav>
 <p class="eyebrow">Consultation par département</p><h1>{group.name} · {group.code}</h1>
 <p class="lead">{group.items.length} communes du catalogue, chacune avec une fiche site internet et une fiche automatisation. Cette sélection ne représente pas toutes les communes du département et ne mesure pas la demande commerciale.</p>
 <p class="note">Les fiches restent en préparation noindex. Les données officielles et cas de test locaux ne constituent pas une validation de leur intérêt éditorial individuel.</p>
 <ul class="directory-list">{group.items.map(c=><li><h2>{c.name}</h2><p>Code INSEE {c.code} · Codes postaux : {c.postalCodes.join(', ')||'non renseignés'}</p><div><a aria-label={`Fiche site internet — ${c.name} (${c.code})`} href={`/preparation/sites/${c.slug}/`}>Fiche site internet</a><a aria-label={`Fiche automatisation IA — ${c.name} (${c.code})`} href={`/preparation/automatisation/${c.slug}/`}>Fiche automatisation IA</a></div></li>)}</ul>
</ResourceLayout>
<style>.directory-list{list-style:none!important;padding:0!important}.directory-list li{padding:24px 0;border-bottom:1px solid #dce1e9}.directory-list h2{font-size:1.3rem;margin:0}.directory-list div{display:flex;gap:14px 28px;flex-wrap:wrap}</style>
