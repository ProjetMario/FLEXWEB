---
import BaseLayout from '../../layout/BaseLayout.astro';
import Realizations from '../../components/marketing/Realizations.astro';
import { plannedCaseStudies } from '../../data/realizations';
import '../../styles/marketing.css';
---
<BaseLayout title="Réalisations de sites et plateformes | FLEX-WEB" description="Découvrez Foot Nation, 2 Savoie Immo et Serrurier 73 : trois réalisations Flex-Web, leurs parcours et les fonctionnalités visibles.">
<header class="mw m-section"><p class="m-eyebrow">NOS RÉALISATIONS</p><h1>Des projets à explorer.</h1><p>Un artisan, une agence immobilière, une communauté : des besoins différents, des parcours concrets.</p></header>
<Realizations />
<section class="mw m-section planned"><p class="m-eyebrow">PROCHAINES PREUVES À DOCUMENTER</p><h2>Deux fiches seront publiées quand les preuves seront prêtes.</h2><div>{plannedCaseStudies.map(item => <article><p>{item.status}</p><h3>{item.title}</h3><span>{item.text}</span></article>)}</div></section>
</BaseLayout>
<style>
header h1{font-size:clamp(2.5rem,6vw,4.5rem);font-weight:600;line-height:1.05;letter-spacing:-.045em;margin:24px 0;color:#172133}header>p:last-child{font-size:1.2rem;line-height:1.65;max-width:750px;color:#52617a}
.planned h2{font-size:clamp(1.8rem,4vw,3rem);line-height:1.12;letter-spacing:-.04em;max-width:760px}.planned>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:28px}.planned article{border:1px solid #dce5ef;border-radius:22px;padding:24px;background:#f8fbff}.planned article p{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#075bbb;font-weight:650}.planned h3{font-size:1.35rem;font-weight:650;margin:10px 0}.planned span{font-size:15px;line-height:1.7;color:#425466}@media(max-width:700px){.planned>div{grid-template-columns:1fr}}
</style>
