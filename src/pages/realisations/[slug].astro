---
import BaseLayout from '../../layout/BaseLayout.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import { realizations } from '../../data/realizations';
export function getStaticPaths() { return realizations.map(project => ({params:{slug:project.slug},props:{project}})); }
const { project } = Astro.props;
const url = `https://flex-web.fr/realisations/${project.slug}/`;
const schemas = [{ '@type':'Article', '@id':url+'#article', headline:project.title, description:project.intro, url, datePublished:'2026-09-15', dateModified:'2026-09-15', author:{'@id':'https://flex-web.fr/#organization'}, publisher:{'@id':'https://flex-web.fr/#organization'}, image:`https://flex-web.fr/images/showcase/${project.image}`, mainEntityOfPage:url }, {'@type':'BreadcrumbList', itemListElement:[{name:'Accueil',item:'https://flex-web.fr/'},{name:'Réalisations',item:'https://flex-web.fr/realisations/'},{name:project.name,item:url}].map((item,i)=>({'@type':'ListItem',position:i+1,...item}))}];
---
<BaseLayout title={`${project.title} | FLEX-WEB`} description={project.intro}>
<article class="case-study">
<nav aria-label="Fil d’Ariane"><a href="/">Accueil</a> / <a href="/realisations/">Réalisations</a> / {project.name}</nav>
<p class="eyebrow">{project.category}</p><h1>{project.title}</h1><p class="intro">{project.intro}</p>
<p class="byline">Par <a href="/about/">FLEX-WEB</a> · Présentation vérifiée le <time datetime="2026-09-15">15 septembre 2026</time></p>
<a href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`Visiter ${project.name} (nouvel onglet)`}><img src={`/images/showcase/${project.image}`} alt={`Aperçu du site ${project.name}`} width="1280" height="960" /></a>
<h2>Ce que le visiteur peut faire</h2><ul>{project.features.map(feature => <li>{feature}</li>)}</ul>
<h2>Ce que ce projet peut inspirer au vôtre</h2><p>{project.takeaway}</p>
<p>Cette présentation décrit les fonctionnalités publiques observées. Le site peut évoluer ; ses statistiques de trafic et ses résultats commerciaux ne sont pas présentés ici.</p>
<p><a href={project.href} target="_blank" rel="noopener noreferrer">Explorer {project.domain} ↗</a></p>
<aside><h2>Et pour votre entreprise ?</h2><p>Partons du parcours de vos clients, des contenus disponibles et des outils que vous utilisez. Le périmètre, le calendrier et le prix sont confirmés dans un devis avant paiement.</p><a class="cta" href={`/demarrer/?service=${project.service}`}>Demander un devis</a><p><a href={project.servicePath}>{project.serviceLabel}</a> · <a href="/automatisation-ia/">Relier le site à vos tâches quotidiennes</a></p></aside>
</article><StructuredData schemas={schemas} />
</BaseLayout>
<style>
.case-study{max-width:920px;margin:auto;padding:64px 24px;color:#172133;line-height:1.75}.case-study h1{font-size:clamp(2rem,5vw,3.5rem);line-height:1.1;letter-spacing:-.035em;margin:20px 0}.case-study h2{font-size:1.6rem;line-height:1.3;margin:36px 0 16px}.intro{font-size:1.25rem}.eyebrow,.byline{font-size:.9rem;color:#52617a;margin:22px 0}.case-study img{width:100%;height:auto;max-height:600px;object-fit:cover;object-position:top;border-radius:24px;border:1px solid #e1e7ef}.case-study a{color:#1260d6;text-decoration:underline;text-underline-offset:4px}.case-study a:focus-visible{outline:3px solid #1260d6;outline-offset:5px}.case-study ul{padding-left:24px;list-style:disc}.case-study li{margin:12px 0}.case-study aside{background:#f2f6fb;border-radius:24px;padding:24px;margin-top:40px}.case-study .cta{display:inline-block;background:#1260d6;color:white;padding:12px 22px;border-radius:30px;text-decoration:none;margin-top:12px}
</style>
