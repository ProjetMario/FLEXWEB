---
import BaseLayout from "../layout/BaseLayout.astro";
import StructuredData from "../components/seo/StructuredData.astro";
import WebsiteOffers from "../components/marketing/WebsiteOffers.astro";
import BespokeOffers from "../components/marketing/BespokeOffers.astro";
import Realizations from "../components/marketing/Realizations.astro";
import faqData from "../data/faq.json";
import { business } from "../data/business";
import "../styles/marketing.css";
const schemas = [
  { "@type": "WebSite", "@id": `${business.url}/#website`, name: business.name, url: `${business.url}/`, inLanguage: "fr-FR", publisher: { "@id": `${business.url}/#organization` } },
  { "@type": "WebPage", "@id": `${business.url}/`, url: `${business.url}/`, name: "Automatisation IA, sites web et applications", description: business.description, isPartOf: { "@id": `${business.url}/#website` }, about: { "@id": `${business.url}/#organization` } },
  { "@type": "FAQPage", mainEntity: faqData.items.map(({question, answer}) => ({ "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: answer } })) },
];
---
<BaseLayout title="Automatisation IA, sites et applications en Savoie et Haute-Savoie" description="Flex-Web à Voglans : automatisation IA, création de sites internet et applications sur mesure. Savoie, Haute-Savoie et France. Demandez votre devis.">
  <div class="marketing-page">
    <section class="m-hero"><div class="mw hero-content"><p class="m-eyebrow">FLEX-WEB · SAVOIE, HAUTE-SAVOIE & FRANCE</p><h1>Sites internet et automatisations.<br /><span>Pensés pour votre entreprise.</span></h1><p class="hero-intro">Un site qui présente votre savoir-faire. Des outils qui simplifient votre quotidien.<br class="desktop-break" /> Du premier échange à la mise en ligne, avançons ensemble.</p><div class="m-actions"><a class="m-button" href="#offres">Voir les offres <span aria-hidden="true">↗</span></a><a class="m-button m-button-outline" href="/demarrer/">Demander un devis</a></div><p class="hero-note">Sites dès 299 € TTC · Applications et IA sur devis</p><div class="hero-signature" aria-hidden="true"><span>Votre présence en ligne.</span><span>Votre temps retrouvé.</span><span>Vos idées concrétisées.</span></div></div></section>
    <div id="avantages"><WebsiteOffers /></div>
    <Realizations />
    <BespokeOffers />
    <section id="comment" class="mw m-section method-section"><div class="section-heading"><p class="m-eyebrow">C’EST SIMPLE, DU DÉBUT À LA FIN</p><h2>Vous avez un projet.<br />Voici la suite.</h2></div><div class="method-grid"><article><span>01</span><h3>Parlez-nous de votre besoin.</h3><p>Choisissez une offre ou décrivez votre projet. La demande de devis est gratuite.</p></article><article><span>02</span><h3>Validez, puis payez.</h3><p>Vous recevez une proposition claire : prestations, prix et calendrier. Vous payez après validation du devis.</p></article><article><span>03</span><h3>Votre projet prend vie.</h3><p>Nous préparons votre site ou vos outils, échangeons avec vous et organisons la mise en service.</p></article></div></section>
    <section id="faq" class="mw m-section m-faq"><div class="section-heading"><p class="m-eyebrow">TOUT SIMPLEMENT</p><h2>Vos questions. Nos réponses.</h2></div>{faqData.items.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>
    <section id="contact" class="final-cta"><div class="mw"><p class="m-eyebrow">LE PROCHAIN PROJET, C’EST LE VÔTRE.</p><h2>On commence ?</h2><p>Une idée précise ou simplement une envie d’avancer.<br />Parlons de ce qui serait utile à votre entreprise.</p><a class="m-button" href="/demarrer/">Demander mon devis <span aria-hidden="true">↗</span></a><p class="cta-note">Demande gratuite · Aucun paiement à cette étape</p><a class="m-link" href="mailto:contact@flex-web.fr">contact@flex-web.fr</a></div></section>
    <section class="mw local-resources"><div><h2>Basé en Savoie. À vos côtés partout en France.</h2><p>Flex-Web, marque de Fleximmo à Voglans, accompagne les artisans, commerçants, indépendants et PME en Savoie, Haute-Savoie et à distance dans toute la France.</p><div class="resource-links"><a href="/automatisation-ia-savoie/">Automatisation IA en Savoie</a><a href="/automatisation-ia-haute-savoie/">Automatisation IA en Haute-Savoie</a><a href="/creation-site-internet-savoie/">Sites internet en Savoie</a><a href="/creation-site-internet-haute-savoie/">Sites internet en Haute-Savoie</a><a href="/about/">À propos de Flex-Web</a></div></div><div><h2>Comprendre avant de se lancer.</h2><div class="resource-links"><a href="/journal/taches-automatiser-pme/">Quelles tâches automatiser dans une PME ?</a><a href="/journal/connecter-demandes-crm/">Comment connecter vos demandes à un CRM ?</a><a href="/journal/automatisation-ou-application-sur-mesure/">Automatisation ou application sur mesure ?</a><a href="/journal/">Tous nos guides →</a></div></div></section>
  </div>
  <StructuredData schemas={schemas} slot="head" />
</BaseLayout>
