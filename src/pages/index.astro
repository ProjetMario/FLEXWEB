---
import BaseLayout from "../layout/BaseLayout.astro";
import StructuredData from "../components/seo/StructuredData.astro";

import Hero from "../components/sections/Hero.jsx";
import Benefits from "../components/sections/Benefits.jsx";
import HowItWorks from "../components/sections/HowItWorks.jsx";
import Templates from "../components/sections/Templates.jsx";
import Comparison from "../components/sections/Comparison.jsx";
import Stats from "../components/sections/Stats.jsx";
import Testimonials from "../components/sections/Testimonials.jsx";
import FAQ from "../components/sections/FAQ.jsx";
import CTA from "../components/sections/CTA.jsx";
import Contact from "../components/sections/Contact.jsx";

import featuresData from "../data/features.json";
import howItWorksData from "../data/howItWorks.json";
import templatesData from "../data/templates.json";
import comparisonData from "../data/comparison.json";
import statsData from "../data/stats.json";
import testimonialsData from "../data/testimonials.json";
import faqData from "../data/faq.json";
import ctaData from "../data/cta.json";
import contactData from "../data/contact.json";

const siteUrl = "https://flex-web.fr";
const schemas = [
  {
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    url: siteUrl,
    name: "Flex-Web",
    alternateName: "FLEX-WEB",
    inLanguage: "fr-FR",
    description: "Flex-Web crée des sites internet professionnels, rapides et optimisés pour les artisans, commerçants, indépendants et PME en Savoie et Haute-Savoie.",
    publisher: { "@id": `${siteUrl}/#organization` },
    potentialAction: {
      "@type": "SearchAction",
      target: {
        "@type": "EntryPoint",
        urlTemplate: `${siteUrl}/?q={search_term_string}`,
      },
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@type": "WebPage",
    "@id": `${siteUrl}/`,
    url: `${siteUrl}/`,
    name: "Flex-Web — Création de sites web professionnels",
    description: "FLEX-WEB crée votre site web moderne, rapide et optimisé. Hébergement, maintenance et support inclus. Demandez un devis gratuit.",
    isPartOf: { "@id": `${siteUrl}/#website` },
    about: { "@id": `${siteUrl}/#organization` },
    breadcrumb: { "@id": `${siteUrl}/#breadcrumb` },
    speakable: {
      "@type": "SpeakableSpecification",
      cssSelector: ["h1", ".hero-description", "meta[name='description']"],
    },
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${siteUrl}/#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: siteUrl },
    ],
  },
  {
    "@type": "HowTo",
    "@id": `${siteUrl}/#how-it-works`,
    name: howItWorksData.title,
    description: "Processus de création d'un site web professionnel en 4 étapes avec Flex-Web.",
    totalTime: "P14D",
    image: `${siteUrl}/logo.png`,
    step: howItWorksData.items.map((item, index) => ({
      "@type": "HowToStep",
      position: index + 1,
      name: item.title,
      text: item.description,
      url: `${siteUrl}/#etape-${index + 1}`,
    })),
  },
  {
    "@type": "FAQPage",
    "@id": `${siteUrl}/#faq`,
    mainEntity: faqData.items.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
  {
    "@type": "AggregateRating",
    "@id": `${siteUrl}/#rating`,
    itemReviewed: { "@id": `${siteUrl}/#organization` },
    ratingValue: "5",
    bestRating: "5",
    worstRating: "1",
    ratingCount: `${testimonialsData.items.length}`,
    reviewCount: `${testimonialsData.items.length}`,
  },
  ...testimonialsData.items.map((t) => ({
    "@type": "Review",
    itemReviewed: { "@id": `${siteUrl}/#organization` },
    author: { "@type": "Person", name: t.name },
    reviewRating: {
      "@type": "Rating",
      ratingValue: `${t.rating}`,
      bestRating: "5",
    },
    reviewBody: t.quote,
  })),
];
---

<BaseLayout
  transparentNav={true}
  title="Création de sites web professionnels"
  description="FLEX-WEB crée votre site web moderne, rapide et optimisé. Hébergement, maintenance et support inclus. Demandez un devis gratuit."
>
  <Hero client:load />
  <Benefits data={featuresData} client:load />
  <HowItWorks data={howItWorksData} client:load />
  <Templates data={templatesData} client:load />
  <Comparison data={comparisonData} client:load />
  <Stats data={statsData} client:load />
  <Testimonials data={testimonialsData} client:load />
  <FAQ data={faqData} client:load />
  <CTA data={ctaData} client:load />
  <Contact data={contactData} client:load />
  <StructuredData schemas={schemas} slot="head" />
</BaseLayout>
