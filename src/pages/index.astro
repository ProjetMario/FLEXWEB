---
import BaseLayout from "../layout/BaseLayout.astro";
import StructuredData from "../components/seo/StructuredData.astro";
import Contact from "../components/sections/Contact.jsx";
import contactData from "../data/contact.json";
import faqData from "../data/faq.json";
import { business } from "../data/business";
const services = [
  { number: "01", name: "Automatisation IA", description: "Demandes clients, CRM, documents : connectez vos outils et simplifiez les tâches qui se répètent.", price: "Sur devis", href: "/automatisation-ia/", cta: "Explorer les automatisations" },
  { number: "02", name: "Sites internet", description: "Présentez votre activité avec un site clair, adapté au mobile et pensé pour recevoir des demandes.", price: "299 € ou 990 € TTC", href: "/creation-site-internet/", cta: "Choisir mon site" },
  { number: "03", name: "Applications", description: "Un espace client, un outil interne ou une application métier construit autour de vos usages.", price: "Sur devis", href: "/creation-application-mobile/", cta: "Parler de mon application" },
];
const steps = [
  { title: "Partir de vos tâches", text: "Nous identifions les étapes répétitives, les outils utilisés et les points qui demandent votre jugement." },
  { title: "Définir une première version", text: "Le devis précise le périmètre, les accès nécessaires, les coûts des outils et le calendrier." },
  { title: "Tester avec vous", text: "Nous vérifions les cas courants, les erreurs et la reprise manuelle avant de mettre en service." },
  { title: "Organiser le suivi", text: "Vous gardez la main. La maintenance et les évolutions sont définies dans la prestation choisie." },
];

const realizedSites = [
  {
    name: 'Site Flex-Web',
    type: 'Landing page commerciale',
    href: 'https://flex-web.fr/',
    description:
      'Un site vitrine pensé pour convertir les visiteurs en demandes de devis, avec une tarification claire, des pages SEO locales et un parcours de contact simple.',
    tags: ['Site vitrine', 'SEO local', 'Devis'],
  },
  {
    name: 'Gestion Flex-Web',
    type: 'CRM et prospection',
    href: 'https://flexweb-gestion.netlify.app/',
    description:
      'Une plateforme de gestion pour suivre les prospects, préparer les relances SMS et e-mail, centraliser les demandes et piloter l’activité commerciale.',
    tags: ['CRM', 'Prospection', 'Automatisation'],
  },
  {
    name: 'Studio de création IA',
    type: 'Prototype SaaS',
    href: 'https://flexweb-gestion.netlify.app/studio',
    description:
      'Un espace de test pour créer une première version de site internet, organiser les contenus et accélérer la production avec l’aide de l’IA.',
    tags: ['IA', 'Création de site', 'Production'],
  },
];

const guides = [
  { title: "Quelles tâches automatiser dans une PME ?", href: "/journal/taches-automatiser-pme/", text: "Choisir un premier processus simple et mesurable." },
  { title: "Comment connecter vos demandes à un CRM ?", href: "/journal/connecter-demandes-crm/", text: "Passer d’un formulaire à un suivi commercial organisé." },
  { title: "Automatisation ou application sur mesure ?", href: "/journal/automatisation-ou-application-sur-mesure/", text: "Comprendre quel investissement répond à votre besoin." },
];
const schemas = [
  { "@type": "WebSite", "@id": `${business.url}/#website`, name: business.name, url: `${business.url}/`, inLanguage: "fr-FR", publisher: { "@id": `${business.url}/#organization` } },
  { "@type": "WebPage", "@id": `${business.url}/`, url: `${business.url}/`, name: "Automatisation IA, sites web et applications", description: business.description, isPartOf: { "@id": `${business.url}/#website` }, about: { "@id": `${business.url}/#organization` } },
  { "@type": "FAQPage", mainEntity: faqData.items.map(({question, answer}) => ({ "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: answer } })) },
];
---
<BaseLayout title="Automatisation IA, sites et applications en Savoie et Haute-Savoie" description="Flex-Web à Voglans : automatisation IA, création de sites internet et applications sur mesure. Savoie, Haute-Savoie et France. Demandez votre devis.">
  <section class="home-hero">
    <div class="home-wrap hero-grid">
      <div>
        <p class="eyebrow">FLEX-WEB · SAVOIE, HAUTE-SAVOIE & FRANCE</p>
        <h1>Moins de tâches.<br /><span>Plus de temps pour votre activité.</span></h1>
        <p class="hero-copy">Automatisation IA, sites internet et applications sur mesure : nous construisons les outils qui aident votre entreprise à avancer.</p>
        <div class="actions"><a class="button primary" href="/demarrer/?service=automation">Demander un devis d’automatisation IA <span aria-hidden="true">↗</span></a><a class="text-link" href="#avantages">Découvrir nos services <span aria-hidden="true">↓</span></a></div>
        <p class="small muted">Basé à Voglans · Accompagnement à distance partout en France</p>
      </div>
      <aside class="workflow" aria-label="Exemple de parcours automatisé">
        <div class="workflow-top"><span class="status-dot"></span> UNE DEMANDE, UN PARCOURS CLAIR</div>
        <p class="workflow-label">Exemple de fonctionnement à adapter à vos outils</p>
        <ol>
          <li><span class="step-icon">01</span><div><strong>Une demande arrive</strong><p>Votre formulaire recueille le besoin du client.</p></div></li>
          <li><span class="step-icon">02</span><div><strong>Votre CRM s’organise</strong><p>Une fiche et une tâche de suivi sont préparées.</p></div></li>
          <li><span class="step-icon">03</span><div><strong>Vous gardez la décision</strong><p>Vous vérifiez le besoin et validez la proposition.</p></div></li>
        </ol>
        <div class="workflow-foot">Démonstration illustrative · Configuration sur devis</div>
      </aside>
    </div>
  </section>
  <section id="avantages" class="home-wrap section">
    <p class="eyebrow">TROIS FAÇONS DE FAIRE AVANCER VOTRE ENTREPRISE</p>
    <h2>Le bon outil pour votre besoin.</h2>
    <div class="service-grid">
      {services.map((service) => <article class:list={["service-card", { featured: service.number === "01" }]}><span class="service-number">{service.number}</span><h3>{service.name}</h3><p>{service.description}</p><strong class="price">{service.price}</strong><a href={service.href}>{service.cta} <span aria-hidden="true">↗</span></a></article>)}
    </div>
    <p class="small muted">Sites : paiement unique. Maintenance avec modifications : option à 49 € TTC/mois. CRM, automatisation et référencement : option à 99 € TTC/mois. <a href="/pricing/">Voir les tarifs et les demandes de devis.</a></p>
  </section>

  <section id="realisations" class="home-wrap section work-section">
    <p class="eyebrow">RÉALISATIONS</p>
    <h2>Des exemples déjà réalisés et mis en ligne.</h2>
    <p class="section-copy">
      Ces projets montrent ce que Flex-Web peut livrer : un site clair pour vendre, un outil de prospection pour suivre les clients et un studio pour accélérer la création avec l’IA.
    </p>
    <div class="work-grid">
      {realizedSites.map((site) => (
        <article class="work-card">
          <p class="work-type">{site.type}</p>
          <h3>{site.name}</h3>
          <p>{site.description}</p>
          <div class="work-tags">
            {site.tags.map((tag) => <span>{tag}</span>)}
          </div>
          <a href={site.href} target="_blank" rel="noreferrer">Voir l’exemple</a>
        </article>
      ))}
    </div>
  </section>

  <section id="templates" class="tinted"><div class="home-wrap section split">
    <div><p class="eyebrow">DES USAGES CONCRETS</p><h2>Commencez par ce qui vous prend du temps.</h2><p class="section-copy">Une automatisation utile répond à une tâche précise. Voici des exemples à étudier ensemble, sans promesse de résultat chiffré.</p><a class="text-link" href="/automatisation-ia/">Voir les possibilités et les limites ↗</a></div>
    <div class="use-cases"><article><span>COMMERCIAL</span><h3>Suivre chaque demande</h3><p>Centraliser les demandes et préparer les prochaines actions dans votre CRM.</p></article><article><span>ADMINISTRATIF</span><h3>Préparer les documents</h3><p>Extraire ou résumer les informations utiles, puis faire vérifier les éléments importants.</p></article><article><span>RELATION CLIENT</span><h3>Garder une réponse claire</h3><p>Préparer des réponses et orienter les demandes complexes vers la bonne personne.</p></article><p class="small muted">Exemples de scénarios, pas des témoignages clients.</p></div>
  </div></section>
  <section id="comment" class="home-wrap section"><p class="eyebrow">NOTRE MÉTHODE</p><h2>Un projet cadré. Des étapes visibles.</h2><div class="steps-grid">{steps.map((step, i) => <article><span class="step-number">0{i + 1}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div></section>
  <section class="local-band"><div class="home-wrap section"><p class="eyebrow">UN STUDIO EN SAVOIE, UNE PORTÉE NATIONALE</p><h2>Proche de vos usages.<br />Où que vous travailliez.</h2><p class="section-copy">Flex-Web est une marque de Fleximmo, basée au 93 chemin de la Combe à Voglans. Nous accompagnons les artisans, commerçants, indépendants et PME de Savoie et Haute-Savoie, ainsi que les entreprises de France à distance.</p><div class="local-links"><a href="/automatisation-ia-savoie/">Automatisation IA en Savoie ↗</a><a href="/automatisation-ia-haute-savoie/">Automatisation IA en Haute-Savoie ↗</a><a href="/automatisation-ia/">Votre projet partout en France ↗</a></div><p class="small"><a href="/creation-site-internet-savoie/">Sites internet en Savoie</a> · <a href="/creation-site-internet-haute-savoie/">Sites en Haute-Savoie</a> · <a href="/creation-application-mobile/">Applications sur mesure</a> · <a href="/about/">Qui sommes-nous ?</a></p></div></section>
  <section class="home-wrap section"><p class="eyebrow">LES GUIDES FLEX-WEB</p><h2>Comprendre avant d’investir.</h2><div class="service-grid">{guides.map(guide => <article class="guide-card"><h3><a href={guide.href}>{guide.title} ↗</a></h3><p>{guide.text}</p></article>)}</div></section>
  <section id="faq" class="home-wrap section faq"><p class="eyebrow">VOS QUESTIONS</p><h2>Avant de lancer votre projet.</h2>{faqData.items.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>
  <Contact data={contactData} />
  <StructuredData schemas={schemas} slot="head" />
</BaseLayout>
<style>
  .home-wrap{max-width:1160px;margin:0 auto;padding-left:28px;padding-right:28px}.home-hero{padding:72px 0 84px;background:linear-gradient(130deg,#f2f7fd,#fff 70%)}.hero-grid{display:grid;grid-template-columns:1.18fr 1fr;gap:64px;align-items:center}.eyebrow{font-size:11px;font-weight:650;letter-spacing:.13em;color:#52667d;margin-bottom:22px}.home-hero h1{font-size:clamp(40px,4.5vw,65px);font-weight:650;letter-spacing:-.052em;line-height:1.06;max-width:630px}.home-hero h1 span{color:#0071e3}.hero-copy{font-size:19px;line-height:1.65;color:#56616f;margin:28px 0}.actions{display:flex;flex-direction:column;align-items:flex-start;gap:21px;margin-bottom:28px}.button{display:inline-flex;align-items:center;justify-content:center;gap:12px;border-radius:999px;padding:16px 23px;font-size:14px;font-weight:600}.primary{background:#0071e3;color:white}.primary:hover{background:#005bbb}.text-link{color:#0064cb;font-weight:550;font-size:14px}.small{font-size:12px;line-height:1.75}.muted{color:#687281}.small a{text-decoration:underline;text-underline-offset:3px}.workflow{background:#142b44;color:white;padding:30px;border-radius:26px;box-shadow:0 20px 55px #19395518}.workflow-top{font-size:10px;letter-spacing:.11em;font-weight:650;display:flex;align-items:center;gap:10px}.status-dot{width:7px;height:7px;border-radius:50%;background:#9cbcf0}.workflow-label{font-size:12px;line-height:1.6;color:#a7bbd2;margin:14px 0 28px}.workflow ol{display:grid;gap:20px}.workflow li{display:flex;gap:15px;padding:20px 15px;border:1px solid #ffffff19;border-radius:14px;background:#ffffff06}.step-icon{font-size:11px;color:#bad5f7;background:#ffffff0c;border-radius:50%;width:32px;height:32px;display:grid;place-items:center;flex-shrink:0}.workflow strong{font-size:15px;font-weight:550}.workflow li p{font-size:12px;line-height:1.65;color:#c0cee0;margin-top:5px}.workflow-foot{border-top:1px solid #ffffff16;margin-top:24px;padding-top:18px;font-size:10px;color:#afc3dc}.section{padding-top:80px;padding-bottom:80px}.section h2{font-size:clamp(29px,3vw,43px);line-height:1.15;letter-spacing:-.035em;font-weight:600;margin-bottom:34px}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:24px}.service-card{border:1px solid #dfe5ec;border-radius:22px;padding:28px;display:flex;flex-direction:column}.service-card.featured{background:#edf5ff;border-color:#c8ddf8}.service-number{font-size:12px;color:#76849a;margin-bottom:32px}.service-card h3,.guide-card h3{font-size:24px;letter-spacing:-.025em;font-weight:550}.service-card p,.guide-card p{font-size:15px;line-height:1.7;color:#5b6470;margin:18px 0 24px}.price{font-size:19px;font-weight:600;margin-top:auto;margin-bottom:18px}.service-card>a{font-size:14px;color:#0064cb;font-weight:550}.tinted{background:#f5f6f8}.split{display:grid;grid-template-columns:1fr 1fr;gap:84px}.section-copy{font-size:17px;line-height:1.8;color:#5b6470;max-width:730px;margin-bottom:28px}.use-cases{display:grid;gap:22px}.use-cases article{border-bottom:1px solid #dce1e7;padding-bottom:22px}.use-cases article span{font-size:10px;letter-spacing:.12em;color:#0064cb}.use-cases h3{font-size:22px;font-weight:550;margin:9px 0}.use-cases p,.steps-grid p{font-size:15px;line-height:1.7;color:#5b6470}.steps-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:28px}.step-number{display:block;font-size:13px;color:#0071e3;margin-bottom:24px}.steps-grid h3{font-size:19px;font-weight:550;margin-bottom:15px}.local-band{background:#edf5ff}.local-links{display:flex;flex-wrap:wrap;gap:14px;margin:32px 0}.local-links a{background:white;border:1px solid #dae5f3;padding:14px 18px;border-radius:12px;font-size:13px;color:#0064cb}.guide-card{padding:24px 0;border-top:1px solid #dfe5ec}.guide-card h3{font-size:20px;line-height:1.5}.faq{max-width:850px;padding-top:20px}.faq details{border-bottom:1px solid #dfe5ec;padding:23px 0}.faq summary{font-size:17px;font-weight:550;cursor:pointer}.faq details p{color:#5b6470;line-height:1.8;margin-top:18px}
  @media(max-width:900px){.hero-grid{grid-template-columns:1fr;gap:40px}.home-hero{padding:42px 0 50px}.hero-grid>div{max-width:680px}.workflow{max-width:650px}.split{gap:35px}.steps-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:640px){.home-wrap{padding-left:22px;padding-right:22px}.home-hero h1{font-size:43px}.hero-copy{font-size:17px}.button{font-size:13px;padding:15px 18px}.service-grid,.split,.steps-grid{grid-template-columns:1fr}.section{padding-top:54px;padding-bottom:54px}.workflow{padding:23px}.service-number{margin-bottom:18px}.service-card p{margin:14px 0 20px}.steps-grid{gap:26px}.step-number{margin-bottom:10px}}
</style>
