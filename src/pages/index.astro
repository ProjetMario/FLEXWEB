---
import BaseLayout from "../layout/BaseLayout.astro";
import StructuredData from "../components/seo/StructuredData.astro";
import WebsiteOffers from "../components/marketing/WebsiteOffers.astro";
import BespokeOffers from "../components/marketing/BespokeOffers.astro";
import Realizations from "../components/marketing/Realizations.astro";
import faqData from "../data/faq.json";
import { business } from "../data/business";
import { editorialTracking } from "../data/editorialTracking";
import { specialties } from "../data/specialties";
import "../styles/marketing.css";
const schemas = [
  { "@type": "WebSite", "@id": `${business.url}/#website`, name: business.name, url: `${business.url}/`, inLanguage: "fr-FR", publisher: { "@id": `${business.url}/#organization` } },
  { "@type": "WebPage", "@id": `${business.url}/`, url: `${business.url}/`, name: "Automatisation IA, sites web et applications", description: business.description, isPartOf: { "@id": `${business.url}/#website` }, about: { "@id": `${business.url}/#organization` } },
  { "@type": "FAQPage", mainEntity: faqData.items.map(({question, answer}) => ({ "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: answer } })) },
];
---
<BaseLayout title="Sites web, IA et applications en Savoie" description="Flex-Web à Voglans : automatisation IA, création de sites internet et applications sur mesure. Savoie, Haute-Savoie et France. Demandez votre devis.">
  <div class="marketing-page">
    <section class="m-hero"><div class="mw hero-content"><p class="m-eyebrow">FLEX-WEB · SAVOIE, HAUTE-SAVOIE & FRANCE</p><h1>Sites internet et automatisations.<br /><span>Pensés pour votre entreprise.</span></h1><p class="hero-intro">Un site qui présente votre savoir-faire. Des outils qui simplifient votre quotidien.<br class="desktop-break" /> Du premier échange à la mise en ligne, avançons ensemble.</p><div class="m-actions"><a class="m-button" href="#offres">Voir les offres <span aria-hidden="true">↗</span></a><a class="m-button m-button-outline" href="/demarrer/" data-conversion-event="quote_click" data-conversion-service="home">Demander un devis</a></div><p class="hero-note">Sites dès 299 € TTC · SEO / IA à 590 € TTC · CRM à 990 € TTC</p><div class="hero-signature" aria-hidden="true"><span>Votre présence en ligne.</span><span>Votre temps retrouvé.</span><span>Vos idées concrétisées.</span></div></div></section>
    <div id="avantages"><WebsiteOffers /></div>
    <section class="mw m-section specialty-band"><div class="section-heading"><p class="m-eyebrow">TROIS SPÉCIALITÉS POUR ÊTRE CONCRET</p><h2>Des offres expliquées par métier.</h2><p>Chaque page part de problèmes réels : demandes de devis, suivi client, visibilité locale, automatisation et assistant IA interne.</p></div><div>{specialties.map(item => <article><p>{item.eyebrow}</p><h3>{item.title}</h3><span>{item.audience}</span><a href={`/specialites/${item.slug}/`}>Voir la spécialité →</a></article>)}</div></section>
    <section class="mw m-section tool-band"><div><p class="m-eyebrow">RESSOURCES CITABLES</p><h2>Deux outils pour comprendre avant de demander un devis.</h2></div><div><a href="/outils/calculateur-temps-economise/">Calculateur de temps économisé →</a><a href="/outils/demo-crm/">Démonstration CRM interactive →</a></div></section>
    <Realizations />
    <BespokeOffers />
    <section id="comment" class="mw m-section method-section"><div class="section-heading"><p class="m-eyebrow">C’EST SIMPLE, DU DÉBUT À LA FIN</p><h2>Vous avez un projet.<br />Voici la suite.</h2></div><div class="method-grid"><article><span>01</span><h3>Parlez-nous de votre besoin.</h3><p>Choisissez une offre ou décrivez votre projet. La demande de devis est gratuite.</p></article><article><span>02</span><h3>Validez, puis payez.</h3><p>Vous recevez une proposition claire : prestations, prix et calendrier. Vous payez après validation du devis.</p></article><article><span>03</span><h3>Votre projet prend vie.</h3><p>Nous préparons votre site ou vos outils, échangeons avec vous et organisons la mise en service.</p></article></div></section>
    <section id="faq" class="mw m-section m-faq"><div class="section-heading"><p class="m-eyebrow">TOUT SIMPLEMENT</p><h2>Vos questions. Nos réponses.</h2></div>{faqData.items.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>
    <section id="contact" class="final-cta"><div class="mw"><p class="m-eyebrow">LE PROCHAIN PROJET, C’EST LE VÔTRE.</p><h2>On commence ?</h2><p>Une idée précise ou simplement une envie d’avancer.<br />Parlons de ce qui serait utile à votre entreprise.</p><div class="m-actions"><a class="m-button" href="/demarrer/" data-conversion-event="quote_click" data-conversion-service="home">Demander mon devis <span aria-hidden="true">↗</span></a><a class="m-button m-button-outline" href="mailto:contact@flex-web.fr?subject=Demande%20de%20rendez-vous%20Flex-Web" data-conversion-event="appointment_click" data-conversion-service="home">Demander un rendez-vous</a></div><p class="cta-note">Demande gratuite · Aucun paiement à cette étape</p><a class="m-link" href="mailto:contact@flex-web.fr">contact@flex-web.fr</a></div></section>
    <section class="mw local-resources"><div><h2>Basé en Savoie. À vos côtés partout en France.</h2><p>Flex-Web, marque de Fleximmo à Voglans, accompagne les artisans, commerçants, indépendants et PME en Savoie, Haute-Savoie et à distance dans toute la France.</p><div class="resource-links"><a href="/automatisation-ia-savoie/">Automatisation IA en Savoie</a><a href="/automatisation-ia-haute-savoie/">Automatisation IA en Haute-Savoie</a><a href="/creation-site-internet-savoie/">Sites internet en Savoie</a><a href="/creation-site-internet-haute-savoie/">Sites internet en Haute-Savoie</a><a href="/about/">À propos de Flex-Web</a></div></div><div><h2>Comprendre avant de se lancer.</h2><div class="resource-links"><a href="/journal/taches-automatiser-pme/">Quelles tâches automatiser dans une PME ?</a><a href="/journal/connecter-demandes-crm/">Comment connecter vos demandes à un CRM ?</a><a href="/journal/automatisation-ou-application-sur-mesure/">Automatisation ou application sur mesure ?</a><a href="/journal/">Tous nos guides →</a></div></div></section>
    <section class="mw editorial-table"><h2>Priorités éditoriales suivies.</h2><div>{editorialTracking.slice(0, 8).map(item => <p><a href={item.url}>{item.url}</a><span>{item.intention}</span><strong>{item.cta}</strong></p>)}</div></section>
  </div>
  <StructuredData schemas={schemas} slot="head" />
</BaseLayout>
<style>
.specialty-band>div:last-child{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.specialty-band article{border:1px solid #e2e2e7;border-radius:24px;padding:26px;background:#fafafa}.specialty-band article p{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#075bbb;font-weight:650}.specialty-band h3{font-size:24px;line-height:1.18;letter-spacing:-.035em;margin:12px 0;font-weight:650}.specialty-band span{display:block;font-size:14px;line-height:1.65;color:#6e6e73}.specialty-band a,.tool-band a{display:inline-flex;margin-top:20px;color:#0066cc;font-size:14px;font-weight:650;text-decoration:underline;text-underline-offset:4px}.tool-band{display:grid;grid-template-columns:1fr 1fr;gap:42px;border-top:1px solid #e2e2e7;border-bottom:1px solid #e2e2e7}.tool-band h2,.editorial-table h2{font-size:clamp(29px,3vw,42px);line-height:1.12;letter-spacing:-.04em;font-weight:650}.tool-band>div:last-child{display:grid;gap:16px;align-content:center}.tool-band>div:last-child a{margin:0;border:1px solid #e2e2e7;border-radius:16px;padding:18px;background:#f8fbff;text-decoration:none}.editorial-table{padding-block:54px}.editorial-table>div{margin-top:20px;border-top:1px solid #e2e2e7}.editorial-table p{display:grid;grid-template-columns:1fr 1.2fr .9fr;gap:16px;margin:0;padding:14px 0;border-bottom:1px solid #e2e2e7;font-size:12px;line-height:1.5}.editorial-table a{color:#0066cc}.editorial-table span{color:#6e6e73}.editorial-table strong{font-weight:650}@media(max-width:800px){.specialty-band>div:last-child,.tool-band,.editorial-table p{grid-template-columns:1fr}.editorial-table p{gap:6px}}
</style>
