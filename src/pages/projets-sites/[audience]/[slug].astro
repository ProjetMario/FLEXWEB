import ProjectPage from '../../../components/seo-expansion/ProjectPage.astro';
import {candidates,expansionEnabled} from '../../../lib/seo-expansion/fr-ch.mjs';
export function getStaticPaths(){
 if(!expansionEnabled())return [];
 return candidates().map(({audience,location})=>({params:{audience,slug:location.slug},props:{audience,location}}));
}
