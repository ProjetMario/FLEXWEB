---
import BaseLayout from "../layout/BaseLayout.astro";
import StructuredData from "../components/seo/StructuredData.astro";
import JournalListing from "../components/JournalListing.jsx";

import journalData from "../data/journalArticles.json";

const featured = journalData[0];
const rest = journalData.slice(1);
---

<BaseLayout
  title="Guides automatisation IA, sites internet et applications"
  description="Guides pratiques pour automatiser les tâches de votre PME, connecter votre CRM et choisir votre site ou application. Savoie, Haute-Savoie et France."
>
  <StructuredData slot="head" schemas={[
    { "@type": "CollectionPage", "@id": "https://flex-web.fr/journal/", url: "https://flex-web.fr/journal/", name: "Guides pratiques Flex-Web", inLanguage: "fr-FR", isPartOf: { "@id": "https://flex-web.fr/#website" }, mainEntity: { "@id": "https://flex-web.fr/journal/#guides" } },
    { "@type": "ItemList", "@id": "https://flex-web.fr/journal/#guides", itemListElement: journalData.map((item, index) => ({ "@type": "ListItem", position: index + 1, name: item.title, url: `https://flex-web.fr/journal/${item.slug}/` })) },
  ]} />
  <JournalListing data={rest} featured={featured} client:load />
</BaseLayout>
