---
import BaseLayout from "../layout/BaseLayout.astro";
import JournalListing from "../components/JournalListing.jsx";

import journalData from "../data/journalArticles.json";

const featured = journalData[0];
const rest = journalData.slice(1);
---

<BaseLayout
  title="Journal"
  description="Conseils pratiques sur la création de site internet, les tarifs web et le référencement local en Savoie et en Haute-Savoie."
>
  <JournalListing data={rest} featured={featured} client:load />
</BaseLayout>
