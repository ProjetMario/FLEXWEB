---
import BaseLayout from "../layout/BaseLayout.astro";
import StructuredData from "../components/seo/StructuredData.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

import { isIndexableMobileLocation, mobileDestination, mobileLocationPath, localApplicationContent } from "../data/location-indexing";

export async function getStaticPaths() {
  const locations = await getCollection(
    "locations",
    (entry: CollectionEntry<"locations">) => !entry.data.isDraft
  );

  const normalizeName = (name: string) =>
    name.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");

  const nameToSlug = Object.fromEntries(
    locations.map((loc: CollectionEntry<"locations">) => [
      normalizeName(loc.data.name),
      loc.data.slug,
    ])
  );

  const mobileDestinations = Object.fromEntries(locations.map((loc) => [loc.data.slug, mobileDestination(loc.data)]));
  const paths = [];

  for (const entry of locations) {
    paths.push({
      params: { slug: entry.data.slug },
      props: { entry, nameToSlug, mobileDestinations, isMobile: false },
    });

    if (isIndexableMobileLocation(entry.data)) {
      paths.push({
        params: { slug: mobileLocationPath(entry.data).slice(1, -1) },
        props: { entry, nameToSlug, mobileDestinations, isMobile: true },
      });
    }
  }

  return paths;
}

const { entry, nameToSlug, mobileDestinations, isMobile } = Astro.props as {
  entry: CollectionEntry<"locations">;
  nameToSlug: Record<string, string>;
  mobileDestinations: Record<string, string>;
  isMobile: boolean;
};
const { Content } = await render(entry);
const { data } = entry;
const mobileContent = localApplicationContent[data.slug];
const automationPath = data.department === "Haute-Savoie" ? "/automatisation-ia-haute-savoie/" : data.department === "Savoie" ? "/automatisation-ia-savoie/" : "/automatisation-ia/";
const preposition = data.type === "city" ? "à" : "en";

const normalizeName = (name: string) =>
  name.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");

const nearbyCityLinks = data.nearbyCities.map((city) => {
  const siteSlug = nameToSlug[normalizeName(city)] || null;
  return {
    name: city,
    slug: isMobile && siteSlug
      ? mobileDestinations[siteSlug]?.slice(1, -1)
      : siteSlug,
  };
}).filter((city) => !isMobile || (city.slug && isIndexableMobileLocation({ slug: city.slug.replace("creation-application-mobile-", "creation-site-internet-") }) && nameToSlug[normalizeName(city.name)] === city.slug.replace("creation-application-mobile-", "creation-site-internet-")));

const siteUrl = "https://flex-web.fr";
const slug = Astro.params.slug as string;
const canonicalUrl = `${siteUrl}/${slug}/`;

const pageTitle = isMobile
  ? `Création d'application mobile ${preposition} ${data.name} — FLEX-WEB`
  : data.seoTitle;
const pageDescription = isMobile
  ? `FLEX-WEB développe des applications mobiles et web sur mesure pour les entreprises ${preposition} ${data.name}. Gestion, réservation, espace client : devis gratuit.`
  : data.seoDescription;

const h1 = isMobile
  ? `Création d'application mobile ${preposition} ${data.name}`
  : `Création de site internet ${preposition} ${data.name}`;

const introText = isMobile
  ? mobileContent.intro
  : data.introduction;

const localContextText = isMobile
  ? mobileContent.context
  : data.localContext;

const webPageSchema = {
  "@type": "WebPage",
  "@id": canonicalUrl,
  url: canonicalUrl,
  name: pageTitle,
  description: pageDescription,
  isPartOf: { "@id": `${siteUrl}/#website` },
};

const serviceSchema = {
  "@type": "Service",
  "@id": `${canonicalUrl}#service`,
  name: h1,
  url: canonicalUrl,
  serviceType: isMobile ? "Développement d'application mobile et web" : "Création de site internet",
  description: isMobile
    ? `Flex-Web accompagne les professionnels ${preposition} ${data.name} pour concevoir une application mobile ou web sur mesure : réservation, espace client, gestion interne ou SaaS.`
    : `Flex-Web accompagne les professionnels ${preposition} ${data.name} pour concevoir un site internet clair, rapide et adapté à leur activité.`,
  provider: { "@id": `${siteUrl}/#organization` },
  areaServed: {
    "@type": data.type === "city" ? "City" : "AdministrativeArea",
    name: data.name,
  },
  offers: isMobile
    ? {
        "@type": "Offer",
        name: "Application mobile ou web sur mesure",
        description: "Développement sur devis selon la complexité du projet.",
        url: `${siteUrl}/pricing/`,
        priceCurrency: "EUR",
        availability: "https://schema.org/InStock",
      }
    : [
        { "@type": "Offer", name: "Site vitrine simple", price: "299", priceCurrency: "EUR", url: `${siteUrl}/pricing/`, priceSpecification: { "@type": "PriceSpecification", price: "299", priceCurrency: "EUR", valueAddedTaxIncluded: false } },
        { "@type": "Offer", name: "Site vitrine complet", price: "990", priceCurrency: "EUR", url: `${siteUrl}/pricing/`, priceSpecification: { "@type": "PriceSpecification", price: "990", priceCurrency: "EUR", valueAddedTaxIncluded: false } },
      ],
};

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Accueil",
      item: `${siteUrl}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: data.name,
      item: canonicalUrl,
    },
  ],
};

const mobileFaq = [
  {
    question: `Quel est le prix d'une application mobile ${preposition} ${data.name} ?`,
    answer: `Le coût dépend du nombre de fonctionnalités et de la complexité du projet. FLEX-WEB établit un devis personnalisé après un premier échange autour de vos besoins.`
  },
  {
    question: `Combien de temps faut-il pour développer une application mobile ${preposition} ${data.name} ?`,
    answer: `Le calendrier est fixé dans le devis après cadrage des fonctionnalités, des intégrations et de la reprise de données. Un premier lot limité peut être prévu avant les évolutions suivantes.`
  },
  {
    question: `FLEX-WEB intervient-il ${preposition} ${data.name} ?`,
    answer: `Oui. FLEX-WEB est basé à Voglans, en Savoie, et accompagne les entreprises ${preposition} ${data.name}. Les échanges et les démonstrations peuvent se dérouler à distance ; les modalités sont convenues au démarrage.`
  },
  {
    question: `Puis-je aussi commander un site internet avec mon application mobile ?`,
    answer: `Oui, FLEX-WEB conçoit à la fois des sites internet et des applications mobiles. Vous pouvez les faire développer ensemble pour une expérience utilisateur cohérente.`
  }
];

const faqData = isMobile ? [...mobileFaq, mobileContent.faq] : data.faq;

const faqSchema: Record<string, unknown> | null =
  faqData && faqData.length > 0
    ? {
        "@type": "FAQPage",
        mainEntity: faqData.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.answer,
          },
        })),
      }
    : null;

const schemas: Record<string, unknown>[] = [
  webPageSchema,
  serviceSchema,
  breadcrumbSchema,
];

if (faqSchema) {
  schemas.push(faqSchema);
}
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="mx-auto max-w-3xl px-6 py-16 lg:py-24">
    <nav aria-label="Fil d'Ariane" class="mb-8 text-sm" style="color: var(--color-text-muted)">
      <a href="/" class="hover:underline">Accueil</a>
      <span class="mx-2">/</span>
      <span>{data.name}</span>
    </nav>

    <h1 class="text-4xl font-semibold tracking-tight lg:text-5xl" style="color: var(--color-text)">
      {h1}
    </h1>

    <p class="mt-6 text-lg leading-relaxed" style="color: var(--color-text-muted)">
      {introText}
    </p>

    <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-text)">
      {localContextText}
    </p>

    <section class="mt-8 rounded-2xl p-6" style="background-color: var(--color-surface)">
      <h2 class="text-xl font-semibold tracking-tight" style="color: var(--color-text)">
        En bref
      </h2>
      <p class="mt-3 leading-relaxed" style="color: var(--color-text-muted)">
        {isMobile
          ? `FLEX-WEB développe des applications mobiles et web pour les professionnels ${preposition} ${data.name}. Le devis précise la conception, les fonctionnalités, les tests, le déploiement et le suivi retenus.`
          : `FLEX-WEB accompagne les professionnels ${preposition} ${data.name} pour concevoir un site internet clair, rapide et adapté à leur activité. La prestation peut inclure l'optimisation pour les moteurs de recherche, l'hébergement, la maintenance et le support.`}
      </p>
    </section>

    {!isMobile && (
      <div class="mt-12 space-y-6 text-lg leading-relaxed" style="color: var(--color-text)">
        <Content />
      </div>
    )}

    {isMobile && (
      <div class="mt-12 space-y-6 text-lg leading-relaxed" style="color: var(--color-text)">
        <h2 class="text-2xl font-semibold tracking-tight">{mobileContent.heading}</h2>
        <p class="text-sm" style="color: var(--color-text-muted)">Scénarios illustratifs pour cadrer votre projet ; ils ne constituent pas des références clients.</p>
        {mobileContent.scenarios.map((scenario) => (
          <section class="rounded-2xl border p-6" style="border-color: var(--color-border)">
            <h3 class="text-xl font-semibold">{scenario.title}</h3>
            <p class="mt-3">{scenario.text}</p>
          </section>
        ))}
        <h2 class="text-2xl font-semibold tracking-tight">Que préparer pour obtenir un devis d'application ?</h2>
        <ul class="list-disc space-y-2 pl-6">
          {mobileContent.preparation.map((item) => <li>{item}</li>)}
        </ul>
        <p>Le devis distingue le premier lot, les intégrations, la reprise éventuelle des données et le suivi après livraison. La publication sur les stores est étudiée selon l'usage ; un outil accessible par navigateur peut suffire.</p>
        <p>Un processus répétitif dans vos outils actuels peut aussi relever d'une <a href={automationPath} class="underline">automatisation IA</a>. Nous examinons ce besoin avant de proposer une application complète.</p>
      </div>
    )}

    {!isMobile && (
      <section class="mt-12 rounded-2xl p-6" style="background-color: var(--color-surface)">
        <h2 class="text-2xl font-semibold tracking-tight">Prix de création et options de suivi</h2>
        <p class="mt-4 leading-relaxed">Site vitrine simple : <strong>299 € HT</strong>. Site vitrine complet : <strong>990 € HT</strong>. La création est payée une seule fois. Maintenance avec modifications : <strong>49 € HT/mois en option</strong>. CRM, automatisation et référencement : <strong>99 € HT/mois en option</strong>, selon le périmètre du devis.</p>
        <p class="mt-3 leading-relaxed">Les applications et les automatisations sur mesure font l'objet d'un devis spécifique. Consultez les <a href="/pricing/" class="underline">offres et leurs conditions</a>.</p>
      </section>
    )}

    <section class="mt-12 rounded-2xl border p-6" style="border-color: var(--color-border)">
      <h2 class="text-2xl font-semibold tracking-tight">Relier votre présence en ligne au suivi de vos clients</h2>
      <p class="mt-4 leading-relaxed">Un formulaire peut alimenter votre CRM, préparer une tâche et signaler un dossier à compléter. Découvrez nos <a href={automationPath} class="underline">services d'automatisation IA {preposition} {data.name}</a> et le <a href="/automatisation-ia/" class="underline">cadrage d'un projet pour une entreprise en France</a>.</p>
    </section>

    {
      data.targetIndustries.length > 0 && (
        <section class="mt-12">
          <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
            Secteurs d'activité {preposition} {data.name}
          </h2>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            {data.targetIndustries.map((industry) => (
              <li class="flex items-center gap-2" style="color: var(--color-text-muted)">
                <span aria-hidden="true">•</span>
                {industry}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      !isMobile && data.services.length > 0 && (
        <section class="mt-12">
          <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
            Services disponibles {preposition} {data.name}
          </h2>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            {data.services.map((service) => (
              <li class="flex items-center gap-2" style="color: var(--color-text-muted)">
                <span aria-hidden="true">•</span>
                {service}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      nearbyCityLinks.length > 0 && (
        <section class="mt-12">
          <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
            Communes proches de {data.name}
          </h2>
          <ul class="mt-4 flex flex-wrap gap-3">
            {nearbyCityLinks.map((city) => (
              <li>
                {city.slug ? (
                  <a
                    href={`/${city.slug}/`}
                    class="inline-block rounded-full px-4 py-2 text-sm font-medium transition hover:opacity-90"
                    style="background-color: var(--color-surface); color: var(--color-accent)"
                  >
                    {city.name}
                  </a>
                ) : (
                  <span
                    class="inline-block rounded-full px-4 py-2 text-sm font-medium"
                    style="background-color: var(--color-surface); color: var(--color-text-muted)"
                  >
                    {city.name}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      faqData && faqData.length > 0 && (
        <section class="mt-16">
          <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
            Questions fréquentes
          </h2>
          <div class="mt-6 space-y-4">
            {faqData.map((item: { question: string; answer: string }) => (
              <details class="group rounded-2xl border p-5" style="border-color: var(--color-border); background-color: var(--color-surface)">
                <summary class="flex cursor-pointer list-none items-center justify-between font-medium" style="color: var(--color-text)">
                  {item.question}
                  <span class="transition-transform group-open:rotate-180" aria-hidden="true">
                    ▼
                  </span>
                </summary>
                <p class="mt-4 leading-relaxed" style="color: var(--color-text-muted)">
                  {item.answer}
                </p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    <aside class="mt-16 rounded-3xl p-8 text-center" style="background-color: var(--color-surface)">
      <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
        {isMobile
          ? `Vous souhaitez une application mobile ${preposition} ${data.name} ?`
          : `Vous souhaitez un site web ${preposition} ${data.name} ?`}
      </h2>
      <p class="mt-4" style="color: var(--color-text-muted)">
        Discutons de votre projet et obtenez un devis gratuit.
      </p>
      {isMobile && (
        <p class="mt-2 text-sm" style="color: var(--color-text-muted)">
          Vous cherchez plutôt un <a href={`/${data.slug}/`} class="underline" style="color: var(--color-accent)">site internet {preposition} {data.name}</a> ?
        </p>
      )}
      {!isMobile && (
        <p class="mt-2 text-sm" style="color: var(--color-text-muted)">
          Vous cherchez plutôt une <a href={mobileDestination(data)} class="underline" style="color: var(--color-accent)">application mobile {preposition} {data.name}</a> ?
        </p>
      )}
      <a
        href={isMobile ? "/contact/?service=application" : "/demarrer/?service=site"}
        class="mt-6 inline-flex items-center justify-center rounded-full px-8 py-3 text-base font-medium text-white transition hover:opacity-90"
        style="background-color: var(--color-accent)"
      >
        Demander un devis
      </a>
    </aside>
  </div>

  <StructuredData schemas={schemas} slot="head" />
</BaseLayout>
