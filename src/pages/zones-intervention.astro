---
import { getCollection } from "astro:content";
import BaseLayout from "../layout/BaseLayout.astro";
import StructuredData from "../components/seo/StructuredData.astro";
import { isIndexableMobileLocation, mobileLocationPath } from "../data/location-indexing";

const locations = (await getCollection("locations", ({ data }) => !data.isDraft))
  .sort((a, b) => a.data.name.localeCompare(b.data.name, "fr"));
const groups = [
  {
    id: "savoie",
    title: "Savoie",
    description: "Retrouvez les pages consacrées aux entreprises de Savoie et choisissez votre commune pour préparer votre projet de site internet.",
    entries: locations.filter(({ data }) => data.department === "Savoie"),
  },
  {
    id: "haute-savoie",
    title: "Haute-Savoie",
    description: "Consultez nos prestations pour les entreprises de Haute-Savoie, du bassin annécien aux vallées et au Genevois.",
    entries: locations.filter(({ data }) => data.department === "Haute-Savoie"),
  },
  {
    id: "autres-territoires",
    title: "Autres villes et régions",
    description: "Nous accompagnons également les projets à distance. Ces pages présentent les territoires concernés ; elles ne correspondent pas à des bureaux locaux.",
    entries: locations.filter(({ data }) => !["Savoie", "Haute-Savoie"].includes(data.department ?? "")),
  },
].filter(({ entries }) => entries.length > 0);
const mobileLocations = locations.filter(({ data }) => isIndexableMobileLocation(data));
const schemas = [{
  "@type": "CollectionPage",
  "@id": "https://flex-web.fr/zones-intervention/",
  url: "https://flex-web.fr/zones-intervention/",
  name: "Zones d'intervention Flex-Web",
  description: "Retrouvez les prestations de création de sites internet et d'applications par territoire.",
  isPartOf: { "@id": "https://flex-web.fr/#website" },
}];
---

<BaseLayout
  title="Zones d’intervention : Savoie, Haute-Savoie et France — Flex-Web"
  description="Retrouvez nos pages par ville pour créer votre site internet ou application. Flex-Web est basé à Voglans et accompagne aussi les entreprises à distance."
>
  <div class="mx-auto max-w-6xl px-6 py-14 lg:py-20">
    <nav aria-label="Fil d’Ariane" class="text-sm text-[#6e6e73]">
      <a href="/" class="hover:underline">Accueil</a><span class="mx-2">/</span><span>Zones d’intervention</span>
    </nav>
    <header class="mt-8 max-w-3xl">
      <p class="text-sm font-semibold text-[#0071e3]">Votre projet, où que vous soyez.</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-[#1d1d1f] sm:text-5xl">Retrouvez votre territoire.</h1>
      <p class="mt-6 text-lg leading-relaxed text-[#6e6e73]">Flex-Web est basé à Voglans, en Savoie. Nous créons des sites internet, des applications et des automatisations pour les entreprises de Savoie, de Haute-Savoie et partout en France à distance. Les modalités d’échange sont définies avec vous au début du projet.</p>
      <p class="mt-4 leading-relaxed text-[#6e6e73]">Choisissez une commune ou une région pour découvrir les prestations. Pour comparer les offres et leur périmètre, consultez les <a href="/pricing/" class="text-[#0071e3] underline">tarifs</a>, puis <a href="/demarrer/" class="text-[#0071e3] underline">demandez votre devis</a>.</p>
    </header>

    <nav aria-label="Choisir un territoire" class="mt-8 flex flex-wrap gap-3">
      {groups.map((group) => <a href={`#${group.id}`} class="rounded-full border border-[#d2d2d7] px-5 py-3 text-sm font-medium text-[#1d1d1f] transition hover:border-[#0071e3] hover:text-[#0071e3]">{group.title}</a>)}
      <a href="#applications" class="rounded-full border border-[#d2d2d7] px-5 py-3 text-sm font-medium text-[#1d1d1f] transition hover:border-[#0071e3] hover:text-[#0071e3]">Applications</a>
    </nav>

    {groups.map((group) => (
      <section id={group.id} class="mt-12 scroll-mt-28 rounded-3xl border border-[#e5e5e7] bg-[#f5f5f7] p-6 sm:p-9" aria-labelledby={`${group.id}-title`}>
        <h2 id={`${group.id}-title`} class="text-2xl font-semibold tracking-tight text-[#1d1d1f]">Sites internet — {group.title}</h2>
        <p class="mt-3 max-w-3xl leading-relaxed text-[#6e6e73]">{group.description}</p>
        <ul class="mt-7 grid gap-x-8 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">
          {group.entries.map(({ data }) => <li><a href={`/${data.slug}/`} class="block rounded-lg px-2 py-3 text-[#0068d1] underline-offset-4 hover:bg-white hover:underline">{data.name}</a></li>)}
        </ul>
      </section>
    ))}

    <section id="applications" class="mt-12 scroll-mt-28 rounded-3xl border border-[#e5e5e7] p-6 sm:p-9" aria-labelledby="applications-title">
      <h2 id="applications-title" class="text-2xl font-semibold tracking-tight text-[#1d1d1f]">Applications web et mobiles</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-[#6e6e73]">Un espace client, un outil de gestion ou un suivi d’interventions se définit selon vos usages. Retrouvez nos pages dédiées et des exemples de parcours à cadrer avant le devis.</p>
      <ul class="mt-6 grid gap-x-8 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">
        {mobileLocations.map(({ data }) => <li><a href={mobileLocationPath(data)} class="block rounded-lg px-2 py-3 text-[#0068d1] underline-offset-4 hover:bg-[#f5f5f7] hover:underline">Applications — {data.name}</a></li>)}
      </ul>
    </section>

    <section class="mt-12 rounded-3xl bg-[#f5f5f7] p-6 sm:p-9" aria-labelledby="ressources-title">
      <h2 id="ressources-title" class="text-2xl font-semibold tracking-tight text-[#1d1d1f]">Préparer votre projet</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        <li><a href="/creation-site-internet/" class="text-[#0068d1] underline">Création de site internet</a></li>
        <li><a href="/automatisation-ia/" class="text-[#0068d1] underline">Automatisation des tâches</a></li>
        <li><a href="/realisations/" class="text-[#0068d1] underline">Réalisations à découvrir</a></li>
        <li><a href="/journal/" class="text-[#0068d1] underline">Guides pratiques</a></li>
      </ul>
    </section>
  </div>
  <StructuredData schemas={schemas} slot="head" />
</BaseLayout>
