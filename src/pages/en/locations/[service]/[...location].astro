---
import {franceData} from '../../../../lib/seo/france-communes.mjs';
import EnglishLayout from '../../../../layout/EnglishLayout.astro';
import {allTerritoryEntries,allTerritoryGroups,draftData,draftPath} from '../../../../lib/seo/territorial-drafts.mjs';
import {enrichedTerritory,enrichmentData} from '../../../../lib/seo/territorial-insights.mjs';
import {englishAxes,englishLabels,englishPath,englishHub,serviceCopy,englishDate} from '../../../../lib/seo/english.mjs';
import {commonQuestions} from '../../../../data/english-pages.mjs';
export function getStaticPaths(){return [
 ...allTerritoryEntries().map(e=>({params:{service:englishAxes[e.axis],location:e.slug},props:{...e,kind:'guide'}})),
 ...allTerritoryGroups().map(g=>({params:{service:englishAxes[g.axis],location:g.page===1?undefined:`page/${g.page}`},props:{...g,kind:'directory'}}))
];}
const {axis,kind}=Astro.props;
const c=Astro.props.commune;
const e=c?enrichedTerritory(c.code):undefined;
const copy=serviceCopy[axis];
const historicalZone=c&&franceData().excludedNonCommuneRecords.some(r=>r.code===c.code);
const title=c?`${englishLabels[axis]} in ${c.name} (${c.departmentCode})`:`${englishLabels[axis]} location guides — page ${Astro.props.page}`;
const description=c?`Prepare a ${englishLabels[axis].toLowerCase()} project for ${c.name}, ${c.department}. Verify location, scope, data and acceptance checks with Flex-Web.`:`Browse page ${Astro.props.page} of the English ${englishLabels[axis].toLowerCase()} directory. Choose a commune to prepare a scoped Flex-Web project brief.`;
const shared=e?.postalGroups.filter(p=>p.totalCommunes>1)??[];
const postalKnown=c?.postalCodes.length && c.postalCodes.every(code=>e?.postalGroups.some(p=>p.postalCode===code && p.totalCommunes>=1));
const faq=c?[{q:`Does Flex-Web have an office in ${c.name}?`,a:`The published Flex-Web address is in Voglans, Savoie, France. This guide identifies ${c.name} (${c.code}) for project planning; it does not claim a local office or a completed local project.`},{q:`Is a postcode enough to identify ${c.name}?`,a:!c.postalCodes.length?`No postcode is recorded for ${c.name} in this extract. Confirm the address; do not infer that the commune has no postcode. Commune code ${c.code} is an administrative identifier, not a customer address.`:shared.length?`At least one recorded postcode is shared by several communes. Ask for the address and commune, keeping code ${c.code} separate from the postcode.`:postalKnown?`The extract does not show another commune sharing the recorded postcodes. Still confirm the address and keep commune code ${c.code}; source data can change.`:`The postcode comparison is incomplete. Confirm the address and commune code ${c.code} without assuming exclusive postcode coverage.`},...commonQuestions]:[];
const sourceDate=draftData().retrievedAt??draftData().generatedAt;
const enrichmentDate=enrichmentData().retrievedAt??enrichmentData().generatedAt;
---
<EnglishLayout title={title} description={description} faq={faq} service={c?englishLabels[axis]:undefined}>
 <h1>{title}</h1>
 {kind==='directory'?<>
  <p class="lead">Choose a commune to explore the project requirements, geographic checks and acceptance examples for {englishLabels[axis].toLowerCase()}.</p>
  <p>These are planning guides, not a list of Flex-Web offices or customer references. Coverage is confirmed for each project.</p>
  <nav aria-label="Directory pagination"><a href="/en/locations/">All services</a>{Astro.props.page>1&&<a rel="prev" href={englishHub(axis,Astro.props.page-1)}>Previous page</a>}{Astro.props.page < Astro.props.total&&<a rel="next" href={englishHub(axis,Astro.props.page+1)}>Next page</a>}<span>Page {Astro.props.page} of {Astro.props.total}</span></nav>
  <ul>{Astro.props.items.map(commune=><li><a href={englishPath(axis,commune)}>{commune.name} — {commune.department} ({commune.code})</a></li>)}</ul>
 </>:<>
  {historicalZone&&<aside class="note">Administrative status: this retained guide concerns an overseas territorial constituency, not a municipality under COG 2026. Its URL remains available for existing journeys; it is excluded from the new French commune directory.</aside>}
  <p class="lead">{copy.lead} This guide applies the planning questions to {c.name}, {c.department}, {c.region}.</p>
  <p class="meta">English content reviewed: <time datetime={englishDate}>{englishDate}</time>. <a href={draftPath(axis,c)} lang="fr">Read the French guide</a>.</p>
  <div class="note"><p>Flex-Web is based in Voglans, Savoie. This page does not claim a local office, a local customer or measured demand in {c.name}. Confirm remote delivery and any on-site requirement in your quote.</p></div>
  <section><h2>What should your project solve?</h2><p>For a business serving {c.name}, begin with its actual activity and the requests it needs to handle. The commune describes a place; it does not determine the business model, software, budget or working hours.</p><div class="grid">{copy.sections.map(([heading,text])=><article class="card"><h3>{heading}</h3><p>{text}</p></article>)}</div></section>
  <section><h2>Check the location before defining coverage</h2><table><tbody><tr><th scope="row">Commune</th><td>{c.name}</td></tr><tr><th scope="row">Official commune code</th><td>{c.code}</td></tr><tr><th scope="row">Department or overseas territory</th><td>{c.department} ({c.departmentCode})</td></tr><tr><th scope="row">Region or territory</th><td>{c.region}</td></tr><tr><th scope="row">Recorded postcodes</th><td>{c.postalCodes.join(', ')||'Not provided in this extract'}</td></tr>{e?.epci&&<tr><th scope="row">Intermunicipal body</th><td>{e.epci.name} ({e.epci.code})</td></tr>}</tbody></table><p><a href={`https://geo.api.gouv.fr/communes/${c.code}`}>Verify {c.name} in the official French geographic API</a>. Place names are retained in their official form. Administrative boundaries do not establish travel time or commercial service coverage.</p><p class="meta">Source extraction: {sourceDate||'see the dataset provenance below'}{enrichmentDate?`; enrichment: ${enrichmentDate}`:''}. Review the current API record before relying on changing administrative data.</p></section>
  <section><h2>How should addresses be handled in {c.name}?</h2>
   {!c.postalCodes.length?<p>The extract contains no postcode for this commune. Ask the contact to confirm the full address rather than filling in a guessed postcode.</p>:shared.length?<><p>A postcode alone is ambiguous here:</p><ul>{shared.map(p=><li>{p.postalCode} is associated with {p.totalCommunes} communes in the source.{p.others.length>0&&` Examples: ${p.others.map(n=>`${n.name} (${n.code})`).join(', ')}.`}</li>)}</ul></>:<p>{postalKnown?'The source comparison shows no shared postcode for this commune.':'The postcode comparison is incomplete for this commune.'} Keep the address and commune as separate fields so uncertain requests can be reviewed.</p>}
   <p>Store {c.code} as the commune identifier independently of the displayed name and postcode. Test an incomplete request, then correct it to {c.name} without creating a second customer record.</p>
  </section>
  <section><h2>How can similarly named places be distinguished?</h2>{e?.homonyms.length?<p>The normalised name also appears as {e.homonyms.map(h=>`${h.name} (department ${h.departmentCode}, code ${h.code})`).join('; ')}. A name-only search can therefore select another territory.</p>:<p>No other commune with the same normalised name was found in this extract. Misspellings, abbreviations and named localities still need separate handling.</p>}<p>Show {c.name}, {c.departmentCode} and {c.code} together in the confirmation step. Never merge organisations on the basis of a commune or a similar name alone.</p></section>
  <section><h2>Which nearby locations require a separate coverage decision?</h2>{e?.nearby.length?<><p>The following distances compare administrative centres in the source. They are approximate straight-line distances, not journeys, response times or promises of service.</p><table><thead><tr><th>Commune</th><th>Code</th><th>Distance</th></tr></thead><tbody>{e.nearby.map(n=><tr><td>{n.name} ({n.departmentCode})</td><td>{n.code}</td><td>{n.distanceKm.toLocaleString('en-GB')} km</td></tr>)}</tbody></table></>:<p>No nearby-centre comparison is available in this extract. Qualify coverage manually.</p>}<p>Use an explicit list of places served for each service and team. A neighbouring commune or shared administrative body does not establish availability. Missing coordinates must not silently reject an enquiry.</p></section>
  <section><h2>What should be tested before launch?</h2><p>{copy.example}</p><p>This is a proposed acceptance scenario, not a reported client result. For the geographic check, submit a request naming {c.name} without a department, then confirm code {c.code}. The user must be able to correct the selection before any consequential action.</p><h3>Prepare your project brief</h3><ul>{copy.checks.map(check=><li>{check}</li>)}</ul><p>Include the actual working area, desired languages, constraints and a contact responsible for acceptance. Use anonymised examples rather than live customer records in an initial enquiry.</p></section>
  <section><h2>What will it cost, and how do you start?</h2><p><a href="/en/pricing/">View the current public prices in euros</a>. Flex-Web confirms scope, integrations, third-party costs, delivery schedule and responsibilities in a quote. Custom applications and advanced AI require an individual estimate. No delivery date or ranking is implied by this guide.</p><a class="action" href="/en/contact/">Send your project brief</a></section>
  <section><h2>Related services and locations</h2><nav><a href={`/en/${englishAxes[axis]}/`}>{englishLabels[axis]} overview</a><a href={englishHub(axis)}>Browse other communes</a><a href="/en/international-projects/">Remote projects from abroad</a>{Object.entries(englishAxes).filter(([other])=>other!==axis).map(([other,slug])=><a href={`/en/${slug}/`}>{englishLabels[other]}</a>)}</nav></section>
 </>}
</EnglishLayout>
