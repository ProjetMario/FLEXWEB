---
import BaseLayout from "../../layout/BaseLayout.astro";
import StructuredData from "../../components/seo/StructuredData.astro";
import { specialtyOptions, specialties } from "../../data/specialties";
import "../../styles/marketing.css";

export function getStaticPaths() {
  return specialties.map((specialty) => ({ params: { slug: specialty.slug }, props: { specialty } }));
}

const { specialty } = Astro.props;
const canonicalUrl = `https://flex-web.fr/specialites/${specialty.slug}/`;
const euros = (cents: number | null) => cents ? new Intl.NumberFormat("fr-FR", { style: "currency", currency: "EUR", maximumFractionDigits: 0 }).format(cents / 100) : "Sur devis";
const schemas = [
  { "@type": "WebPage", "@id": canonicalUrl, url: canonicalUrl, name: specialty.title, description: specialty.description, isPartOf: { "@id": "https://flex-web.fr/#website" } },
  { "@type": "Service", "@id": `${canonicalUrl}#service`, name: specialty.title, description: specialty.description, provider: { "@id": "https://flex-web.fr/#organization" }, areaServed: { "@type": "Country", name: "France" }, audience: { "@type": "Audience", audienceType: specialty.audience } },
  { "@type": "FAQPage", "@id": `${canonicalUrl}#faq`, mainEntity: specialty.faq.map(([question, answer]) => ({ "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: answer } })) },
];
---
<BaseLayout title={`${specialty.title} | Flex-Web`} description={specialty.description}>
  <article class="specialty-page">
    <header class="specialty-hero">
      <nav aria-label="Fil d’Ariane"><a href="/">Accueil</a> / <span>{specialty.eyebrow}</span></nav>
      <p class="m-eyebrow">{specialty.eyebrow}</p>
      <h1>{specialty.title}</h1>
      <p>{specialty.description}</p>
      <div class="hero-actions">
        <a class="primary" href={specialty.recommended[0].href} data-conversion-event="quote_click" data-conversion-service={specialty.slug}>Demander un devis adapté →</a>
        <a class="secondary" href="#parcours">Voir le parcours type</a>
      </div>
    </header>

    <section class="specialty-section">
      <div>
        <p class="m-eyebrow">Besoins fréquents</p>
        <h2>Les problèmes à traiter en priorité.</h2>
      </div>
      <div class="specialty-list">{specialty.problems.map((problem) => <p>{problem}</p>)}</div>
    </section>

    <section id="parcours" class="specialty-section scenario">
      <div>
        <p class="m-eyebrow">Démonstration de fonctionnement</p>
        <h2>Un parcours simple, validé par l’entreprise.</h2>
        <p>Aucune automatisation sensible ne part seule : les règles, exceptions et validations sont définies au devis.</p>
      </div>
      <ol>{specialty.demo.map((step, index) => <li><span>0{index + 1}</span>{step}</li>)}</ol>
    </section>

    <section class="specialty-section">
      <div>
        <p class="m-eyebrow">Offres applicables</p>
        <h2>Une entrée claire, puis un devis précis.</h2>
      </div>
      <div class="offer-stack">
        {specialty.recommended.map((offer) => <article>
          <h3>{offer.name}</h3>
          <p class="price">{euros(offer.price)} <span>{offer.price ? "TTC" : ""}</span></p>
          <p>{offer.note}</p>
          <a href={offer.href} data-conversion-event="quote_click" data-conversion-service={specialty.slug}>Choisir cette base →</a>
        </article>)}
      </div>
    </section>

    <aside class="option-note">
      <h2>Options facultatives</h2>
      <ul>{specialtyOptions.map((option) => <li>{option}</li>)}</ul>
      <p>Les licences, outils tiers, volumes et limites restent précisés dans le devis. Les positions Google et les citations par les IA ne sont jamais garanties.</p>
    </aside>

    <section class="specialty-section resources">
      <div>
        <p class="m-eyebrow">À consulter</p>
        <h2>Preuves et ressources utiles.</h2>
      </div>
      <div>{specialty.links.map((link) => <a href={link.href}>{link.label} →</a>)}</div>
    </section>

    <section id="faq" class="specialty-faq">
      <h2>Questions fréquentes</h2>
      {specialty.faq.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}
    </section>
  </article>
  <StructuredData schemas={schemas} slot="head" />
</BaseLayout>
<style>
.specialty-page{max-width:1120px;margin:auto;padding:64px 24px;color:#172133}.specialty-page a{color:#075bbb;text-decoration:underline;text-underline-offset:4px}.specialty-hero{max-width:850px}.specialty-hero nav{font-size:13px;color:#52617a;margin-bottom:36px}.specialty-hero h1{font-size:clamp(2.6rem,6vw,5rem);line-height:1.02;letter-spacing:-.055em;font-weight:650;margin:20px 0}.specialty-hero>p:last-of-type{font-size:clamp(1.05rem,2vw,1.35rem);line-height:1.7;color:#52617a}.hero-actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:30px}.hero-actions a,.offer-stack a{display:inline-flex;min-height:48px;align-items:center;justify-content:center;border-radius:999px;padding:12px 20px;text-decoration:none;font-weight:600}.primary{background:#006cda;color:#fff!important}.secondary{background:#edf5ff;color:#075bbb!important}.specialty-section{display:grid;grid-template-columns:.9fr 1.1fr;gap:48px;border-top:1px solid #dce5ef;margin-top:70px;padding-top:44px}.specialty-section h2,.specialty-faq h2,.option-note h2{font-size:clamp(1.7rem,3vw,2.45rem);line-height:1.12;letter-spacing:-.035em;font-weight:600}.specialty-section p,.specialty-section li,.option-note p,.option-note li,.specialty-faq p{font-size:15px;line-height:1.8;color:#425466}.specialty-list{display:grid;gap:14px}.specialty-list p{border:1px solid #dce5ef;border-radius:18px;padding:18px;background:#f8fbff}.scenario ol{display:grid;gap:16px;list-style:none}.scenario li{border:1px solid #dce5ef;border-radius:18px;padding:20px;background:#fff}.scenario span{display:block;color:#075bbb;font-weight:650;margin-bottom:10px}.offer-stack{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.offer-stack article{border:1px solid #dce5ef;border-radius:20px;padding:24px;background:#fff}.offer-stack h3{font-size:1.2rem;font-weight:650}.price{font-size:2rem!important;color:#172133!important;font-weight:650;margin:12px 0 8px}.price span{font-size:13px}.option-note{margin-top:38px;border-radius:24px;background:#f2f6fb;padding:28px}.option-note ul{margin:16px 0 12px;padding-left:20px}.resources a{display:block;border-bottom:1px solid #dce5ef;padding:16px 0;font-weight:600}.specialty-faq{max-width:850px;margin-top:70px}.specialty-faq details{border-bottom:1px solid #dce5ef;padding:20px 0}.specialty-faq summary{cursor:pointer;font-weight:650;font-size:1.05rem}.specialty-faq p{margin-top:14px}.m-eyebrow{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#075bbb;font-weight:650}@media(max-width:760px){.specialty-page{padding:42px 20px}.specialty-section,.offer-stack{grid-template-columns:1fr;gap:24px}.specialty-section{margin-top:50px;padding-top:34px}.hero-actions a{width:100%}}
</style>
