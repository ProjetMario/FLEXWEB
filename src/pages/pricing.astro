---
import BaseLayout from "../layout/BaseLayout.astro";
import WebsiteOffers from "../components/marketing/WebsiteOffers.astro";
import BespokeOffers from "../components/marketing/BespokeOffers.astro";
import "../styles/marketing.css";
import StructuredData from "../components/seo/StructuredData.astro";
import { pricingFaq, websiteOffers, pricingOptions } from "../data/pricing.ts";

const siteUrl = "https://flex-web.fr";
const canonicalUrl = `${siteUrl}/pricing/`;
const euros = (cents: number) => new Intl.NumberFormat("fr-FR", {
  style: "currency", currency: "EUR", maximumFractionDigits: 0,
}).format(cents / 100);
const schemas = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: siteUrl },
      { "@type": "ListItem", position: 2, name: "Tarifs", item: canonicalUrl },
    ],
  },
  {
    "@type": "FAQPage", "@id": `${canonicalUrl}#faq`,
    mainEntity: pricingFaq.map((item) => ({
      "@type": "Question", name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
  {
    "@type": "OfferCatalog", "@id": `${canonicalUrl}#offers`,
    name: "Sites internet et options — Flex-Web",
    itemListElement: [
      ...websiteOffers.map((offer) => ({
        "@type": "Offer", name: offer.name,
        description: `${offer.description} ${offer.features.join(". ")}. Prix TTC de création, payé une seule fois. Options mensuelles facultatives. Périmètre confirmé sur devis.`,
        price: String(offer.setupCents / 100), priceCurrency: "EUR",
        priceSpecification: { "@type": "PriceSpecification", price: String(offer.setupCents / 100), priceCurrency: "EUR", valueAddedTaxIncluded: true },
        url: `${siteUrl}${offer.href}`, seller: { "@id": `${siteUrl}/#organization` },
      })),
      ...pricingOptions.map((option) => ({
        "@type": "Offer", name: `Option ${option.name}`, description: option.description,
        price: String(option.monthlyCents / 100), priceCurrency: "EUR",
        priceSpecification: { "@type": "UnitPriceSpecification", price: String(option.monthlyCents / 100), priceCurrency: "EUR", unitText: "mois", valueAddedTaxIncluded: true },
        url: `${canonicalUrl}#options`, seller: { "@id": `${siteUrl}/#organization` },
      })),
    ],
  },
];
---
<BaseLayout title="Tarifs sites internet : 299 € et 990 € TTC | Flex-Web" description="Sites vitrines à 299 € ou 990 € TTC. Options facultatives : maintenance 49 € TTC/mois, CRM, automatisation et SEO 99 € TTC/mois. Applications et IA sur devis.">
  <div class="marketing-page">
    <header class="m-hero pricing-hero"><div class="mw hero-content"><p class="m-eyebrow">LES TARIFS FLEX-WEB</p><h1>Un prix clair.<br /><span>Le choix vous appartient.</span></h1><p class="hero-intro">Votre site à 299 € ou 990 € TTC, payé une seule fois.<br />Un devis pour confirmer le projet. Des options si vous le souhaitez.</p><nav class="m-actions" aria-label="Choisir une prestation"><a class="m-button" href="#devis">Choisir mon site</a><a class="m-link" href="#automatisation">Automatisation IA ↗</a><a class="m-link" href="#applications">Application ↗</a></nav></div></header>
    <WebsiteOffers id="devis" />
    <BespokeOffers />
    <section id="faq" class="mw m-section m-faq"><div class="section-heading"><p class="m-eyebrow">AVANT DE CHOISIR</p><h2>Tout est plus clair.</h2></div>{pricingFaq.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>
    <section class="final-cta"><div class="mw"><h2>Un besoin particulier ?</h2><p>Décrivez-nous votre projet.<br />Nous vous proposons une solution adaptée.</p><a class="m-button" href="/demarrer/">Demander un devis <span aria-hidden="true">↗</span></a><p class="cta-note">Gratuit · Paiement après validation du devis</p></div></section>
  </div>
  <StructuredData schemas={schemas} slot="head" />
</BaseLayout>
