---
import ProjectEvidence from "../components/seo/ProjectEvidence.astro";
import BaseLayout from "../layout/BaseLayout.astro";
import StructuredData from "../components/seo/StructuredData.astro";
import { getEntry, render } from "astro:content";
import { websiteOffers, pricingOptions } from "../data/pricing";

const euros = (cents: number) => new Intl.NumberFormat("fr-FR", {
  style: "currency", currency: "EUR", maximumFractionDigits: 2, minimumFractionDigits: 0,
}).format(cents / 100);
const simpleOffer = websiteOffers.find((offer) => offer.id === "essentielle")!;
const completeOffer = websiteOffers.find((offer) => offer.id === "visibilite")!;
const maintenance = pricingOptions.find((option) => option.id === "maintenance")!;
const crm = pricingOptions.find((option) => option.id === "crm")!;

const offerGuidance = {
  essentielle: "Votre priorité : expliquer votre activité, montrer vos services et permettre à un visiteur de vous contacter facilement.",
  visibilite: "Votre priorité : présenter 5 pages et plus, structurer vos contenus pour Google, Bing et la recherche par IA, avec le périmètre fixé au devis.",
};

const quoteChecklist = [
  { title: "Les pages et leur contenu", text: "La liste des pages, les services à présenter, les zones couvertes et les textes, photos ou réalisations que vous fournissez. La rédaction et la création de contenus attendues sont précisées." },
  { title: "Les fonctions et le formulaire", text: "Les champs de contact, les informations nécessaires pour qualifier une demande, ses destinataires et les connexions éventuelles à vos outils." },
  { title: "Le domaine, l’hébergement et les accès", text: "Les coûts éventuels, les renouvellements, les licences et les accès nécessaires. Le domaine est enregistré à votre nom ; les responsabilités sont définies avant la mise en ligne." },
  { title: "Le calendrier et la validation", text: "Les éléments à fournir, les étapes de vérification, les corrections prévues, le délai et les conditions de publication. Le paiement intervient après validation du devis." },
  { title: "Le total TTC et le suivi choisi", text: "Le prix de création, les éventuels besoins supplémentaires et les options mensuelles retenues, avec leurs limites et leurs conditions. Chaque coût récurrent est identifié." },
];

const serviceFaq = [
  {
    "question": "Combien coûte la création d'un site internet ?",
    "answer": `Le site vitrine simple coûte ${euros(simpleOffer.setupCents)} TTC et le site avec référencement SEO et IA ${euros(completeOffer.setupCents)} TTC, payés une seule fois. Le devis confirme les pages, les contenus et les fonctions retenus. La demande de devis est gratuite et le paiement intervient après sa validation.`
  },
  {
    "question": "Comment choisir entre le site vitrine et le site avec SEO / IA ?",
    "answer": `Le site simple comprend : ${simpleOffer.features.join(" ; ")}. Le site avec SEO / IA prévoit : ${completeOffer.features.join(" ; ")}. Choisissez selon le détail de vos prestations et les informations à recueillir. Le devis fixe la liste des pages et le périmètre exact ; le nombre de pages, à partir de 5, est défini au devis.`
  },
  {
    "question": "Dois-je prendre une option mensuelle ?",
    "answer": `Non. La maintenance avec modifications à ${euros(maintenance.monthlyCents)} TTC/mois et l’option CRM, automatisation et référencement à ${euros(crm.monthlyCents)} TTC/mois sont facultatives. Le devis précise les actions, les outils, les limites et les conditions de chaque option. Aucune n’est ajoutée automatiquement.`
  },
  {
    "question": "Le nom de domaine et l'hébergement sont-ils inclus ?",
    "answer": "Le domaine et l’hébergement sont précisés séparément dans le devis, avec leurs éventuels coûts récurrents. Le domaine est enregistré à votre nom. Les licences, consommations d’outils tiers et travaux supplémentaires éventuels sont indiqués avant votre accord."
  },
  {
    "question": "Quel est le délai de création ?",
    "answer": "Le calendrier est convenu dans le devis après validation du périmètre et réception des contenus. Les étapes de conception, de vérification et de publication sont organisées avec vous."
  },
  {
    "question": "Pouvez-vous créer un site pour une entreprise ailleurs en France ?",
    "answer": "Oui. FLEX-WEB est basé à Voglans en Savoie et accompagne les entreprises de Savoie, de Haute-Savoie et de toute la France. Les échanges, les démonstrations et les validations peuvent se faire à distance."
  },
  {
    "question": "Un site peut-il être relié à mon CRM ?",
    "answer": `Oui, selon les capacités de votre CRM et les accès disponibles. L'option à ${euros(crm.monthlyCents)} TTC/mois couvre le périmètre convenu au devis. La mise en place d’un CRM et d’automatisations des tâches répétitives est proposée à 990 € TTC en paiement unique, selon le périmètre fixé au devis. Les intégrations avancées sont chiffrées séparément.`
  }
];

const entry = await getEntry("services", "creation-site-internet");

if (!entry) {
  throw new Error("Service creation-site-internet not found");
}

const { Content } = await render(entry);
const { data } = entry;

const siteUrl = "https://flex-web.fr";
const canonicalUrl = `${siteUrl}/creation-site-internet/`;

const webPageSchema = {
  "@type": "WebPage",
  "@id": canonicalUrl,
  url: canonicalUrl,
  name: data.seoTitle,
  description: data.seoDescription,
  isPartOf: { "@id": `${siteUrl}/#website` },
};

const serviceSchema = {
  "@type": "Service",
  "@id": `${canonicalUrl}#service`,
  name: data.title,
  url: canonicalUrl,
  description: data.description,
  provider: { "@id": `${siteUrl}/#organization` },
  areaServed: [
    { "@type": "AdministrativeArea", name: "Savoie" },
    { "@type": "AdministrativeArea", name: "Haute-Savoie" },
    { "@type": "Country", name: "France" },
  ],
  audience: {
    "@type": "Audience",
    audienceType: data.targetAudience.join(", "),
  },
  serviceType: "Création de site internet",
  offers: websiteOffers.map((offer) => ({
    "@type": "Offer",
    name: offer.name,
    description: `${offer.description} ${offer.features.join(". ")}. Prix TTC de création, payé une seule fois. Périmètre confirmé sur devis. Options mensuelles facultatives.`,
    price: String(offer.setupCents / 100),
    priceCurrency: "EUR",
    url: `${siteUrl}${offer.href}`,
    priceSpecification: { "@type": "PriceSpecification", price: String(offer.setupCents / 100), priceCurrency: "EUR", valueAddedTaxIncluded: true },
  })),
};

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: data.title, item: canonicalUrl },
  ],
};

const faqSchema = {
  "@type": "FAQPage",
  "@id": `${canonicalUrl}#faq`,
  mainEntity: serviceFaq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};

const schemas = [webPageSchema, serviceSchema, breadcrumbSchema, faqSchema];
---

<BaseLayout title={data.seoTitle} description={data.seoDescription} keywords="création site internet Savoie, création site internet Haute-Savoie, site vitrine professionnel, site internet artisan, SEO local, devis site internet gratuit">
  <div class="mx-auto max-w-5xl px-6 py-16 lg:py-24">
    <nav aria-label="Fil d'Ariane" class="mb-8 text-sm" style="color: var(--color-text-muted)">
      <a href="/" class="hover:underline">Accueil</a>
      <span class="mx-2">/</span>
      <span>{data.title}</span>
    </nav>

    <h1 class="max-w-3xl text-4xl font-semibold tracking-tight lg:text-5xl" style="color: var(--color-text)">
      {data.title}
    </h1>

    <p class="mt-6 max-w-3xl text-lg leading-relaxed" style="color: var(--color-text-muted)">
      {data.description}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href="#offres" class="inline-flex min-h-12 items-center justify-center rounded-full px-6 py-3 font-medium text-white transition hover:opacity-90" style="background-color: var(--color-accent)">Comparer les deux offres</a>
      <a href="/demarrer/?service=site" class="inline-flex min-h-12 items-center underline underline-offset-4" style="color: var(--color-accent)">Demander un devis gratuit</a>
    </div>
    <p class="mt-3 text-sm" style="color: var(--color-text-muted)">Savoie · Haute-Savoie · Toute la France à distance. Paiement après validation du devis.</p>

    <section class="mt-10 rounded-2xl p-6" style="background-color: var(--color-surface)">
      <h2 class="text-xl font-semibold tracking-tight" style="color: var(--color-text)">
        En bref
      </h2>
      <p class="mt-3 leading-relaxed" style="color: var(--color-text-muted)">
        Un site vitrine jusqu’à 5 pages pour présenter votre activité ; un site de 5 pages et plus avec SEO et IA pour travailler votre visibilité sur Google, Bing et les autres moteurs compatibles. Le devis confirme ce qui sera réalisé, les éléments à fournir et les éventuels coûts récurrents.
      </p>
    </section>

    <section id="offres" class="mt-16 scroll-mt-24" aria-labelledby="offres-title">
      <p class="text-sm font-semibold uppercase tracking-widest" style="color: var(--color-accent)">Votre site internet</p>
      <h2 id="offres-title" class="mt-3 text-3xl font-semibold tracking-tight">Deux formules. Un périmètre clair.</h2>
      <p class="mt-4 max-w-3xl leading-relaxed" style="color: var(--color-text-muted)">Les prix ci-dessous correspondent à la création du site, payée une seule fois. Retrouvez les prestations de chaque formule et choisissez le point de départ adapté à votre entreprise.</p>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {websiteOffers.map((offer) => (
          <article class="flex min-w-0 flex-col rounded-3xl border p-6 lg:p-8" style="border-color: var(--color-border); background-color: var(--color-surface)">
            <h3 class="text-2xl font-semibold tracking-tight">{offer.name}</h3>
            <p class="mt-3 leading-relaxed" style="color: var(--color-text-muted)">{offer.description}</p>
            <p class="mt-6"><span class="text-4xl font-semibold tracking-tight">{euros(offer.setupCents)}</span> <span class="font-medium">TTC</span></p>
            <p class="mt-1 text-sm" style="color: var(--color-text-muted)">Paiement unique après validation du devis</p>
            <ul class="mt-6 space-y-3">
              {offer.features.map((feature) => <li class="flex gap-3"><span aria-hidden="true" style="color: var(--color-accent)">✓</span><span>{feature}</span></li>)}
            </ul>
            <p class="mt-6 border-t pt-5 text-sm leading-relaxed" style="border-color: var(--color-border); color: var(--color-text-muted)">{offerGuidance[offer.id]}</p>
            <div class="mt-auto pt-6">
              <a href={offer.href} class="inline-flex min-h-12 w-full items-center justify-center rounded-full px-4 py-3 text-center font-medium text-white transition hover:opacity-90" style="background-color: var(--color-accent)" aria-label={`Demander un devis pour le ${offer.name.toLowerCase()}`}>Choisir cette offre</a>
            </div>
          </article>
        ))}
      </div>
      <p class="mt-5 max-w-3xl text-sm leading-relaxed" style="color: var(--color-text-muted)">L’offre à 590 € TTC comprend le travail sur la structure, les contenus, les données structurées et la soumission à Google et Bing. Le nombre de pages, à partir de 5, est arrêté dans le devis. Le classement et les citations par les moteurs restent de leur ressort. Une boutique en ligne, une réservation complexe ou un développement métier sont étudiés séparément.</p>
    </section>

    <section id="options" class="mt-12 scroll-mt-24" aria-labelledby="options-title">
      <h2 id="options-title" class="text-2xl font-semibold tracking-tight">Des options, seulement si elles vous sont utiles</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-2">
        {pricingOptions.map((option) => (
          <article class="rounded-2xl border p-6" style="border-color: var(--color-border)">
            <h3 class="text-lg font-semibold">{option.name}</h3>
            <p class="mt-3 text-2xl font-semibold">{euros(option.monthlyCents)} <span class="text-base font-normal">TTC/mois</span></p>
            <p class="mt-3 leading-relaxed" style="color: var(--color-text-muted)">{option.description}</p>
          </article>
        ))}
      </div>
      <p class="mt-5 max-w-3xl text-sm leading-relaxed" style="color: var(--color-text-muted)">Vous pouvez choisir aucune, une ou les deux options. Le devis précise les interventions, les limites, les outils et les conditions retenus. Le domaine, l’hébergement, les licences et les consommations éventuelles sont détaillés séparément avant accord. <a href="/pricing/" class="underline underline-offset-4" style="color: var(--color-accent)">Voir tous les tarifs et leurs conditions</a>.</p>
    </section>

    <section id="contenu-devis" class="mt-16 scroll-mt-24 rounded-3xl p-6 lg:p-8" style="background-color: var(--color-surface)" aria-labelledby="devis-title">
      <h2 id="devis-title" class="text-2xl font-semibold tracking-tight">Ce que votre devis doit préciser</h2>
      <p class="mt-4 max-w-3xl leading-relaxed" style="color: var(--color-text-muted)">Avant de commander, vous disposez d’une proposition qui permet de vérifier le contenu du projet et son budget. Ces cinq points servent de base à notre échange.</p>
      <ol class="mt-6 grid gap-6 md:grid-cols-2">
        {quoteChecklist.map((item, index) => (
          <li class="flex gap-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-semibold text-white" style="background-color: var(--color-accent)" aria-hidden="true">{index + 1}</span>
            <div><h3 class="font-semibold">{item.title}</h3><p class="mt-2 text-sm leading-relaxed" style="color: var(--color-text-muted)">{item.text}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <div class="service-content mx-auto mt-16 max-w-3xl space-y-6 text-lg leading-relaxed" style="color: var(--color-text)">
      <Content />
    </div>

    <section class="mt-16">
      <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
        Pour qui ?
      </h2>
      <ul class="mt-4 list-disc space-y-2 pl-6" style="color: var(--color-text)">
        {data.targetAudience.map((item: string) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <section class="mt-16 rounded-2xl p-6" style="background-color: var(--color-surface)">
      <h2 class="text-xl font-semibold tracking-tight" style="color: var(--color-text)">
        Vous avez aussi un projet d'application mobile ?
      </h2>
      <p class="mt-3 leading-relaxed" style="color: var(--color-text-muted)">
        FLEX-WEB développe également des <a href="/creation-application-mobile/" class="underline hover:opacity-80" style="color: var(--color-accent)">applications mobiles et web sur mesure</a> pour les entreprises de <a href="/creation-site-internet-savoie/" class="underline hover:opacity-80" style="color: var(--color-accent)">Savoie</a> et <a href="/creation-site-internet-haute-savoie/" class="underline hover:opacity-80" style="color: var(--color-accent)">Haute-Savoie</a>.
      </p>
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
        Nos engagements
      </h2>
      <ul class="mt-4 list-disc space-y-2 pl-6" style="color: var(--color-text)">
        {data.benefits.map((item: string) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
        Zones desservies
      </h2>
      <div class="mt-4 flex flex-wrap gap-3">
        {data.relatedLocations.map((slug: string) => (
          <a
            href={`/${slug}/`}
            class="rounded-full px-4 py-2 text-sm font-medium transition hover:opacity-90"
            style="background-color: var(--color-surface); color: var(--color-text)"
          >
            {slug.replace("creation-site-internet-", "").replace("creation-application-mobile-", "").replace(/-/g, " ")}
          </a>
        ))}
      </div>
    </section>

    <section class="mt-16 rounded-2xl border p-6" style="border-color: var(--color-border)">
      <h2 class="text-2xl font-semibold tracking-tight">Automatiser les tâches autour de votre projet</h2>
      <p class="mt-4 leading-relaxed">Découvrez le <a href="/automatisation-ia/" class="underline">cadrage d'une automatisation IA</a>, avec des parcours dédiés à la <a href="/automatisation-ia-savoie/" class="underline">Savoie</a> et à la <a href="/automatisation-ia-haute-savoie/" class="underline">Haute-Savoie</a>. Les demandes, les documents et le CRM peuvent être reliés selon vos outils et le périmètre du devis.</p>
    </section>

    <section id="faq" class="mt-16">
      <h2 class="text-2xl font-semibold tracking-tight">Questions fréquentes</h2>
      <div class="mt-6 space-y-4">
        {serviceFaq.map((item) => (
          <details class="rounded-2xl border p-5" style="border-color: var(--color-border)">
            <summary class="cursor-pointer font-medium">{item.question}</summary>
            <p class="mt-4 leading-relaxed" style="color: var(--color-text-muted)">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <aside id="contact" class="mt-16 rounded-3xl p-8 text-center" style="background-color: var(--color-surface)">
      <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
        Besoin d'un site internet professionnel ?
      </h2>
      <p class="mt-4" style="color: var(--color-text-muted)">
        Discutons de votre projet et obtenez un devis gratuit.
      </p>
      <a
        href="/demarrer/?service=site"
        class="mt-6 inline-flex items-center justify-center rounded-full px-8 py-3 text-base font-medium text-white transition hover:opacity-90"
        style="background-color: var(--color-accent)"
      >
        Demander un devis
      </a>
    </aside>
  </div>

  <StructuredData schemas={schemas} slot="head" />
<ProjectEvidence service="site" />
</BaseLayout>

<style>
  .service-content :global(h2) {
    margin-top: 3rem;
    font-size: 1.5rem;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .service-content :global(h2:first-child) { margin-top: 0; }
  .service-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .service-content :global(ol) { list-style: decimal; padding-left: 1.5rem; }
  .service-content :global(li + li) { margin-top: 0.75rem; }
</style>
