---
import BaseLayout from "../layout/BaseLayout.astro";
import StructuredData from "../components/seo/StructuredData.astro";
import { getEntry, render } from "astro:content";

import faqData from "../data/faq.json";

const entry = await getEntry("services", "creation-site-internet");

if (!entry) {
  throw new Error("Service creation-site-internet not found");
}

const { Content } = await render(entry);
const { data } = entry;

const siteUrl = "https://flex-web.fr";
const canonicalUrl = new URL("creation-site-internet", siteUrl).toString();

const webPageSchema = {
  "@type": "WebPage",
  "@id": canonicalUrl,
  url: canonicalUrl,
  name: data.seoTitle,
  description: data.seoDescription,
  isPartOf: { "@id": siteUrl },
};

const serviceSchema = {
  "@type": "Service",
  "@id": `${canonicalUrl}#service`,
  name: data.title,
  url: canonicalUrl,
  description: data.description,
  provider: { "@id": `${siteUrl}/#organization` },
  areaServed: [
    { "@type": "AdministrativeArea", name: "Savoie" },
    { "@type": "AdministrativeArea", name: "Haute-Savoie" },
    { "@type": "Country", name: "France" },
  ],
  audience: {
    "@type": "Audience",
    audienceType: data.targetAudience.join(", "),
  },
  serviceType: "Création de site internet",
  offers: [
    {
      "@type": "Offer",
      name: "Site Essentiel",
      price: "49",
      priceCurrency: "EUR",
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        price: "49",
        priceCurrency: "EUR",
        unitCode: "MON",
        referenceQuantity: { "@type": "QuantitativeValue", value: "1", unitCode: "MON" },
      },
      url: `${siteUrl}/pricing/`,
      availability: "https://schema.org/InStock",
    },
    {
      "@type": "Offer",
      name: "Site Professionnel",
      price: "99",
      priceCurrency: "EUR",
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        price: "99",
        priceCurrency: "EUR",
        unitCode: "MON",
        referenceQuantity: { "@type": "QuantitativeValue", value: "1", unitCode: "MON" },
      },
      url: `${siteUrl}/pricing/`,
      availability: "https://schema.org/InStock",
    },
    {
      "@type": "Offer",
      name: "Achat définitif",
      price: "990",
      priceCurrency: "EUR",
      url: `${siteUrl}/pricing/`,
      availability: "https://schema.org/InStock",
    },
  ],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    ratingCount: "3",
  },
};

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: siteUrl },
    { "@type": "ListItem", position: 2, name: data.title, item: canonicalUrl },
  ],
};

const howItWorksSchema = {
  "@type": "HowTo",
  "@id": `${canonicalUrl}#how-it-works`,
  name: `Processus de création d'un site internet avec FLEX-WEB`,
  description: `Les 5 étapes de création d'un site internet professionnel en Savoie et Haute-Savoie avec FLEX-WEB.`,
  image: `${siteUrl}/logo.png`,
  totalTime: "P14D",
  step: [
    {
      "@type": "HowToStep",
      position: 1,
      name: "Échange",
      text: "Nous comprenons votre activité, vos objectifs et votre clientèle.",
      url: `${canonicalUrl}#etape-1`,
    },
    {
      "@type": "HowToStep",
      position: 2,
      name: "Conception",
      text: "Nous structurons l'arborescence, rédigeons le contenu et définissons le graphisme.",
      url: `${canonicalUrl}#etape-2`,
    },
    {
      "@type": "HowToStep",
      position: 3,
      name: "Développement",
      text: "Nous intégrons le site, testons l'affichage sur tous les écrans et optimisons les performances.",
      url: `${canonicalUrl}#etape-3`,
    },
    {
      "@type": "HowToStep",
      position: 4,
      name: "Mise en ligne",
      text: "Nous publions le site, configurons le référencement et connectons les outils de suivi.",
      url: `${canonicalUrl}#etape-4`,
    },
    {
      "@type": "HowToStep",
      position: 5,
      name: "Suivi",
      text: "Nous assurons la maintenance, les mises à jour et les évolutions.",
      url: `${canonicalUrl}#etape-5`,
    },
  ],
};

const faqSchema = {
  "@type": "FAQPage",
  "@id": `${canonicalUrl}#faq`,
  mainEntity: faqData.items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};

const schemas = [webPageSchema, serviceSchema, breadcrumbSchema, howItWorksSchema, faqSchema];
---

<BaseLayout title={data.seoTitle} description={data.seoDescription} keywords="création site internet Savoie, création site internet Haute-Savoie, site vitrine professionnel, site internet artisan, SEO local, devis site internet gratuit">
  <div class="mx-auto max-w-3xl px-6 py-16 lg:py-24">
    <nav aria-label="Fil d'Ariane" class="mb-8 text-sm" style="color: var(--color-text-muted)">
      <a href="/" class="hover:underline">Accueil</a>
      <span class="mx-2">/</span>
      <span>{data.title}</span>
    </nav>

    <h1 class="text-4xl font-semibold tracking-tight lg:text-5xl" style="color: var(--color-text)">
      {data.title}
    </h1>

    <p class="mt-6 text-lg leading-relaxed" style="color: var(--color-text-muted)">
      {data.description}
    </p>

    <section class="mt-8 rounded-2xl p-6" style="background-color: var(--color-surface)">
      <h2 class="text-xl font-semibold tracking-tight" style="color: var(--color-text)">
        En bref
      </h2>
      <p class="mt-3 leading-relaxed" style="color: var(--color-text-muted)">
        FLEX-WEB conçoit des sites internet pour les artisans, commerçants, indépendants et PME. Chaque projet comprend une structure optimisée pour les moteurs de recherche, un affichage adapté au mobile et un accompagnement pour l'hébergement et la maintenance.
      </p>
    </section>

    <div class="mt-12 space-y-6 text-lg leading-relaxed" style="color: var(--color-text)">
      <Content />
    </div>

    <section class="mt-16">
      <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
        Pour qui ?
      </h2>
      <ul class="mt-4 list-disc space-y-2 pl-6" style="color: var(--color-text)">
        {data.targetAudience.map((item: string) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <section class="mt-16 rounded-2xl p-6" style="background-color: var(--color-surface)">
      <h2 class="text-xl font-semibold tracking-tight" style="color: var(--color-text)">
        Vous avez aussi un projet d'application mobile ?
      </h2>
      <p class="mt-3 leading-relaxed" style="color: var(--color-text-muted)">
        FLEX-WEB développe également des <a href="/creation-application-mobile/" class="underline hover:opacity-80" style="color: var(--color-accent)">applications mobiles et web sur mesure</a> pour les entreprises de <a href="/creation-site-internet-savoie/" class="underline hover:opacity-80" style="color: var(--color-accent)">Savoie</a> et <a href="/creation-site-internet-haute-savoie/" class="underline hover:opacity-80" style="color: var(--color-accent)">Haute-Savoie</a>.
      </p>
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
        Nos engagements
      </h2>
      <ul class="mt-4 list-disc space-y-2 pl-6" style="color: var(--color-text)">
        {data.benefits.map((item: string) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
        Zones desservies
      </h2>
      <div class="mt-4 flex flex-wrap gap-3">
        {data.relatedLocations.map((slug: string) => (
          <a
            href={`/${slug}`}
            class="rounded-full px-4 py-2 text-sm font-medium transition hover:opacity-90"
            style="background-color: var(--color-surface); color: var(--color-text)"
          >
            {slug.replace("creation-site-internet-", "").replace(/-/g, " ")}
          </a>
        ))}
      </div>
    </section>

    <aside class="mt-16 rounded-3xl p-8 text-center" style="background-color: var(--color-surface)">
      <h2 class="text-2xl font-semibold tracking-tight" style="color: var(--color-text)">
        Besoin d'un site internet professionnel ?
      </h2>
      <p class="mt-4" style="color: var(--color-text-muted)">
        Discutons de votre projet et obtenez un devis gratuit.
      </p>
      <a
        href="/contact/"
        class="mt-6 inline-flex items-center justify-center rounded-full px-8 py-3 text-base font-medium text-white transition hover:opacity-90"
        style="background-color: var(--color-accent)"
      >
        Demander un devis
      </a>
    </aside>
  </div>

  <StructuredData schemas={schemas} slot="head" />
</BaseLayout>
